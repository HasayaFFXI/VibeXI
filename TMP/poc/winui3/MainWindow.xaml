<Window
    x:Class="WinUiSpike.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUiSpike">

    <!-- Root carries the page background (#14141a). "Transparent background"
         clears it; the window's SystemBackdrop is a fully transparent brush, so
         whatever Root doesn't paint shows the desktop/game through. -->
    <Grid x:Name="Root" Background="#14141A">
        <Grid.Resources>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="#1F1F29" />
                <Setter Property="BorderBrush" Value="#2E2E3C" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12,10" />
            </Style>
            <Style x:Key="H1" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#D9A441" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="MinHeight" Value="26" />
                <Setter Property="Padding" Value="6,4,0,0" />
                <Setter Property="FontSize" Value="13" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The drag strip. Left-drag moves the window (WM_NCLBUTTONDOWN/HTCAPTION),
             right-click opens the same controls as a MenuFlyout. -->
        <Border x:Name="Grip" Grid.Row="0" Background="#464656"
                PointerPressed="Grip_PointerPressed" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="10" Spacing="10">

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H1}" Text="Fake meter &#x2014; is it still repainting?" />
                        <TextBlock x:Name="Clock" Text="00:00.0" FontFamily="Cascadia Mono, Consolas"
                                   FontSize="22" FontWeight="SemiBold" />
                        <!-- Data-bound rows: an ObservableCollection of INotifyPropertyChanged
                             models, compiled bindings (x:Bind, OneWay). -->
                        <ItemsControl x:Name="Rows" Margin="0,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:MeterRow">
                                    <Grid ColumnSpacing="8" Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="64" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Name}" />
                                        <Grid Grid.Column="1" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{x:Bind BarWidth, Mode=OneWay}" />
                                                <ColumnDefinition Width="{x:Bind RestWidth, Mode=OneWay}" />
                                            </Grid.ColumnDefinitions>
                                            <Rectangle Height="12" RadiusX="3" RadiusY="3" Fill="#D9A441" />
                                        </Grid>
                                        <TextBlock Grid.Column="2" HorizontalAlignment="Right"
                                                   Text="{x:Bind Text, Mode=OneWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock FontSize="11" Foreground="#9A98A8"
                                   Text="Small muted text: is this readable at 40% over the game?" />
                        <TextBlock FontSize="10" Foreground="#9A98A8"
                                   Text="Tiny text, 10px: Tachi: Jinpu 1,234 &#xB7; Skillchain 987" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H1}" Text="Controls" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Opacity" VerticalAlignment="Center" />
                            <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="10" Maximum="100"
                                    Value="100" StepFrequency="1" ValueChanged="OpacitySlider_ValueChanged" />
                            <TextBlock x:Name="OpacityVal" Grid.Column="2" Text="100%"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                        <ComboBox x:Name="MethodBox" HorizontalAlignment="Stretch" FontSize="12"
                                  SelectionChanged="MethodBox_SelectionChanged" Margin="0,0,0,4">
                            <ComboBoxItem Content="Opacity via XAML: whole window (Root.Opacity)" />
                            <ComboBoxItem Content="Opacity via XAML: background tint only" />
                            <ComboBoxItem Content="Opacity via Win32: SetLayeredWindowAttributes" />
                        </ComboBox>
                        <CheckBox x:Name="TransparentBox" Content="Transparent background (see-through between cards)" Click="Toggle_Click" />
                        <CheckBox x:Name="FramelessBox" Content="Frameless (drag by the grey strip)" Click="Toggle_Click" />
                        <CheckBox x:Name="ClickThroughBox" Click="Toggle_Click">
                            <TextBlock>Click-through &#x2014; <Bold>Ctrl+Alt+Z</Bold> turns it off</TextBlock>
                        </CheckBox>
                        <CheckBox x:Name="TopmostBox" Content="Always on top" IsChecked="True" Click="Toggle_Click" />
                        <TextBlock FontSize="10" Foreground="#9A98A8" Margin="0,4,0,0"
                                   Text="Right-click the grey strip for the same controls from anywhere." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H1}" Text="What the window really is" />
                        <TextBlock x:Name="State" FontFamily="Consolas" FontSize="11"
                                   Foreground="#9A98A8" TextWrapping="Wrap" Text="reading&#x2026;" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
