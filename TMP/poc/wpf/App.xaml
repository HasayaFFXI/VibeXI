<Application x:Class="WpfOverlayPoc.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="Bg" Color="#14141A"/>
    <SolidColorBrush x:Key="Card" Color="#1F1F29"/>
    <SolidColorBrush x:Key="Line" Color="#2E2E3C"/>
    <SolidColorBrush x:Key="Text" Color="#E8E6F0"/>
    <SolidColorBrush x:Key="Muted" Color="#9A98A8"/>
    <SolidColorBrush x:Key="Accent" Color="#D9A441"/>
  </Application.Resources>
</Application>
