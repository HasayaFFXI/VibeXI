<Window x:Class="FluentSpike.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zerg S1: Fluent theme and text" Width="1180" Height="800"
        WindowStartupLocation="Manual" Left="80" Top="80">
  <DockPanel>

    <!-- A command bar of the kind the plan suggests: icon + label buttons,
         the primary one in the system accent. -->
    <Border DockPanel.Dock="Top" Padding="12,8">
      <DockPanel LastChildFill="False">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
          <Button x:Name="StartBtn" Style="{StaticResource AccentButtonStyle}" Margin="0,0,6,0" ToolTip="Arm the session; the first counted event starts the clock">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE768;" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Text="Start"/>
            </StackPanel>
          </Button>
          <Button Margin="0,0,6,0" ToolTip="Hold the clock and the damage together">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE769;" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Text="Pause"/>
            </StackPanel>
          </Button>
          <Button Margin="0,0,6,0" IsEnabled="False" ToolTip="Enabled only while paused">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE74E;" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Text="Export"/>
            </StackPanel>
          </Button>
          <Button Margin="0,0,16,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE8E5;" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Text="Import"/>
            </StackPanel>
          </Button>
          <TextBlock x:Name="ClockText" FontFamily="{StaticResource Numbers}" FontSize="20" FontWeight="SemiBold"
                     Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" Text="00:00"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
          <TextBlock Text="Theme" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <RadioButton x:Name="ThemeLight" Content="Light" GroupName="theme" Margin="0,0,4,0" Checked="OnTheme"/>
          <RadioButton x:Name="ThemeDark" Content="Dark" GroupName="theme" Margin="0,0,4,0" Checked="OnTheme"/>
          <RadioButton x:Name="ThemeSystem" Content="System" GroupName="theme" Margin="0,0,12,0" Checked="OnTheme"/>
          <Menu x:Name="ViewMenu" VerticalAlignment="Center">
            <MenuItem Header="_View">
              <MenuItem Header="Hide names" IsCheckable="True"/>
              <MenuItem Header="Include skillchains" IsCheckable="True" IsChecked="True"/>
              <Separator/>
              <MenuItem Header="Section">
                <MenuItem Header="Damage" IsCheckable="True" IsChecked="True"/>
                <MenuItem Header="Healing" IsCheckable="True"/>
                <MenuItem Header="Compare" IsCheckable="True"/>
              </MenuItem>
            </MenuItem>
          </Menu>
        </StackPanel>
      </DockPanel>
    </Border>

    <TextBlock x:Name="StatusLine" DockPanel.Dock="Bottom" Margin="12,6" FontSize="12"
               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Typography.NumeralAlignment="Tabular"/>

    <TabControl x:Name="Tabs" Margin="12,0,12,0">

      <TabItem Header="Controls">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <WrapPanel Margin="0,12,0,12">

            <Border Style="{DynamicResource Card}" Width="340">
              <StackPanel>
                <TextBlock Text="Buttons and toggles" Style="{DynamicResource BodyStrongTextBlockStyle}" Margin="0,0,0,8"/>
                <WrapPanel>
                  <Button x:Name="PlainBtn" Content="Default" Margin="0,0,6,6" ToolTip="A plain button"/>
                  <Button Content="Accent" Style="{StaticResource AccentButtonStyle}" Margin="0,0,6,6"/>
                  <Button Content="Disabled" IsEnabled="False" Margin="0,0,6,6"/>
                  <ToggleButton Content="Group under 5%" IsChecked="True" Margin="0,0,6,6" ToolTip="Fold small contributors into one line"/>
                  <ToggleButton Content="Skillchains" Margin="0,0,6,6"/>
                  <RepeatButton Content="Repeat" Margin="0,0,6,6"/>
                </WrapPanel>
                <CheckBox Content="Hide names" Margin="0,4,0,0"/>
                <CheckBox Content="Include skillchains" IsChecked="True" Margin="0,4,0,0"/>
                <CheckBox Content="Three-state" IsThreeState="True" IsChecked="{x:Null}" Margin="0,4,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <RadioButton Content="by Character" GroupName="by" IsChecked="True" Margin="0,0,8,0"/>
                  <RadioButton Content="by Job" GroupName="by"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Style="{DynamicResource Card}" Width="340">
              <StackPanel>
                <TextBlock Text="Slider, combo, text" Style="{DynamicResource BodyStrongTextBlockStyle}" Margin="0,0,0,8"/>
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Width="44" TextAlignment="Right" VerticalAlignment="Center"
                             Typography.NumeralAlignment="Tabular"
                             Text="{Binding Value, ElementName=OpacitySlider, StringFormat={}{0:0}%}"/>
                  <Slider x:Name="OpacitySlider" Minimum="15" Maximum="100" Value="85" TickFrequency="5"
                          IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft"/>
                </DockPanel>
                <ComboBox x:Name="SectionCombo" Margin="0,10,0,0" SelectedIndex="0">
                  <ComboBoxItem Content="Damage"/>
                  <ComboBoxItem Content="Healing"/>
                  <ComboBoxItem Content="Compare"/>
                </ComboBox>
                <TextBox Margin="0,10,0,0" Text="Hasaya_parse_2026.10.02_2110.zerg"/>
                <ProgressBar Margin="0,12,0,0" Height="4" Value="62"/>
                <ProgressBar Margin="0,8,0,0" Height="4" IsIndeterminate="True"/>
              </StackPanel>
            </Border>

            <Border Style="{DynamicResource Card}" Width="340">
              <StackPanel>
                <TextBlock Text="Tooltip, context menu, expander" Style="{DynamicResource BodyStrongTextBlockStyle}" Margin="0,0,0,8"/>
                <Border Padding="12" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        ToolTip="Right-click for the context menu">
                  <Border.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Pop out">
                        <MenuItem.Icon><TextBlock FontFamily="{StaticResource Icons}" Text="&#xE8A7;"/></MenuItem.Icon>
                      </MenuItem>
                      <MenuItem Header="Copy table"/>
                      <Separator/>
                      <MenuItem Header="Exclude Hasaya" IsCheckable="True"/>
                    </ContextMenu>
                  </Border.ContextMenu>
                  <TextBlock Text="Hover me, right-click me"/>
                </Border>
                <Expander Header="Per-hit drill-down" Margin="0,10,0,0" IsExpanded="True">
                  <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                             Text="Tachi: Jinpu — 12 uses, 11 hits, avg 1,204, max 1,877."/>
                </Expander>
              </StackPanel>
            </Border>

            <Border Style="{DynamicResource Card}" Width="520">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Scrolling list (scroll bars)" Style="{DynamicResource BodyStrongTextBlockStyle}" Margin="0,0,0,8"/>
                <ListBox x:Name="Rows" Height="220"/>
              </DockPanel>
            </Border>

            <Border Style="{DynamicResource Card}" Width="340">
              <StackPanel>
                <TextBlock Text="Tabs" Style="{DynamicResource BodyStrongTextBlockStyle}" Margin="0,0,0,8"/>
                <TabControl Height="140">
                  <TabItem Header="Damage"><TextBlock Margin="8" Text="Damage section"/></TabItem>
                  <TabItem Header="Healing"><TextBlock Margin="8" Text="Healing section"/></TabItem>
                  <TabItem Header="Compare"><TextBlock Margin="8" Text="Compare section"/></TabItem>
                </TabControl>
              </StackPanel>
            </Border>

          </WrapPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Numbers">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="NumbersHost" Margin="0,12,0,12"/>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Text">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="TextHost" Margin="0,12,0,12"/>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Readout">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
          <TextBox x:Name="Readout" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                   BorderThickness="0" Background="Transparent" Margin="0,12,0,12"/>
        </ScrollViewer>
      </TabItem>

    </TabControl>
  </DockPanel>
</Window>
