#!/bin/sh
#
# VibeXI pre-commit hook.
#
# The addon must never gain an API that can reach the game server. This runs the
# allowlist check on every commit so that guarantee cannot rot silently.
#
# Install (once, from the repo root):
#     git config core.hooksPath .githooks
#
# Git runs hooks from the repo root, so the relative path below is correct.

python "addon-dev/check-apis.py"
status=$?

if [ $status -ne 0 ]; then
    echo ""
    echo "pre-commit: addon API check FAILED -- commit aborted."
    echo "  Fix the call, or add it to addon-dev/ALLOWED_APIS.txt deliberately."
    echo "  To bypass in an emergency: git commit --no-verify  (think hard first)"
    echo ""
fi

exit $status
