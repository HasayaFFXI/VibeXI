<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RootNamespace>Zerg</RootNamespace>
    <!-- The frozen WebView2 build, kept as the reference the native Zerg.exe is
         checked against (NATIVE-PLAN.md). Deleted in N9. -->
    <AssemblyName>ZergWeb</AssemblyName>
    <!-- Built by tools/make-icon.ps1 from assets/icon-source.webp. -->
    <ApplicationIcon>zerg.ico</ApplicationIcon>

    <Version>0.1.0</Version>
    <Product>Zerg</Product>
    <AssemblyTitle>Zerg damage meter</AssemblyTitle>
    <!-- The version string is shown to players; keep the git hash out of it. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <ProjectReference Include="..\Zerg.Core\Zerg.Core.csproj" />
  </ItemGroup>

  <!--
    The front end is the damage meter's own, embedded at build time rather than
    copied (PLAN.md, Decision 2). Logical names are "web\..." and "shared\...";
    Assets.cs normalises the separators. Files starting with "_" are scratch
    (web/_kirin-tmp.json) and stay out of the exe.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\damage-meter\web\**\*"
                      Exclude="..\..\..\damage-meter\web\**\_*"
                      LogicalName="web\%(RecursiveDir)%(Filename)%(Extension)"
                      WithCulture="false" />
    <EmbeddedResource Include="..\..\..\..\shared-ui\**\*"
                      Exclude="..\..\..\..\shared-ui\**\*.md"
                      LogicalName="shared\%(RecursiveDir)%(Filename)%(Extension)"
                      WithCulture="false" />
    <EmbeddedResource Include="host.js" LogicalName="host.js" />
  </ItemGroup>

  <!--
    The WebView2 package references its WPF assembly unconditionally on .NET 5+,
    which drags WindowsBase 5.0 into a WinForms build and raises MSB3277. Nothing
    here uses it, so drop the reference instead of silencing the warning.
  -->
  <Target Name="DropWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>
