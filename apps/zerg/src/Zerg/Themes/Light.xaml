<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Zerg's own colours for the light theme. AppTheme merges this file or its
       twin, whichever the theme setting (or Windows, under "System") asks for. -->

  <!-- The eighteen fallback slots, one per character of a full alliance, for
       anyone whose job has no colour of its own. Solved as a set, per theme,
       so that every pair stays distinguishable, including for colour-blind
       readers, and so that neighbouring slots (the order characters are
       handed them in) are far apart. Don't adjust one on its own. -->
  <Color x:Key="Series1">#2A78D6</Color>
  <Color x:Key="Series2">#C94F18</Color>
  <Color x:Key="Series3">#12855C</Color>
  <Color x:Key="Series4">#9A6800</Color>
  <Color x:Key="Series5">#C23A6D</Color>
  <Color x:Key="Series6">#3D7F21</Color>
  <Color x:Key="Series7">#5A4BC4</Color>
  <Color x:Key="Series8">#CF3B3A</Color>
  <Color x:Key="Series9">#B056B8</Color>
  <Color x:Key="Series10">#3B5B0B</Color>
  <Color x:Key="Series11">#6D3C78</Color>
  <Color x:Key="Series12">#098AA7</Color>
  <Color x:Key="Series13">#9E0822</Color>
  <Color x:Key="Series14">#284A99</Color>
  <Color x:Key="Series15">#BB76AA</Color>
  <Color x:Key="Series16">#00749B</Color>
  <Color x:Key="Series17">#98005F</Color>
  <Color x:Key="Series18">#129D9C</Color>

  <!-- A job's own colour, the one the party already knows it by in game. The
       hues are the dark theme's; the lightness is not, because yellow-green
       and white vanish on a light card. White has no hue to keep, so the
       white mage becomes a warm dark neutral. See Dark.xaml for the rules. -->
  <Color x:Key="JobWAR">#C00000</Color>
  <Color x:Key="JobMNK">#9A7A00</Color>
  <Color x:Key="JobWHM">#55534D</Color>
  <Color x:Key="JobBLM">#6F4E8C</Color>
  <Color x:Key="JobRDM">#C0393C</Color>
  <Color x:Key="JobTHF">#0E7C1B</Color>
  <Color x:Key="JobPLD">#7C8600</Color>
  <Color x:Key="JobDRK">#A400B8</Color>
  <Color x:Key="JobBST">#7D6A30</Color>
  <Color x:Key="JobBRD">#B4519F</Color>
  <Color x:Key="JobRNG">#3F7F2E</Color>
  <Color x:Key="JobSAM">#C25200</Color>
  <Color x:Key="JobNIN">#C22600</Color>
  <Color x:Key="JobDRG">#7B2CC0</Color>
  <Color x:Key="JobSMN">#1E8C5C</Color>
  <Color x:Key="JobBLU">#2A6BAA</Color>
  <Color x:Key="JobCOR">#9A4E33</Color>
  <Color x:Key="JobPUP">#565080</Color>

  <!-- ============================================================ tokens
       The redesign's named values (UI-REDESIGN-PLAN.md, section 4). Each
       colour is a Color under its name and a brush under that name plus
       "Brush". Both theme files define the same keys, and Themes/Panel.xaml
       defines some of them again for a floating panel, so a token is
       always asked for with DynamicResource: AppTheme merges this file at
       run time, after App.xaml has been read, and a StaticResource to a
       token fails at startup. -->

  <!-- Surfaces, from the window itself (Bg0) up to what is under the
       pointer (Bg4); rules, from the one between rows (Line) to a frame
       (Line3); ink, from figures (Text1) to a dash (Text4). -->
  <Color x:Key="Bg0">#E9EBEF</Color>
  <Color x:Key="Bg1">#FFFFFF</Color>
  <Color x:Key="Bg2">#F4F5F7</Color>
  <Color x:Key="Bg3">#E7EAEF</Color>
  <Color x:Key="Bg4">#DBDFE6</Color>
  <Color x:Key="Line">#ECEEF2</Color>
  <Color x:Key="Line2">#D5D9E0</Color>
  <Color x:Key="Line3">#B4BBC7</Color>
  <Color x:Key="Text1">#14171D</Color>
  <Color x:Key="Text2">#474E5C</Color>
  <Color x:Key="Text3">#687182</Color>
  <Color x:Key="Text4">#A0A7B4</Color>
  <Color x:Key="ShadedDash">#58606F</Color>
  <Color x:Key="MarkTile">#07080C</Color>
  <SolidColorBrush x:Key="Bg0Brush" Color="{StaticResource Bg0}"/>
  <SolidColorBrush x:Key="Bg1Brush" Color="{StaticResource Bg1}"/>
  <SolidColorBrush x:Key="Bg2Brush" Color="{StaticResource Bg2}"/>
  <SolidColorBrush x:Key="Bg3Brush" Color="{StaticResource Bg3}"/>
  <SolidColorBrush x:Key="Bg4Brush" Color="{StaticResource Bg4}"/>
  <SolidColorBrush x:Key="LineBrush" Color="{StaticResource Line}"/>
  <SolidColorBrush x:Key="Line2Brush" Color="{StaticResource Line2}"/>
  <SolidColorBrush x:Key="Line3Brush" Color="{StaticResource Line3}"/>
  <SolidColorBrush x:Key="Text1Brush" Color="{StaticResource Text1}"/>
  <SolidColorBrush x:Key="Text2Brush" Color="{StaticResource Text2}"/>
  <SolidColorBrush x:Key="Text3Brush" Color="{StaticResource Text3}"/>
  <SolidColorBrush x:Key="Text4Brush" Color="{StaticResource Text4}"/>
  <SolidColorBrush x:Key="ShadedDashBrush" Color="{StaticResource ShadedDash}"/>
  <SolidColorBrush x:Key="MarkTileBrush" Color="{StaticResource MarkTile}"/>

  <!-- Colours that mean something. Accent: brand, selected, focus, armed and
       held. Live: counting, a better change. Crit: dropped, an error, a
       worse change. On*: text and glyphs on a fill of that colour. -->
  <Color x:Key="Accent">#A35F00</Color>
  <Color x:Key="OnAccent">#FFFFFF</Color>
  <Color x:Key="Live">#0B7A45</Color>
  <Color x:Key="OnLive">#FFFFFF</Color>
  <Color x:Key="Crit">#C42B3A</Color>
  <Color x:Key="OnCrit">#FFFFFF</Color>
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
  <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccent}"/>
  <SolidColorBrush x:Key="LiveBrush" Color="{StaticResource Live}"/>
  <SolidColorBrush x:Key="OnLiveBrush" Color="{StaticResource OnLive}"/>
  <SolidColorBrush x:Key="CritBrush" Color="{StaticResource Crit}"/>
  <SolidColorBrush x:Key="OnCritBrush" Color="{StaticResource OnCrit}"/>
  <!-- The caption's close button under the pointer; the same in both themes. -->
  <SolidColorBrush x:Key="CloseHoverBrush" Color="#C42B1C"/>

  <!-- A state tag: its colour at 12% over Bg1, with an edge at 45%. Idle
       is from Text3 (and serves SAVED); Held is from Accent (and serves
       ARMED). Worked out by that rule, not chosen: if a colour above
       changes, work its pair out again. -->
  <SolidColorBrush x:Key="TagLiveFillBrush" Color="#E2EFE9"/>
  <SolidColorBrush x:Key="TagLiveEdgeBrush" Color="#91C3AB"/>
  <SolidColorBrush x:Key="TagIdleFillBrush" Color="#EDEEF0"/>
  <SolidColorBrush x:Key="TagIdleEdgeBrush" Color="#BBBFC7"/>
  <SolidColorBrush x:Key="TagHeldFillBrush" Color="#F4ECE0"/>
  <SolidColorBrush x:Key="TagHeldEdgeBrush" Color="#D6B78C"/>

  <!-- Overlays: a colour at a strength, over whatever is beneath. -->
  <SolidColorBrush x:Key="RowHoverBrush" Color="{StaticResource Text1}" Opacity="0.05"/>
  <SolidColorBrush x:Key="ActionShadeBrush" Color="{StaticResource Text1}" Opacity="0.08"/>
  <SolidColorBrush x:Key="DropZoneFillBrush" Color="{StaticResource Accent}" Opacity="0.15"/>
  <SolidColorBrush x:Key="EdgeZoneBrush" Color="{StaticResource Accent}" Opacity="0.28"/>
  <SolidColorBrush x:Key="DividerHoverBrush" Color="{StaticResource Accent}" Opacity="0.55"/>
  <SolidColorBrush x:Key="HistogramBandBrush" Color="{StaticResource Text1}" Opacity="0.04"/>

  <!-- A chart's hover card. Bg4 here; a floating panel has its own
       (Themes/Panel.xaml), because Bg4 is see-through there and the card
       must not be. -->
  <SolidColorBrush x:Key="HoverCardBrush" Color="{StaticResource Bg4}"/>

  <!-- The ring round a chart marker: the colour of what the chart sits on,
       the pane surface. Solid, so a ring parts a marker from the lines
       under it. -->
  <SolidColorBrush x:Key="ChartSurfaceBrush" Color="{StaticResource Bg1}"/>

  <!-- The two runs of a comparison, A and B: the first two fallback slots,
       the pair furthest apart. They say which run a mark belongs to and
       nothing else; a character's swatch keeps the character's own colour.
       The ink is for the letter on a run's badge. -->
  <SolidColorBrush x:Key="RunABrush" Color="{StaticResource Series1}"/>
  <SolidColorBrush x:Key="RunBBrush" Color="{StaticResource Series2}"/>
  <SolidColorBrush x:Key="RunInkBrush" Color="#FFFFFF"/>

  <!-- ============================================== Fluent keys, on tokens
       Step 1.4 of the plan; taken out again at step 2.5. The Fluent theme is
       still loaded and still draws every stock control. Whatever asks the
       application for one of these brush names with DynamicResource gets
       Zerg's colour: AppTheme merges this file after WPF has merged the
       theme's own, and the later of two merged dictionaries answers first.
       They do little now. Nothing of Zerg's own asks for one of these keys
       any more, and the theme settles most of what its templates draw
       inside its own dictionary (a checked toggle stays Fluent's blue). A
       floating panel is not reached at all: its window carries a Fluent set
       of its own. -->
  <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource Text1}"/>
  <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource Text2}"/>
  <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource Text3}"/>
  <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource Accent}"/>
  <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{StaticResource Accent}"/>
  <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="{StaticResource OnAccent}"/>
  <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="{StaticResource Live}"/>
  <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="{StaticResource Accent}"/>
  <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="{StaticResource Crit}"/>
  <SolidColorBrush x:Key="SystemFillColorNeutralBrush" Color="{StaticResource Text3}"/>
  <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource Bg1}"/>
  <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource Line2}"/>
  <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource Line2}"/>
  <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="{StaticResource Line2}"/>
  <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush" Color="{StaticResource Line2}"/>
  <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="{StaticResource Line3}"/>
  <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="{StaticResource Line}"/>
  <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="{StaticResource Bg2}"/>
  <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="{StaticResource Bg3}"/>
  <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource Bg3}"/>
  <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{StaticResource Bg4}"/>
  <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="{StaticResource Bg4}"/>

</ResourceDictionary>
