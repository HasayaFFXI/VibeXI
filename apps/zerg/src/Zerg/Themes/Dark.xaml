<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Zerg's own colours for the dark theme. AppTheme merges this file or its
       twin, whichever matches what Windows' Fluent theme is showing. -->

  <!-- The eighteen fallback slots, one per character of a full alliance, for
       anyone whose job has no colour of its own. Solved as a set, per theme,
       so that every pair stays distinguishable, including for colour-blind
       readers, and so that neighbouring slots (the order characters are
       handed them in) are far apart. Don't adjust one on its own. -->
  <Color x:Key="Series1">#3987E5</Color>
  <Color x:Key="Series2">#D95926</Color>
  <Color x:Key="Series3">#199E70</Color>
  <Color x:Key="Series4">#C98500</Color>
  <Color x:Key="Series5">#D55181</Color>
  <Color x:Key="Series6">#4F9E2F</Color>
  <Color x:Key="Series7">#9085E9</Color>
  <Color x:Key="Series8">#E66767</Color>
  <Color x:Key="Series9">#9968A4</Color>
  <Color x:Key="Series10">#55712D</Color>
  <Color x:Key="Series11">#9546B2</Color>
  <Color x:Key="Series12">#30A2BB</Color>
  <Color x:Key="Series13">#A35450</Color>
  <Color x:Key="Series14">#4261CD</Color>
  <Color x:Key="Series15">#CE64C1</Color>
  <Color x:Key="Series16">#067396</Color>
  <Color x:Key="Series17">#B13A80</Color>
  <Color x:Key="Series18">#028F95</Color>

  <!-- A job's own colour, the one the party already knows it by in game: the
       warrior is red, the samurai orange. Every character is drawn in their
       job's colour; a second character on the same job gets a shade of it.
       Four jobs (DNC, SCH, GEO, RUN) have none and fall back to a slot above,
       as does anyone whose job was never reported. Several of these are close
       (four reds), which is acceptable only because nothing in Zerg names a
       character by colour alone: the name and job are always beside it. -->
  <Color x:Key="JobWAR">#E60000</Color>
  <Color x:Key="JobMNK">#F5C403</Color>
  <Color x:Key="JobWHM">#FFFFFF</Color>
  <Color x:Key="JobBLM">#A685BD</Color>
  <Color x:Key="JobRDM">#E86366</Color>
  <Color x:Key="JobTHF">#08C21C</Color>
  <Color x:Key="JobPLD">#E6FA17</Color>
  <Color x:Key="JobDRK">#E600FF</Color>
  <Color x:Key="JobBST">#CCBA78</Color>
  <Color x:Key="JobBRD">#F7A3E8</Color>
  <Color x:Key="JobRNG">#6EC459</Color>
  <Color x:Key="JobSAM">#FC6E03</Color>
  <Color x:Key="JobNIN">#F53000</Color>
  <Color x:Key="JobDRG">#B34AFA</Color>
  <Color x:Key="JobSMN">#70FCB5</Color>
  <Color x:Key="JobBLU">#4C8FD4</Color>
  <Color x:Key="JobCOR">#C97557</Color>
  <Color x:Key="JobPUP">#827AAB</Color>

  <!-- The ring round a chart marker: what a card on Mica comes out as, but
       solid. The card's own brush is translucent, and a see-through ring
       would not part a marker from the lines under it. -->
  <SolidColorBrush x:Key="ChartSurfaceBrush" Color="#2B2B2B"/>

  <!-- The two runs of a comparison, A and B: the first two fallback slots,
       the pair furthest apart. They say which run a mark belongs to and
       nothing else; a character's swatch keeps the character's own colour.
       The ink is for the letter on a run's badge. -->
  <SolidColorBrush x:Key="RunABrush" Color="{StaticResource Series1}"/>
  <SolidColorBrush x:Key="RunBBrush" Color="{StaticResource Series2}"/>
  <SolidColorBrush x:Key="RunInkBrush" Color="#101010"/>

</ResourceDictionary>
