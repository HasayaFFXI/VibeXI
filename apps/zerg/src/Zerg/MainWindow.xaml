<Window x:Class="Zerg.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Zerg"
        xmlns:v="clr-namespace:Zerg.Views"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance local:MainViewModel}"
        Title="Zerg" Icon="zerg.ico"
        Width="1280" Height="900" MinWidth="520" MinHeight="360"
        FontFamily="{StaticResource TextFont}" UseLayoutRounding="True">
  <Window.Resources>

    <!-- One of the five figures across the top. -->
    <Style x:Key="Tile" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Margin" Value="6"/>
      <Setter Property="Padding" Value="16,12"/>
    </Style>
    <Style x:Key="TileNote" TargetType="TextBlock" BasedOn="{StaticResource Label}">
      <Setter Property="Margin" Value="0,2,0,0"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>

    <Style x:Key="StatusDot" TargetType="Ellipse">
      <Setter Property="Width" Value="10"/>
      <Setter Property="Height" Value="10"/>
      <Setter Property="Fill" Value="{DynamicResource SystemFillColorNeutralBrush}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding StatusLight}" Value="Live">
          <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusLight}" Value="Armed">
          <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusLight}" Value="Held">
          <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusLight}" Value="Waiting">
          <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusLight}" Value="Error">
          <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Armed is the one state that can look stuck (with everyone excluded
         nothing can start the clock), so it is loud: a ring that keeps
         spreading from the dot. Thirty frames a second is plenty for it. -->
    <Style x:Key="ArmedRing" TargetType="Ellipse">
      <Setter Property="Width" Value="10"/>
      <Setter Property="Height" Value="10"/>
      <Setter Property="Opacity" Value="0"/>
      <Setter Property="StrokeThickness" Value="1.5"/>
      <Setter Property="Stroke" Value="{DynamicResource SystemFillColorCautionBrush}"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
      <Setter Property="RenderTransform">
        <Setter.Value>
          <ScaleTransform/>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding StatusLight}" Value="Armed">
          <DataTrigger.EnterActions>
            <BeginStoryboard x:Name="Pulse">
              <Storyboard RepeatBehavior="Forever" Timeline.DesiredFrameRate="30">
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.9" To="0" Duration="0:0:1.4"/>
                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" From="1" To="2.6" Duration="0:0:1.4"/>
                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" From="1" To="2.6" Duration="0:0:1.4"/>
              </Storyboard>
            </BeginStoryboard>
          </DataTrigger.EnterActions>
          <DataTrigger.ExitActions>
            <StopStoryboard BeginStoryboardName="Pulse"/>
          </DataTrigger.ExitActions>
        </DataTrigger>
      </Style.Triggers>
    </Style>

  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- The command bar: what is measured (the session), then what is counted
         and how it is shown. -->
    <DockPanel Grid.Row="0" Margin="16,12,16,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0"
                  ToolTip="Light, dark, or whatever Windows is set to">
        <RadioButton Style="{StaticResource Segment}" GroupName="theme"
                     IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=Light}"
                     AutomationProperties.Name="Light theme">
          <StackPanel Orientation="Horizontal">
            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE706;" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock Text="Light"/>
          </StackPanel>
        </RadioButton>
        <RadioButton Style="{StaticResource Segment}" GroupName="theme"
                     IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=Dark}"
                     AutomationProperties.Name="Dark theme">
          <StackPanel Orientation="Horizontal">
            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE708;" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock Text="Dark"/>
          </StackPanel>
        </RadioButton>
        <RadioButton Style="{StaticResource Segment}" GroupName="theme" Margin="0"
                     IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=System}"
                     AutomationProperties.Name="System theme">
          <StackPanel Orientation="Horizontal">
            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7F4;" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock Text="System"/>
          </StackPanel>
        </RadioButton>
      </StackPanel>

      <WrapPanel VerticalAlignment="Center">
        <!-- Which side of the fight is on screen. First on the bar, because
             everything under the bar changes with it. -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,6">
          <RadioButton Style="{StaticResource Segment}" GroupName="section" Content="Damage"
                       IsChecked="{Binding Section, Converter={StaticResource Equals}, ConverterParameter=Damage}"
                       ToolTip="The damage dealt in the session being measured"
                       AutomationProperties.Name="Damage section"/>
          <RadioButton Style="{StaticResource Segment}" GroupName="section" Content="Healing"
                       IsChecked="{Binding Section, Converter={StaticResource Equals}, ConverterParameter=Healing}"
                       ToolTip="The healing done in the same session"
                       AutomationProperties.Name="Healing section"/>
          <RadioButton Style="{StaticResource Segment}" GroupName="section" Content="Compare" Margin="0"
                       IsChecked="{Binding Section, Converter={StaticResource Equals}, ConverterParameter=Compare}"
                       ToolTip="Two saved parses side by side. The session goes on being measured underneath"
                       AutomationProperties.Name="Compare section"/>
        </StackPanel>

        <!-- One piece, so a narrow window wraps the pair and never parts it. -->
        <StackPanel Orientation="Horizontal" Margin="0,0,20,6">
          <Button Style="{StaticResource StartButton}" Command="{Binding StartCommand}" Content="{Binding View.StartText}"
                  ToolTip="{Binding View.StartTip}" IsEnabled="{Binding View.StartEnabled}" Margin="0,0,6,0"
                  AutomationProperties.AutomationId="Start"/>
          <Button Style="{StaticResource SecondButton}" Command="{Binding SecondCommand}" Content="{Binding View.SecondText}"
                  ToolTip="{Binding View.SecondTip}" IsEnabled="{Binding View.SecondEnabled}"
                  AutomationProperties.AutomationId="Second"/>
        </StackPanel>

        <!-- A paused parse saved to a file, and one opened in the session's
             place. Export wakes only while the clock is stopped; Back to
             live is there only while an import is on screen, and then over
             every section, since it is what the locked pair points at. -->
        <!-- Each a piece of its own, so the note arriving, or Back to live,
             wraps onto the next line by itself and moves no button that was
             already there. -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,6"
                    Visibility="{Binding IsLive, Converter={StaticResource Visible}}">
          <Button Content="Export…" Command="{Binding ExportCommand}" ToolTip="{Binding ExportTip}"
                  ToolTipService.ShowOnDisabled="True" VerticalAlignment="Center" Margin="0,0,6,0"
                  AutomationProperties.Name="Export"/>
          <Button Content="Import…" Command="{Binding ImportCommand}" ToolTip="{Binding ImportTip}"
                  VerticalAlignment="Center" AutomationProperties.Name="Import"/>
        </StackPanel>
        <Button Content="Back to live" Command="{Binding BackToLiveCommand}" Style="{DynamicResource AccentButtonStyle}"
                ToolTip="Leave the imported parse and return to the session being measured"
                VerticalAlignment="Center" Margin="0,0,6,6"
                Visibility="{Binding IsImported, Converter={StaticResource Visible}}"/>
        <!-- What the last Export or Import did. It clears itself. -->
        <TextBlock Text="{Binding ParseNote}" ToolTip="{Binding ParseNote}" FontSize="12" MaxWidth="460"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,0,6,6"
                   Background="Transparent" AutomationProperties.LiveSetting="Polite">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding ParseNoteBad}" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                </DataTrigger>
                <Trigger Property="Text" Value="">
                  <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <!-- The gap between this group and the toggles after it. -->
        <Border Width="14" Visibility="{Binding ParseBarOpen, Converter={StaticResource Visible}}"/>

        <!-- Toggles, not actions: the label is fixed and the pressed look says it is on. -->
        <!-- Not offered in the Healing section: it moves no healing figure.
             In Compare it is on the Compare card, beside what it changes. -->
        <ToggleButton Content="Include Skillchains" IsChecked="{Binding Skillchains}" ToolTip="{Binding SkillchainsTip}"
                      VerticalAlignment="Center" Margin="0,0,6,6"
                      Visibility="{Binding IsDamage, Converter={StaticResource Visible}}"/>
        <ToggleButton Content="Hide names" IsChecked="{Binding HideNames}" ToolTip="{Binding HideNamesTip}"
                      VerticalAlignment="Center" Margin="0,0,20,6"/>

        <!-- Here, not only on a panel's own bar: that slider is inside the
             panel, the one place someone who has not opened one cannot look. -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,6" Background="Transparent"
                    ToolTip="How solid the dark backdrop of a floating panel is; its text and bars stay solid. Moving this sets every panel to it. A panel's own slider then adjusts that one panel.">
          <TextBlock Text="Panel opacity" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <Slider Width="120" Minimum="15" Maximum="100" SmallChange="1" LargeChange="10" VerticalAlignment="Center"
                  IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding Panels.DefaultOpacity}"
                  AutomationProperties.Name="Default panel opacity"/>
          <TextBlock Text="{Binding Panels.DefaultOpacity, StringFormat={}{0}%}" Style="{StaticResource Label}"
                     VerticalAlignment="Center" MinWidth="34" TextAlignment="Right"
                     Typography.NumeralAlignment="Tabular"/>
        </StackPanel>
        <!-- Beside the other thing that is about every panel at once. The
             hot key does the same from inside the game, and this is where
             a player finds out which keys those are. -->
        <ToggleButton Content="Click-through" IsChecked="{Binding Panels.ClickThrough}"
                      ToolTip="{Binding Panels.ClickThroughTip}" VerticalAlignment="Center" Margin="14,0,6,6"
                      AutomationProperties.Name="Click-through panels"/>
      </WrapPanel>
    </DockPanel>

    <!-- The characters, on a line of their own: an alliance is eighteen names.
         Not over Compare: they filter the session, and its runs are files. -->
    <StackPanel Grid.Row="1" Margin="16,4,16,0" Visibility="{Binding IsLive, Converter={StaticResource Visible}}">
      <WrapPanel>
        <TextBlock Text="{Binding CharactersLabel}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                   Margin="0,0,10,6" Typography.NumeralAlignment="Tabular"/>
        <Button Style="{StaticResource SmallButton}" Content="{Binding CharactersToggleText}"
                ToolTip="{Binding CharactersToggleTip}" Click="OnCharactersToggle" Margin="0,0,10,6"
                AutomationProperties.Name="Show or hide the character list"/>
        <Button Style="{StaticResource SmallButton}" Content="All" Command="{Binding IncludeAllCommand}"
                ToolTip="Include every character listed" Margin="0,0,4,6" AutomationProperties.Name="Include all"/>
        <Button Style="{StaticResource SmallButton}" Content="None" Command="{Binding IncludeNoneCommand}"
                ToolTip="Exclude every character listed" Margin="0,0,12,6" AutomationProperties.Name="Include none"/>
        <!-- Says who is out even while the list is folded away. -->
        <TextBlock Text="{Binding CharactersHint}" Style="{StaticResource Label}" VerticalAlignment="Center"
                   Margin="0,0,0,6" TextTrimming="CharacterEllipsis"/>
      </WrapPanel>
      <!-- Capped, and scrolling past the cap, so a narrow window's list can't
           push the cards off the screen. -->
      <ScrollViewer MaxHeight="92" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    v:WheelChain.On="True"
                    Visibility="{Binding CharactersOpen, Converter={StaticResource Visible}}">
        <ItemsControl ItemsSource="{Binding Chips}" Focusable="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding Included}" ToolTip="{Binding Tip}"
                            AutomationProperties.Name="{Binding Name}">
                <StackPanel Orientation="Horizontal">
                  <Rectangle Style="{StaticResource Swatch}" Fill="{Binding Swatch}" RadiusX="5" RadiusY="5"
                             Margin="0,0,7,0"/>
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Job}" Style="{StaticResource Badge}"/>
                </StackPanel>
              </ToggleButton>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </StackPanel>

    <ScrollViewer x:Name="Body" Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
      <Grid Margin="16,0,16,16">
      <StackPanel Visibility="{Binding IsDamage, Converter={StaticResource Visible}}">

        <!-- One hero figure, then the clock beside the total it divides. -->
        <UniformGrid x:Name="Tiles" Columns="5" Margin="-6,0">
          <Border Style="{StaticResource Tile}">
            <StackPanel>
              <TextBlock Text="Total damage" Style="{StaticResource Label}"/>
              <TextBlock Text="{Binding TotalText}" Style="{StaticResource Figure}" FontSize="36"
                         Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
              <TextBlock Text="{Binding TotalNote}" Style="{StaticResource TileNote}"/>
            </StackPanel>
          </Border>
          <!-- The clock is a figure, not a caption: it is under every DPS
               here, and the one number that moves with nothing happening. -->
          <Border Style="{StaticResource Tile}">
            <StackPanel>
              <TextBlock Text="Elapsed" Style="{StaticResource Label}"/>
              <TextBlock Text="{Binding ClockText}" Style="{StaticResource Clock}" FontSize="36"/>
              <TextBlock Text="{Binding ClockNote}" Style="{StaticResource TileNote}"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Tile}">
            <StackPanel>
              <TextBlock Text="Party DPS" Style="{StaticResource Label}"/>
              <TextBlock Text="{Binding DpsText}" Style="{StaticResource Figure}" Margin="0,8,0,0"/>
              <TextBlock Text="{Binding DpsNote}" Style="{StaticResource TileNote}"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Tile}">
            <StackPanel>
              <TextBlock Text="Top DPS" Style="{StaticResource Label}"/>
              <DockPanel Margin="0,8,0,0" ToolTip="{Binding TopTip}" Background="Transparent">
                <Ellipse Width="12" Height="12" Fill="{Binding TopSwatch}" VerticalAlignment="Center" Margin="0,2,10,0"
                         Visibility="{Binding HasTop, Converter={StaticResource Visible}}"/>
                <TextBlock Text="{Binding TopName}" Style="{StaticResource Figure}" TextTrimming="CharacterEllipsis"/>
              </DockPanel>
              <TextBlock Text="{Binding TopNote}" Style="{StaticResource TileNote}"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Tile}">
            <StackPanel>
              <TextBlock Text="Biggest hit" Style="{StaticResource Label}"/>
              <TextBlock Text="{Binding BigText}" Style="{StaticResource Figure}" Margin="0,8,0,0"/>
              <TextBlock Text="{Binding BigNote}" Style="{StaticResource TileNote}"/>
            </StackPanel>
          </Border>
        </UniformGrid>

        <!-- Each card, or what stands in for it while it floats over the
             game in a panel of its own. -->
        <v:LineCard Margin="0,6,0,0" Visibility="{Binding Panels[line].IsOut, Converter={StaticResource Hidden}}"/>
        <v:Away Margin="0,6,0,0" DataContext="{Binding Panels[line]}"/>
        <v:BarsCard Margin="0,12,0,0" Visibility="{Binding Panels[bars].IsOut, Converter={StaticResource Hidden}}"/>
        <v:Away Margin="0,12,0,0" DataContext="{Binding Panels[bars]}"/>
        <v:ActionsCard Margin="0,12,0,0" Visibility="{Binding Panels[actions].IsOut, Converter={StaticResource Hidden}}"/>
        <v:Away Margin="0,12,0,0" DataContext="{Binding Panels[actions]}"/>
        <!-- Only there while an action is picked, and so is its stand-in: a
             card with nothing to show leaves no box behind. -->
        <StackPanel x:Name="Drill" Margin="0,12,0,0" Visibility="{Binding DrillOpen, Converter={StaticResource Visible}}">
          <v:DrillCard Visibility="{Binding Panels[drill].IsOut, Converter={StaticResource Hidden}}"/>
          <v:Away DataContext="{Binding Panels[drill]}"/>
        </StackPanel>

      </StackPanel>

      <!-- The Healing section: the same layout over the heals. The clock is
           the same clock; there is one session. -->
      <StackPanel Visibility="{Binding IsHealing, Converter={StaticResource Visible}}">

        <UniformGrid x:Name="HealTiles" Columns="5" Margin="-6,0">
          <Border Style="{StaticResource Tile}">
            <StackPanel>
              <TextBlock Text="Total healing" Style="{StaticResource Label}"/>
              <TextBlock Text="{Binding HealTotalText}" Style="{StaticResource Figure}" FontSize="36"
                         Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
              <TextBlock Text="{Binding HealTotalNote}" Style="{StaticResource TileNote}"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Tile}">
            <StackPanel>
              <TextBlock Text="Elapsed" Style="{StaticResource Label}"/>
              <TextBlock Text="{Binding ClockText}" Style="{StaticResource Clock}" FontSize="36"/>
              <TextBlock Text="{Binding ClockNote}" Style="{StaticResource TileNote}"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Tile}">
            <StackPanel>
              <TextBlock Text="Party HPS" Style="{StaticResource Label}"/>
              <TextBlock Text="{Binding HpsText}" Style="{StaticResource Figure}" Margin="0,8,0,0"/>
              <TextBlock Text="{Binding HpsNote}" Style="{StaticResource TileNote}"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Tile}">
            <StackPanel>
              <TextBlock Text="Top healer" Style="{StaticResource Label}"/>
              <DockPanel Margin="0,8,0,0" ToolTip="{Binding TopHealerTip}" Background="Transparent">
                <Ellipse Width="12" Height="12" Fill="{Binding TopHealerSwatch}" VerticalAlignment="Center" Margin="0,2,10,0"
                         Visibility="{Binding HasTopHealer, Converter={StaticResource Visible}}"/>
                <TextBlock Text="{Binding TopHealerName}" Style="{StaticResource Figure}" TextTrimming="CharacterEllipsis"/>
              </DockPanel>
              <TextBlock Text="{Binding TopHealerNote}" Style="{StaticResource TileNote}"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Tile}">
            <StackPanel>
              <TextBlock Text="Biggest heal" Style="{StaticResource Label}"/>
              <TextBlock Text="{Binding BigHealText}" Style="{StaticResource Figure}" Margin="0,8,0,0"/>
              <TextBlock Text="{Binding BigHealNote}" Style="{StaticResource TileNote}"/>
            </StackPanel>
          </Border>
        </UniformGrid>

        <v:HealLineCard Margin="0,6,0,0" Visibility="{Binding Panels[hline].IsOut, Converter={StaticResource Hidden}}"/>
        <v:Away Margin="0,6,0,0" DataContext="{Binding Panels[hline]}"/>
        <v:HealBarsCard Margin="0,12,0,0" Visibility="{Binding Panels[hbars].IsOut, Converter={StaticResource Hidden}}"/>
        <v:Away Margin="0,12,0,0" DataContext="{Binding Panels[hbars]}"/>
        <v:HealActionsCard Margin="0,12,0,0" Visibility="{Binding Panels[hactions].IsOut, Converter={StaticResource Hidden}}"/>
        <v:Away Margin="0,12,0,0" DataContext="{Binding Panels[hactions]}"/>
        <StackPanel x:Name="HealDrill" Margin="0,12,0,0"
                    Visibility="{Binding HealDrillOpen, Converter={StaticResource Visible}}">
          <v:HealDrillCard Visibility="{Binding Panels[hdrill].IsOut, Converter={StaticResource Hidden}}"/>
          <v:Away DataContext="{Binding Panels[hdrill]}"/>
        </StackPanel>

      </StackPanel>

      <!-- The Compare section: two saved parses side by side. -->
      <v:CompareSection DataContext="{Binding Compare}" Visibility="{Binding Active, Converter={StaticResource Visible}}"/>
      </Grid>
    </ScrollViewer>

    <!-- The status line: which file, how much of it, and the session. -->
    <DockPanel Grid.Row="3" Margin="16,6,16,10">
      <Grid DockPanel.Dock="Left" Width="26" Height="26" Margin="-6,-6,2,-6">
        <Ellipse Style="{StaticResource ArmedRing}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Ellipse Style="{StaticResource StatusDot}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
      <TextBlock Text="{Binding StatusFile}" FontSize="12" VerticalAlignment="Center"/>
      <TextBlock Text="  ·  " Style="{StaticResource Label}" VerticalAlignment="Center"/>
      <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource Label}" VerticalAlignment="Center"
                 Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis"/>
    </DockPanel>
  </Grid>
</Window>
