<Application x:Class="Zerg.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Zerg"
             xmlns:v="clr-namespace:Zerg.Views"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             ThemeMode="None"
             ShutdownMode="OnMainWindowClose">
  <!-- ThemeMode="None": no theme of Windows' is loaded. Every stock control
       is drawn by Zerg's own templates (Themes/Controls.xaml), in Zerg's own
       colours (AppTheme). It is said out loud, though None is what WPF does
       unasked, so that nobody takes its absence for an oversight. -->
  <Application.Resources>
    <ResourceDictionary>
    <ResourceDictionary.MergedDictionaries>
      <!-- Files of shared styles are merged here. The colours are not:
           AppTheme merges Themes/Dark.xaml or Themes/Light.xaml at run time,
           which is why every colour token is asked for with DynamicResource. -->
      <!-- Zerg's own look for every stock control, and the focus ring. -->
      <ResourceDictionary Source="Themes/Controls.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Plain "Segoe UI Variable" silently falls back: WPF sees the variable
         font only under its optical-size names. Segoe UI is the Windows 10 face.
         None of the three has a Medium (500) face WPF can pick: asked for
         Medium it draws SemiBold. -->
    <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="NumberFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <!-- The optical size for small capitals: wider and more open than Text. -->
    <FontFamily x:Key="SmallFont">Segoe UI Variable Small, Segoe UI</FontFamily>
    <!-- For what is read as a string: a file name, a path, a key, the time of
         a hit. Cascadia Mono comes with Windows 11; Consolas is behind it. -->
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
    <!-- Segoe Fluent Icons ships with Windows 11; MDL2 has the same code points. -->
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Measures (UI-REDESIGN-PLAN.md, section 4.6), in device-independent
         units. Heights of the window's bands, then of rows, then the rest. -->
    <sys:Double x:Key="TitleBarHeight">36</sys:Double>
    <sys:Double x:Key="CommandBarHeight">40</sys:Double>
    <sys:Double x:Key="FiguresBandHeight">64</sys:Double>
    <sys:Double x:Key="ViewBandHeight">38</sys:Double>
    <sys:Double x:Key="CharactersBandHeight">30</sys:Double>
    <sys:Double x:Key="PaneHeadingHeight">30</sys:Double>
    <!-- What stands in a pane's place while its card floats: a short strip. -->
    <sys:Double x:Key="StandInHeight">46</sys:Double>
    <sys:Double x:Key="StatusBarHeight">24</sys:Double>
    <sys:Double x:Key="ColumnHeadHeight">24</sys:Double>
    <sys:Double x:Key="GroupedHeadHeight">38</sys:Double>
    <sys:Double x:Key="RowHeight">24</sys:Double>
    <sys:Double x:Key="SubRowHeight">22</sys:Double>
    <sys:Double x:Key="HitRowHeight">20</sys:Double>
    <sys:Double x:Key="PairRowHeight">36</sys:Double>
    <sys:Double x:Key="PartyRowHeight">26</sys:Double>
    <!-- A cell's padding, left and right. -->
    <Thickness x:Key="CellPadding">8,0</Thickness>
    <!-- Corners: a control, a chip, the window. A bar or a swatch is a
         Rectangle, whose radius is a number. -->
    <CornerRadius x:Key="ControlRadius">4</CornerRadius>
    <CornerRadius x:Key="ChipRadius">3</CornerRadius>
    <CornerRadius x:Key="WindowRadius">8</CornerRadius>
    <sys:Double x:Key="BarRadius">2</sys:Double>
    <!-- The smallest a pane may be made, and the window width under which a
         section's panes stand in one column. -->
    <sys:Double x:Key="PaneMinWidth">320</sys:Double>
    <sys:Double x:Key="PaneMinHeight">132</sys:Double>
    <sys:Double x:Key="NarrowWidth">700</sys:Double>

    <local:EqualsConverter x:Key="Equals"/>

    <!-- ================================================================ type
         The scale (UI-REDESIGN-PLAN.md, section 4.5): 22, 18, 16, 15, 14, 13,
         12.5, 12, 11.5, 11, 10.5, 9.5, 9. Ink is the window's (Text1) unless
         a style says otherwise. -->

    <!-- A figure that updates live: tabular, so digits don't shuffle sideways
         as the value changes. The five across the top. -->
    <Style x:Key="Figure" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource NumberFont}"/>
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>
    <!-- Smaller figures: a Compare tile's, then the drill-down's six. -->
    <Style x:Key="TileFigure" TargetType="TextBlock" BasedOn="{StaticResource Figure}">
      <Setter Property="FontSize" Value="16"/>
    </Style>
    <Style x:Key="DrillFigure" TargetType="TextBlock" BasedOn="{StaticResource Figure}">
      <Setter Property="FontSize" Value="15"/>
    </Style>

    <!-- Titles, largest first: a page ("Settings"), a parse's name in a slot
         or the View band, a pane (and a section's tab). A drill-down's, 14,
         is said in the pane's own template (ZPane, the tall heading). -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource NumberFont}"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="SlotTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="PaneTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- A note: what a figure is of, what a pane holds, the status line's detail. -->
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource Text3Brush}"/>
    </Style>

    <!-- A label in small capitals with room between the letters: over a
         figure, "CHARACTERS 12/12", "BASELINE". Drawn by Views/Caps, because
         a TextBlock has no letter spacing. -->
    <Style x:Key="Caps" TargetType="v:Caps">
      <Setter Property="FontFamily" Value="{StaticResource SmallFont}"/>
      <Setter Property="FontSize" Value="9.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Tracking" Value="0.7"/>
      <Setter Property="Foreground" Value="{DynamicResource Text3Brush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- Over a group of columns (WEAPONSKILL, SKILLCHAIN, PET). Over a
         drill-down figure and in a strip's heading the tracking is 0.6. -->
    <Style x:Key="GroupCaps" TargetType="v:Caps" BasedOn="{StaticResource Caps}">
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="Tracking" Value="0.8"/>
    </Style>
    <!-- The state tag beside the clock (Views/StateTag draws it): the word
         LIVE, ARMED, HELD, IDLE or SAVED in the state's own colour, on a
         pill of that colour at 12% with an edge at 45% (the Tag* brushes).
         Green is counting; amber is armed or held; idle and a saved parse
         are the colour of a label. An element of a class of its own finds
         no style by its type: whoever uses one names this. -->
    <Style x:Key="StateTag" TargetType="v:StateTag">
      <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
      <Setter Property="FontSize" Value="9.5"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Tracking" Value="0.6"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Fill" Value="{DynamicResource TagIdleFillBrush}"/>
      <Setter Property="Edge" Value="{DynamicResource TagIdleEdgeBrush}"/>
      <Setter Property="Ink" Value="{DynamicResource Text3Brush}"/>
      <Style.Triggers>
        <Trigger Property="State" Value="Live">
          <Setter Property="Fill" Value="{DynamicResource TagLiveFillBrush}"/>
          <Setter Property="Edge" Value="{DynamicResource TagLiveEdgeBrush}"/>
          <Setter Property="Ink" Value="{DynamicResource LiveBrush}"/>
        </Trigger>
        <Trigger Property="State" Value="Armed">
          <Setter Property="Fill" Value="{DynamicResource TagHeldFillBrush}"/>
          <Setter Property="Edge" Value="{DynamicResource TagHeldEdgeBrush}"/>
          <Setter Property="Ink" Value="{DynamicResource AccentBrush}"/>
        </Trigger>
        <Trigger Property="State" Value="Held">
          <Setter Property="Fill" Value="{DynamicResource TagHeldFillBrush}"/>
          <Setter Property="Edge" Value="{DynamicResource TagHeldEdgeBrush}"/>
          <Setter Property="Ink" Value="{DynamicResource AccentBrush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- What is read as a string: a file name or the time of a hit at this
         size; a path or a colour code at 11.5; a key on a keycap at 10. -->
    <Style x:Key="Mono" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
    </Style>

    <!-- One choice of a few: a row of these, in a Border of the SegmentGroup
         style, is a segmented control (Themes/Controls.xaml draws both). -->
    <Style x:Key="Segment" TargetType="RadioButton" BasedOn="{StaticResource ZSegment}"/>

    <BooleanToVisibilityConverter x:Key="Visible"/>
    <v:HiddenConverter x:Key="Hidden"/>
    <v:PresentConverter x:Key="Present"/>

    <!-- The dark halo round the text of a floating panel, which keeps it
         legible over a bright part of the game with the panel's backdrop
         turned down: black, all round, about a unit and a half deep.

         An effect is worked out again whenever anything inside what it is
         set on is drawn again, or anything under it. So it is set only
         where that happens no oftener than events arrive: on a panel's bar
         (PanelWindow.xaml), and on the card of the four panels in which
         nothing moves with the clock (PanelWindow.xaml.cs, Halo). Never on
         a row, of which there are hundreds; and never over a cumulative
         chart, whose lines are drawn at the draw frequency: that chart
         draws a dark outline round its own labels (Charts/Chart, Halo). -->
    <DropShadowEffect x:Key="PanelHalo" ShadowDepth="0" BlurRadius="3" Color="Black" Opacity="0.75"/>

    <!-- A job beside a name ("SAM/WAR"). Gone, not blank, when there is none
         to show: the name already is the job, or no job was ever reported. -->
    <Style x:Key="Badge" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource Text3Brush}"/>
      <Style.Triggers>
        <Trigger Property="Text" Value="">
          <Setter Property="Visibility" Value="Collapsed"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- A character's colour, as a mark beside their name. -->
    <Style x:Key="Swatch" TargetType="Rectangle">
      <Setter Property="Width" Value="8"/>
      <Setter Property="Height" Value="8"/>
      <Setter Property="RadiusX" Value="{StaticResource BarRadius}"/>
      <Setter Property="RadiusY" Value="{StaticResource BarRadius}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Table cells. Figures are right-aligned and tabular, so a column of
         them lines up and holds still while it updates. -->
    <Style x:Key="Cell" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="{StaticResource CellPadding}"/>
      <Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>
    <Style x:Key="CellText" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
      <Setter Property="TextAlignment" Value="Left"/>
    </Style>
    <!-- A column's heading, in sentence case. The design asks for Medium
         (500); the face has none and WPF would draw SemiBold for it, so this
         is Regular (the plan's Q19). -->
    <Style x:Key="Head" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Foreground" Value="{DynamicResource Text3Brush}"/>
      <!-- So the whole cell, not just its letters, shows the tooltip. -->
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style x:Key="HeadText" TargetType="TextBlock" BasedOn="{StaticResource Head}">
      <Setter Property="TextAlignment" Value="Left"/>
    </Style>

    <!-- ============================================== the live tables' rows
         What the rows of the Damage and Healing sections' four tables are
         made of (and, with a band for each run in place of the one shade,
         the rows of the Compare section: Views/ComparePanes). A row is 24 units tall in a per-character table and 22
         under a heading in the Actions and Heals tables, each with its rule
         along its bottom edge inside it. Whether rows are shaded is said
         once on the card and inherited (Views/Shading), so every difference
         between a shaded row and a plain one is a trigger here, and a
         setting that flips makes no row again. -->

    <!-- A figure in a character's row. Nothing to measure is a dash, in an
         ink of its own: quieter than a figure, and on a shaded row a step
         lighter than on a plain one, or the shade would swallow it. -->
    <Style x:Key="Fig" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
      <Style.Triggers>
        <Trigger Property="Text" Value="&#x2014;">
          <Setter Property="Foreground" Value="{DynamicResource ShadedDashBrush}"/>
        </Trigger>
        <MultiTrigger>
          <MultiTrigger.Conditions>
            <Condition Property="Text" Value="&#x2014;"/>
            <Condition Property="v:Shading.Characters" Value="False"/>
          </MultiTrigger.Conditions>
          <Setter Property="Foreground" Value="{DynamicResource Text4Brush}"/>
        </MultiTrigger>
      </Style.Triggers>
    </Style>
    <!-- A secondary figure (an average, a share of the character's own
         damage): the quieter ink. A trigger outranks a setter, so its dash
         is still a dash. -->
    <Style x:Key="FigQuiet" TargetType="TextBlock" BasedOn="{StaticResource Fig}">
      <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
    </Style>
    <!-- The same two in a row under a character, which is plain unless
         "shade actions and heals" is on. -->
    <Style x:Key="SubFig" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
      <Style.Triggers>
        <Trigger Property="Text" Value="&#x2014;">
          <Setter Property="Foreground" Value="{DynamicResource Text4Brush}"/>
        </Trigger>
        <MultiTrigger>
          <MultiTrigger.Conditions>
            <Condition Property="Text" Value="&#x2014;"/>
            <Condition Property="v:Shading.Actions" Value="True"/>
          </MultiTrigger.Conditions>
          <Setter Property="Foreground" Value="{DynamicResource ShadedDashBrush}"/>
        </MultiTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SubFigQuiet" TargetType="TextBlock" BasedOn="{StaticResource SubFig}">
      <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
    </Style>

    <!-- The job in the per-character tables' Job column: on a shaded row
         the quieter ink, which holds on the pale shades where a label's
         does not; on a plain row a label's. -->
    <Style x:Key="JobCell" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
      <Setter Property="FontSize" Value="11"/>
      <!-- No room kept at the right: "BLM/WHM" needs the column's whole
           width, and the figure after it is set against its own far edge. -->
      <Setter Property="Padding" Value="8,0,0,0"/>
      <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
      <!-- So the whole cell, not just its letters, shows the tooltip. -->
      <Setter Property="Background" Value="Transparent"/>
      <Style.Triggers>
        <Trigger Property="v:Shading.Characters" Value="False">
          <Setter Property="Foreground" Value="{DynamicResource Text3Brush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- A cell that goes when its table is in a room too narrow for every
         column (Views/Shed): collapsed, it takes its column with it. For
         whatever is in such a column that is not text; the text styles
         after it are the same for a figure and a heading. -->
    <Style x:Key="Sheds" TargetType="FrameworkElement">
      <Style.Triggers>
        <Trigger Property="v:Shed.Narrow" Value="True">
          <Setter Property="Visibility" Value="Collapsed"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SubFigQuietSheds" TargetType="TextBlock" BasedOn="{StaticResource SubFigQuiet}">
      <Style.Triggers>
        <Trigger Property="v:Shed.Narrow" Value="True">
          <Setter Property="Visibility" Value="Collapsed"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="HeadSheds" TargetType="TextBlock" BasedOn="{StaticResource Head}">
      <Style.Triggers>
        <Trigger Property="v:Shed.Narrow" Value="True">
          <Setter Property="Visibility" Value="Collapsed"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <!-- The same three for a column that goes second, in a table that
         drops columns in two steps: when what is left after the first
         does not fit either. -->
    <Style x:Key="ShedsLate" TargetType="FrameworkElement">
      <Style.Triggers>
        <Trigger Property="v:Shed.Tight" Value="True">
          <Setter Property="Visibility" Value="Collapsed"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SubFigQuietShedsLate" TargetType="TextBlock" BasedOn="{StaticResource SubFigQuiet}">
      <Style.Triggers>
        <Trigger Property="v:Shed.Tight" Value="True">
          <Setter Property="Visibility" Value="Collapsed"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="HeadShedsLate" TargetType="TextBlock" BasedOn="{StaticResource Head}">
      <Style.Triggers>
        <Trigger Property="v:Shed.Tight" Value="True">
          <Setter Property="Visibility" Value="Collapsed"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- A character's share, as the row's own background: from the row's
         left edge to the share's length (Views/Grow scales it, so nothing
         is laid out as it moves). Its strength is in its brush. Its end is
         exact and unmarked. Gone while "shade characters" is off. -->
    <Style x:Key="RowShade" TargetType="Rectangle">
      <Setter Property="RenderTransformOrigin" Value="0,0.5"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
      <Style.Triggers>
        <Trigger Property="v:Shading.Characters" Value="False">
          <Setter Property="Visibility" Value="Collapsed"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <!-- The same behind a row under a character, with no colour: there
         only while "shade actions and heals" is on. -->
    <Style x:Key="SubShade" TargetType="Rectangle">
      <Setter Property="RenderTransformOrigin" Value="0,0.5"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
      <Setter Property="Fill" Value="{DynamicResource ActionShadeBrush}"/>
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers>
        <Trigger Property="v:Shading.Actions" Value="True">
          <Setter Property="Visibility" Value="Visible"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- The rule along a row's bottom edge. -->
    <Style x:Key="RowRule" TargetType="Rectangle">
      <Setter Property="Height" Value="1"/>
      <Setter Property="VerticalAlignment" Value="Bottom"/>
      <Setter Property="Fill" Value="{DynamicResource LineBrush}"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <!-- What a row under the pointer wears: a little light over its whole
         width, shade and all, and a stronger rule above and below. It
         reaches up over the rule of the row above. Collapsed until the row
         says otherwise. -->
    <Style x:Key="RowHover" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line3Brush}"/>
      <Setter Property="BorderThickness" Value="0,1"/>
      <Setter Property="Margin" Value="0,-1,0,0"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
      <Setter Property="Visibility" Value="Collapsed"/>
    </Style>

    <!-- Whose file this is: a small amber triangle at the left of the
         owner's row, found without reading the names. -->
    <Style x:Key="OwnerMark" TargetType="Path">
      <Setter Property="Data" Value="M0,0 L4,3.5 L0,7 Z"/>
      <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Stroke" Value="{DynamicResource Bg1Brush}"/>
      <Setter Property="StrokeThickness" Value="0.8"/>
      <Setter Property="StrokeLineJoin" Value="Round"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="3,0,0,1"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <!-- The mark before a character's heading in the Actions and Heals
         tables: pointing right while their rows are put away, down while
         they show. Drawn, so it is crisp at this size. -->
    <Style x:Key="RowCaret" TargetType="Path">
      <Setter Property="Width" Value="8"/>
      <Setter Property="Height" Value="8"/>
      <Setter Property="Data" Value="M2,0.5 L6,4 L2,7.5"/>
      <Setter Property="Stroke" Value="{DynamicResource Text2Brush}"/>
      <Setter Property="StrokeThickness" Value="1.3"/>
      <Setter Property="StrokeLineJoin" Value="Round"/>
      <Setter Property="StrokeStartLineCap" Value="Round"/>
      <Setter Property="StrokeEndLineCap" Value="Round"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Open}" Value="True">
          <Setter Property="Data" Value="M0.5,2 L4,6 L7.5,2"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- A row of the Actions or Heals table: the whole row is the thing to
         press. 22 units, its rule inside it along the bottom. Under the
         pointer, or with the keyboard on it, it wears what RowHover
         describes. Its face is the row's own surface: the raised one on a
         character's heading, the selected one on the action the drill-down
         is open on. -->
    <Style x:Key="RowPick" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{StaticResource ZFocusInset}"/>
      <Setter Property="Height" Value="{StaticResource SubRowHeight}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource Text1Brush}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource LineBrush}"
                      BorderThickness="0,0,0,1" SnapsToDevicePixels="True"/>
              <ContentPresenter/>
              <Border x:Name="Hover" Style="{StaticResource RowHover}"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Hover" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Hover" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===================================================== the side tables
         By target and By damage type: in the Damage section over one parse
         (Views/TallyCard), in the Compare section over two runs
         (Views/ComparePanes). The two share how a row that isolates is
         drawn; what is in its cells is each table's own. A row says
         Isolated, Dimmed, Name, Tip and PickCommand, whichever kind it is
         (TallyRow, ComparePickRow). -->

    <!-- A row of a side table that is pressed to isolate it: a target, a
         damage type. The Target and Type buttons' menus do the same.
         Isolated, it has the accent down its left edge and its name is
         stronger; while others are isolated and it is not, it is dimmed: it
         is still listed, with what it came to, and is in no other figure.
         The row's cells are the template's that names this style. 28 units
         for the two lines of a Compare row; a table of one parse says its
         own height. -->
    <Style x:Key="SidePick" TargetType="Button" BasedOn="{StaticResource RowPick}">
      <Setter Property="Height" Value="28"/>
      <Setter Property="ToolTip" Value="{Binding Tip}"/>
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
      <Setter Property="Command" Value="{Binding PickCommand}"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Isolated}" Value="True">
          <Setter Property="AutomationProperties.ItemStatus" Value="isolated"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <!-- The accent down an isolated row's left edge. -->
    <Style x:Key="PickEdge" TargetType="Rectangle">
      <Setter Property="Width" Value="3"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="Margin" Value="0,0,0,1"/>
      <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Isolated}" Value="True">
          <Setter Property="Visibility" Value="Visible"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <!-- What is dimmed of a row that is not among the isolated. -->
    <Style x:Key="PickCells" TargetType="Grid">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Dimmed}" Value="True">
          <Setter Property="Opacity" Value="0.5"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PickName" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
      <Setter Property="Padding" Value="14,0,8,0"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Isolated}" Value="True">
          <Setter Property="FontWeight" Value="SemiBold"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- The rows of a side table scroll under its headings in what the
         pane has left. In a narrow window, where a pane is as tall as it
         asks to be, the list is as tall as it needs, up to a cap. -->
    <Style x:Key="SideList" TargetType="Grid">
      <Style.Triggers>
        <Trigger Property="v:SplitPanel.Stacked" Value="True">
          <Setter Property="MaxHeight" Value="340"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- ================================================= the Compare section
         What its bands (Views/CompareSection) and its panes
         (Views/ComparePanes) both draw with. -->

    <!-- A run's badge: its letter on its colour, in whichever ink is
         clearer on it. 16 units on a slot, 13 beside a figure. -->
    <ControlTemplate x:Key="RunTagA" TargetType="Control">
      <Border CornerRadius="3" Background="{DynamicResource RunABrush}" SnapsToDevicePixels="True">
        <TextBlock Text="A" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource RunAInkBrush}"/>
      </Border>
    </ControlTemplate>
    <ControlTemplate x:Key="RunTagB" TargetType="Control">
      <Border CornerRadius="3" Background="{DynamicResource RunBBrush}" SnapsToDevicePixels="True">
        <TextBlock Text="B" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource RunBInkBrush}"/>
      </Border>
    </ControlTemplate>
    <Style x:Key="RunTag" TargetType="Control">
      <Setter Property="Width" Value="16"/>
      <Setter Property="Height" Value="16"/>
      <Setter Property="FontSize" Value="10.9"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="RunTagSmall" TargetType="Control" BasedOn="{StaticResource RunTag}">
      <Setter Property="Width" Value="13"/>
      <Setter Property="Height" Value="13"/>
      <Setter Property="FontSize" Value="8.8"/>
    </Style>

    <!-- A change as one line of text where its two parts stand apart: on a
         tile, and in the two columns beside a distribution. Bound to
         Change.Main; the tone is the Change's beside it. -->
    <Style x:Key="Tone" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
      <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Change.Tone}" Value="Better">
          <Setter Property="Foreground" Value="{DynamicResource LiveBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Change.Tone}" Value="Worse">
          <Setter Property="Foreground" Value="{DynamicResource CritBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Change.Tone}" Value="None">
          <Setter Property="FontWeight" Value="Normal"/>
          <Setter Property="Foreground" Value="{DynamicResource Text4Brush}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Small controls: the plain button two units shorter (a stand-in's
         "Bring back"), and the command bar's toggles, which are tick boxes
         under the name the bar already used. -->
    <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource ZButton}">
      <Setter Property="Height" Value="24"/>
      <Setter Property="Padding" Value="10,0"/>
    </Style>
    <Style x:Key="SmallToggle" TargetType="ToggleButton" BasedOn="{StaticResource TickToggle}"/>

    <!-- The two session buttons. They are the only controls that change what
         is measured rather than what is shown, so they are the widest on the
         bar and the only ones whose fill says a state. Their own template,
         because a plain button repaints its fill when pointed at: these keep
         their colour and only dim. Each carries a glyph before its word, so
         the pair reads out of the corner of an eye. -->
    <Style x:Key="SessionButton" TargetType="ButtonBase">
      <Setter Property="MinWidth" Value="92"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Background" Value="{DynamicResource Bg3Brush}"/>
      <Setter Property="Foreground" Value="{DynamicResource Text1Brush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line2Brush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource ZFocus}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ButtonBase">
            <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource ControlRadius}"
                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Face" Property="Opacity" Value="0.88"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Face" Property="Opacity" Value="0.72"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- What is on a session button: its glyph, then its word. The glyph
         follows the same look as the fill (SessionView.StartLook and
         SecondLook, read off the button's data context: the content here is
         only the word). A panel's bar leaves the glyph out by taking this
         template off (BarStart and BarSecond in PanelWindow.xaml). -->
    <DataTemplate x:Key="StartFace">
      <StackPanel Orientation="Horizontal">
        <!-- Restart, the look of two of the five. -->
        <TextBlock x:Name="Glyph" FontFamily="{StaticResource IconFont}" FontSize="11" FontWeight="Normal"
                   VerticalAlignment="Center" Margin="0,1,6,0" Text="&#xE72C;"/>
        <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding DataContext.View.StartLook, RelativeSource={RelativeSource AncestorType=ButtonBase}}" Value="Idle">
          <Setter TargetName="Glyph" Property="Text" Value="&#xE768;"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding DataContext.View.StartLook, RelativeSource={RelativeSource AncestorType=ButtonBase}}" Value="Locked">
          <Setter TargetName="Glyph" Property="Text" Value="&#xE768;"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding DataContext.View.StartLook, RelativeSource={RelativeSource AncestorType=ButtonBase}}" Value="Confirm">
          <Setter TargetName="Glyph" Property="Text" Value="&#xE73E;"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate x:Key="SecondFace">
      <StackPanel Orientation="Horizontal">
        <!-- Pause, the look of two of the four. -->
        <TextBlock x:Name="Glyph" FontFamily="{StaticResource IconFont}" FontSize="11" FontWeight="Normal"
                   VerticalAlignment="Center" Margin="0,1,6,0" Text="&#xE769;"/>
        <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding DataContext.View.SecondLook, RelativeSource={RelativeSource AncestorType=ButtonBase}}" Value="Cancel">
          <Setter TargetName="Glyph" Property="Text" Value="&#xE711;"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding DataContext.View.SecondLook, RelativeSource={RelativeSource AncestorType=ButtonBase}}" Value="Held">
          <Setter TargetName="Glyph" Property="Text" Value="&#xE768;"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Start is the thing to press until it has been pressed; while it
         waits for the first hit it wears the waiting colour; once the clock
         runs it steps back, because Restart is a re-do; and pressed then,
         it is Confirm in the colour of something lost, until it is answered.
         Over a parse that is only being looked at it can do nothing, and is
         drawn as a disabled button is. A filled look has no edge of another
         colour. Bound to the view model's session, wherever the button is:
         the main window's bar and every floating panel's carry the same
         pair. -->
    <Style x:Key="StartButton" TargetType="Button" BasedOn="{StaticResource SessionButton}">
      <Setter Property="ContentTemplate" Value="{StaticResource StartFace}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding View.StartLook}" Value="Confirm">
          <Setter Property="Background" Value="{DynamicResource CritBrush}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource CritBrush}"/>
          <Setter Property="Foreground" Value="{DynamicResource OnCritBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding View.StartLook}" Value="Idle">
          <Setter Property="Background" Value="{DynamicResource LiveBrush}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource LiveBrush}"/>
          <Setter Property="Foreground" Value="{DynamicResource OnLiveBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding View.StartLook}" Value="Armed">
          <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
          <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding View.StartLook}" Value="Locked">
          <Setter Property="Background" Value="{DynamicResource Bg2Brush}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
          <Setter Property="Foreground" Value="{DynamicResource Text4Brush}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <!-- Pause, or Cancel while armed. Filled only while it is holding the
         clock; with nothing to pause, drawn as a disabled button is. -->
    <Style x:Key="SecondButton" TargetType="Button" BasedOn="{StaticResource SessionButton}">
      <Setter Property="ContentTemplate" Value="{StaticResource SecondFace}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding View.SecondLook}" Value="Held">
          <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
          <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding View.SecondLook}" Value="Off">
          <Setter Property="Background" Value="{DynamicResource Bg2Brush}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
          <Setter Property="Foreground" Value="{DynamicResource Text4Brush}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Two colours, one meaning each, on the clock, the state tag and the
         status dot alike: green is counting, amber is held. The clock of a
         saved parse is neither (nobody is holding it): it is the colour of
         a label, as its tag is. Hence the tag, not the light, which is Held
         for a saved parse. -->
    <Style x:Key="Clock" TargetType="TextBlock" BasedOn="{StaticResource Figure}">
      <Setter Property="Foreground" Value="{DynamicResource Text3Brush}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tag}" Value="Live">
          <Setter Property="Foreground" Value="{DynamicResource LiveBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Tag}" Value="Held">
          <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- One character's on/off switch on the characters' line: a small
         rectangle with their colour and their name (what is in it is the
         window's to say). Switched off, it has no face and a dashed edge,
         and its name is dim, so the ones being counted stand out. The
         states are triggers on the style; the template only draws them,
         with the dashed edge in the place of the whole one. -->
    <Style x:Key="Chip" TargetType="ToggleButton">
      <Setter Property="FocusVisualStyle" Value="{StaticResource ZFocus}"/>
      <Setter Property="Height" Value="20"/>
      <Setter Property="Padding" Value="7,0"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Background" Value="{DynamicResource Bg2Brush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line2Brush}"/>
      <Setter Property="Foreground" Value="{DynamicResource Text1Brush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Grid SnapsToDevicePixels="True">
              <Border x:Name="Whole" CornerRadius="{StaticResource ChipRadius}" BorderThickness="1"
                      Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"/>
              <Rectangle x:Name="Dashed" RadiusX="3" RadiusY="3" StrokeThickness="1" StrokeDashArray="3 2"
                         Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" Visibility="Collapsed"/>
              <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="False">
                <Setter TargetName="Whole" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="Dashed" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsChecked" Value="False">
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="Foreground" Value="{DynamicResource Text4Brush}"/>
        </Trigger>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource Line3Brush}"/>
        </Trigger>
        <MultiTrigger>
          <MultiTrigger.Conditions>
            <Condition Property="IsChecked" Value="True"/>
            <Condition Property="IsMouseOver" Value="True"/>
          </MultiTrigger.Conditions>
          <Setter Property="Background" Value="{DynamicResource Bg4Brush}"/>
        </MultiTrigger>
        <MultiTrigger>
          <MultiTrigger.Conditions>
            <Condition Property="IsChecked" Value="False"/>
            <Condition Property="IsMouseOver" Value="True"/>
          </MultiTrigger.Conditions>
          <Setter Property="Foreground" Value="{DynamicResource Text3Brush}"/>
        </MultiTrigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="{DynamicResource Bg2Brush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- The chip after the chips: "+5" while five of them do not fit on the
         line, and it opens the line onto all of them; a chevron once it has,
         to fold them back into one line. An edge and no face, as the sheet
         draws it. Shown only while it has something to do (Views/ChipLine). -->
    <Style x:Key="ChipMore" TargetType="ToggleButton">
      <Setter Property="FocusVisualStyle" Value="{StaticResource ZFocus}"/>
      <Setter Property="Height" Value="20"/>
      <Setter Property="MinWidth" Value="33"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line2Brush}"/>
      <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
      <Setter Property="ToolTip" Value="Show every character, on as many lines as they take"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border CornerRadius="{StaticResource ChipRadius}" BorderThickness="1" SnapsToDevicePixels="True"
                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
              <Grid Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ContentPresenter x:Name="Count"/>
                <Path x:Name="Fold" Data="M0.65,4.15 L4.15,0.65 L7.65,4.15" Width="8.3" Height="4.8" Visibility="Collapsed"
                      Stroke="{TemplateBinding Foreground}" StrokeThickness="1.3" StrokeLineJoin="Round"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Count" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="Fold" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsChecked" Value="True">
          <Setter Property="ToolTip" Value="Fold the characters back into one line"/>
        </Trigger>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource Bg4Brush}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource Line3Brush}"/>
          <Setter Property="Foreground" Value="{DynamicResource Text1Brush}"/>
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="{DynamicResource Bg2Brush}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource Line2Brush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    </ResourceDictionary>
  </Application.Resources>
</Application>
