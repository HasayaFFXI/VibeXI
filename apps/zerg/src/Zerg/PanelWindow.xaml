<Window x:Class="Zerg.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Zerg.Views"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False" WindowStartupLocation="Manual"
        ThemeMode="Dark" Foreground="{DynamicResource Text1Brush}"
        MinWidth="280" MinHeight="110"
        FontFamily="{StaticResource TextFont}" UseLayoutRounding="True">
  <!-- One card, floating over the game.

       The window is see-through per pixel: its backdrop is black at the
       opacity the slider says, and everything drawn on it is solid, so the
       game shows through the panel while its text and bars stay as legible
       as they are in the main window. It is dark whatever the theme: a
       black tint needs light ink.

       Every pixel of chrome here is a pixel of the fight nobody can see, so
       the bar is one short line and the card inside gives up its own frame
       and heading (the Float.On triggers in App.xaml). -->
  <Window.Resources>
    <ResourceDictionary>
    <!-- The tokens as a panel has them: dark whatever the theme. A card in
         here finds these before the application's. -->
    <ResourceDictionary.MergedDictionaries>
      <ResourceDictionary Source="Themes/Panel.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- The ring round a chart marker is the colour of what the chart sits
         on. Here that is the tint, whatever is behind it. -->
    <SolidColorBrush x:Key="ChartSurfaceBrush" Color="#101010"/>

    <!-- The main window's pair, sized for a bar one line tall. Still the
         largest things on it, and the only ones with a colour. -->
    <Style x:Key="BarStart" TargetType="Button" BasedOn="{StaticResource StartButton}">
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Padding" Value="12,2,12,3"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="BarSecond" TargetType="Button" BasedOn="{StaticResource SecondButton}">
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Padding" Value="12,2,12,3"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    </ResourceDictionary>
  </Window.Resources>

  <Border x:Name="Frame" CornerRadius="8" BorderThickness="1" BorderBrush="#33FFFFFF">
    <DockPanel>

      <!-- The bar. Dragging it moves the panel. -->
      <Border x:Name="Bar" DockPanel.Dock="Top" Height="32" Padding="10,0,6,0" Background="Transparent"
              BorderThickness="0,0,0,1" BorderBrush="#22FFFFFF">
        <DockPanel>
          <!-- Out of the way until the pointer is over the panel: the bar is
               chrome, the card is the point. -->
          <!-- Click-through: nothing on the panel can be pressed, so the bar
               shows nothing that could be. This says why, in the place the
               tools were. -->
          <TextBlock x:Name="Locked" DockPanel.Dock="Right" Visibility="Collapsed" VerticalAlignment="Center"
                     FontFamily="{StaticResource IconFont}" Text="&#xE72E;" FontSize="12" Margin="2,0,4,0"
                     Foreground="{DynamicResource Text3Brush}"
                     AutomationProperties.Name="Click-through: clicks pass through this panel"/>
          <StackPanel x:Name="Tools" DockPanel.Dock="Right" Orientation="Horizontal" Opacity="0.45">
            <Slider Width="64" MinWidth="0" Minimum="15" Maximum="100" SmallChange="1" LargeChange="10" VerticalAlignment="Center"
                    IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding Opacity}"
                    AutomationProperties.Name="Panel opacity"
                    ToolTip="How solid this panel's backdrop is. Drag left to see more of the game through it."/>
            <TextBlock Text="{Binding Opacity, StringFormat={}{0}%}" FontSize="11" Width="32" TextAlignment="Right"
                       VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"
                       Foreground="{DynamicResource Text2Brush}"/>
            <Button Style="{StaticResource SmallButton}" Command="{Binding DockCommand}" Margin="6,0,0,0"
                    Padding="6,4" VerticalAlignment="Center" AutomationProperties.Name="Dock"
                    ToolTip="Dock: return this card to the main window">
              <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8BB;" FontSize="10"/>
            </Button>
          </StackPanel>

          <!-- Start and Pause are here because a panel is floated over the
               game so a fight can be measured without leaving it, and a
               session that has to be started from another window is started
               late. Never faded: a Start button at half strength over a
               battle is not a Start button.

               The clock and the total sit to the RIGHT of the pair, which is
               a fixed target aimed at without looking: a readout ahead of it
               would push both buttons sideways when the clock passes an hour.
               Elapsed, then total, as the first two tiles of the main window. -->
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,10,0">
            <!-- Gone while clicks pass through; the clock and the total stay. -->
            <StackPanel x:Name="Pair" Orientation="Horizontal">
              <Button Style="{StaticResource BarStart}" Command="{Binding StartCommand}" Content="{Binding View.StartText}"
                      ToolTip="{Binding View.StartTip}" IsEnabled="{Binding View.StartEnabled}" Margin="0,0,4,0"
                      AutomationProperties.AutomationId="Start"/>
              <Button Style="{StaticResource BarSecond}" Command="{Binding SecondCommand}" Content="{Binding View.SecondText}"
                      ToolTip="{Binding View.SecondTip}" IsEnabled="{Binding View.SecondEnabled}"
                      AutomationProperties.AutomationId="Second"/>
            </StackPanel>
            <!-- As wide as H:MM:SS from the start, so the hour does not move the total. -->
            <TextBlock Text="{Binding ClockText}" Style="{StaticResource Clock}" FontSize="14" MinWidth="58"
                       TextAlignment="Center" VerticalAlignment="Center" Margin="8,0,6,0" Background="Transparent"
                       ToolTip="Elapsed session time"/>
            <!-- Free to grow: it is last, so a seventh digit pushes only the title.
                 The total of what the card is about: a heal panel is given
                 the healing total in its place (PanelWindow.xaml.cs). -->
            <TextBlock x:Name="BarTotal" Text="{Binding TotalText}" Style="{StaticResource Figure}" FontSize="14"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource AccentBrush}" Background="Transparent"
                       ToolTip="Total damage this session"/>
          </StackPanel>

          <!-- The one thing on the bar meant to give way when the panel is narrow. -->
          <TextBlock x:Name="BarTitle" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Opacity="0.45"
                     TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Text2Brush}"
                     ToolTip="Drag to move the panel. Drag an edge to resize it."/>
        </DockPanel>
      </Border>

      <ContentControl x:Name="Body" Margin="6,4,6,8" v:Float.On="True" Focusable="False"/>

    </DockPanel>
  </Border>
</Window>
