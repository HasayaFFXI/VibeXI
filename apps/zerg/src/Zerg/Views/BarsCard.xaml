<UserControl x:Class="Zerg.Views.BarsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:v="clr-namespace:Zerg.Views">
  <UserControl.Resources>
    <!-- Character, Job, then twelve figures: the widths the design draws
         them at in a table 930 wide, as shares, so the table is as drawn in
         its pane and in proportion in any other. The heading and every row
         share them. (DPS has four units more than the design draws, from
         the name: a party's rate runs to four figures before the point.)
         The columns that can hold the longest figures (the damages, DPS)
         give them their whole width: a total past a million is cut short
         otherwise. -->
    <sys:String x:Key="Columns">134*,70*,68*,64*,58*,62*,68*,52*,54*,58*,64*,54*,66*,58*</sys:String>
    <!-- With "shade characters" off the share is a small bar beside the
         Damage % figure, which needs the room: the name gives it up. The
         first six columns come to the same either way, so the groups over
         the others stay where they are. -->
    <sys:String x:Key="BarColumns">94*,70*,68*,104*,58*,62*,68*,52*,54*,58*,64*,54*,66*,58*</sys:String>
    <Style x:Key="Table" TargetType="v:Cells">
      <Setter Property="Widths" Value="{StaticResource Columns}"/>
      <Style.Triggers>
        <Trigger Property="v:Shading.Characters" Value="False">
          <Setter Property="Widths" Value="{StaticResource BarColumns}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <!-- What lies over the columns: nothing over the first six, then
         WEAPONSKILL over four, SKILLCHAIN over two and PET over two. With
         names hidden the Job column is gone, and the first is that much
         narrower. -->
    <Style x:Key="Groups" TargetType="v:Cells">
      <Setter Property="Widths" Value="456*,232*,118*,124*"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding ShowJob}" Value="False">
          <Setter Property="Widths" Value="386*,232*,118*,124*"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <!-- A group's name between two hairlines, over its columns. -->
    <ControlTemplate x:Key="Group" TargetType="ContentControl">
      <Grid>
        <!-- The rule that begins the group, beside its column headings. -->
        <Rectangle Width="1" HorizontalAlignment="Left" Margin="1,20,0,0" Fill="{DynamicResource LineBrush}"
                   SnapsToDevicePixels="True"/>
        <Grid VerticalAlignment="Top" Margin="8,5,8,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <Rectangle Height="1" VerticalAlignment="Center" Fill="{DynamicResource Line2Brush}" SnapsToDevicePixels="True"/>
          <ContentPresenter Grid.Column="1" Margin="8,0" VerticalAlignment="Center"/>
          <Rectangle Grid.Column="2" Height="1" VerticalAlignment="Center" Fill="{DynamicResource Line2Brush}"
                     SnapsToDevicePixels="True"/>
        </Grid>
      </Grid>
    </ControlTemplate>
    <!-- The same rule carried through the Party line. -->
    <Style x:Key="PartyRule" TargetType="Border">
      <Setter Property="BorderBrush" Value="{DynamicResource Line2Brush}"/>
      <Setter Property="BorderThickness" Value="1,0,0,0"/>
      <Setter Property="Margin" Value="1,0,0,0"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- The strip: Character, then Damage, % and Acc%, each wide enough for
         its longest figure so one growing a digit moves nothing beside it;
         a figure ends 2 units short of its column. The name has what is
         left, and 110 at least: in a panel too narrow for that the strip
         drops Acc% and the job beside the name (v:Shed, as the Actions
         table drops columns), which is the strip the design draws 250 wide.
         With "shade characters" off the share is a small bar beside the %
         figure, which needs the room. -->
    <sys:String x:Key="StripColumns">1*110,72,52,56</sys:String>
    <sys:String x:Key="StripBarColumns">1*110,72,96,56</sys:String>
    <Style x:Key="Strip" TargetType="v:Cells">
      <Setter Property="Widths" Value="{StaticResource StripColumns}"/>
      <Style.Triggers>
        <Trigger Property="v:Shading.Characters" Value="False">
          <Setter Property="Widths" Value="{StaticResource StripBarColumns}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <!-- The strip itself says whether its columns fit (v:Shed.Full). -->
    <Style x:Key="StripRoom" TargetType="StackPanel">
      <Setter Property="v:Shed.Full" Value="{StaticResource StripColumns}"/>
      <Style.Triggers>
        <Trigger Property="v:Shading.Characters" Value="False">
          <Setter Property="v:Shed.Full" Value="{StaticResource StripBarColumns}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <!-- A column's heading in the strip: small capitals, set against the
         column's right-hand end as its figures are. -->
    <Style x:Key="StripHead" TargetType="v:Caps" BasedOn="{StaticResource GroupCaps}">
      <Setter Property="Tracking" Value="0.6"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="Margin" Value="4,0,2,0"/>
    </Style>
    <Style x:Key="StripCell" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Padding" Value="4,0,2,0"/>
      <Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
      <Style.Triggers>
        <!-- Nothing to measure: a dash, in the quietest ink. -->
        <Trigger Property="Text" Value="&#x2014;">
          <Setter Property="Foreground" Value="{DynamicResource Text4Brush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <!-- The last column's, which goes in a narrow panel. -->
    <Style x:Key="StripCellSheds" TargetType="TextBlock" BasedOn="{StaticResource StripCell}">
      <Style.Triggers>
        <Trigger Property="v:Shed.Narrow" Value="True">
          <Setter Property="Visibility" Value="Collapsed"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <!-- The job beside the name: quieter than the name, and gone in a
         narrow panel (and where there is none to show, as any badge). -->
    <Style x:Key="StripJob" TargetType="TextBlock" BasedOn="{StaticResource Badge}">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
      <Style.Triggers>
        <Trigger Property="v:Shed.Narrow" Value="True">
          <Setter Property="Visibility" Value="Collapsed"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <!-- Damage by character: one table, and the bar is the row. Each
       character's row is shaded in their colour from its left edge to a
       length that is their damage out of the leader's, with all fourteen
       figures on top. A pane: the column headings stand still, the rows
       scroll under them, and the Party line stands still under the rows.

       Floating, it is a strip instead: one short row per character, the bar
       behind the name, and three figures. For an alliance the whole table
       would cover the game it is laid over.

       The pane says how its rows are drawn (v:Shading), to both forms. -->
  <v:Pane Title="Damage by character" Note="Total dealt since the session started"
          Hint="Total dealt since the session started. Hover a column heading for how it is counted."
          PopOutCommand="{Binding Panels[bars].PopOutCommand}"
          v:Shading.Characters="{Binding ShadeCharacters}" v:Shading.LowAccuracy="{Binding LowAccuracy}">
    <Grid>
      <!-- The strip. A line of headings, then a row per character, 20
           units and a gap of 1. Back to front in a row: the shade, in the
           character's colour at the strength a panel allows it, from the
           row's left edge to their damage out of the leader's (gone while
           "shade characters" is off, when a small bar stands beside the %
           figure instead); a solid edge 3 units wide in the same colour,
           which stands in for a swatch and stays either way; the owner's
           mark, in the gutter left of the row; the cells.

           Nothing in a row has an effect of its own: the halo round a
           panel's text is one effect on the whole card (PanelWindow), and
           a row is the hot path. Nothing here moves with the clock. -->
      <StackPanel Style="{StaticResource StripRoom}"
                  Visibility="{Binding Path=(v:Float.On), RelativeSource={RelativeSource Self}, Converter={StaticResource Visible}}">
        <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Label}" FontSize="12" Margin="13,8,13,0"
                   Visibility="{Binding HasActors, Converter={StaticResource Hidden}}"/>
        <v:Cells Style="{StaticResource Strip}" Height="{StaticResource HitRowHeight}" Margin="3,0"
                 Visibility="{Binding HasActors, Converter={StaticResource Visible}}">
          <v:Caps Text="CHARACTER" Style="{StaticResource StripHead}" HorizontalAlignment="Left" Margin="10,0,4,0"/>
          <v:Caps Text="DAMAGE" Style="{StaticResource StripHead}"/>
          <!-- A border, so the whole of the column's heading shows the tooltip. -->
          <Border Background="Transparent" ToolTip="This character's damage out of the whole party's">
            <v:Caps Text="%" Style="{StaticResource StripHead}"/>
          </Border>
          <Border Background="Transparent" Style="{StaticResource Sheds}"
                  ToolTip="Melee and ranged attacks that connected, out of all attempted">
            <v:Caps Text="ACC%" Style="{StaticResource StripHead}"/>
          </Border>
        </v:Cells>
        <ItemsControl ItemsSource="{Binding Strip}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Height="{StaticResource HitRowHeight}" Margin="3,0,3,1" Background="Transparent" ToolTip="{Binding Tip}">
                <Rectangle Style="{StaticResource RowShade}" Fill="{Binding Fill}" RadiusX="{StaticResource BarRadius}"
                           RadiusY="{StaticResource BarRadius}" v:Grow.Share="{Binding Fraction}"/>
                <Rectangle Width="3" HorizontalAlignment="Left" RadiusX="1.5" RadiusY="1.5" Fill="{Binding Edge}"
                           IsHitTestVisible="False"/>
                <!-- Whose file this is: found without reading the names. -->
                <Path Data="M0,0 L3.5,3.5 L0,7 Z" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Left"
                      VerticalAlignment="Center" Margin="-3,0,0,0" IsHitTestVisible="False"
                      Visibility="{Binding IsOwner, Converter={StaticResource Visible}}"/>
                <v:Cells Style="{StaticResource Strip}">
                  <DockPanel LastChildFill="False" Margin="10,0,4,0">
                    <TextBlock x:Name="Name" Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Job}" Style="{StaticResource StripJob}"/>
                  </DockPanel>
                  <TextBlock Text="{Binding Damage}" Style="{StaticResource StripCell}" FontSize="12" FontWeight="SemiBold"/>
                  <v:SmallBar For="Character" Length="36" Inset="8" Value="{Binding Fraction}" Fill="{Binding Edge}">
                    <TextBlock Text="{Binding Share}" Style="{StaticResource StripCell}"/>
                  </v:SmallBar>
                  <TextBlock Text="{Binding Accuracy}" Style="{StaticResource StripCellSheds}"/>
                </v:Cells>
              </Grid>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsOwner}" Value="True">
                  <Setter TargetName="Name" Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- The docked form: not in a floating panel. -->
      <Grid Visibility="{Binding Path=(v:Float.On), RelativeSource={RelativeSource Self}, Converter={StaticResource Hidden}}">
        <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Label}" FontSize="12" Margin="0,18,0,8"
                   HorizontalAlignment="Center" VerticalAlignment="Top"
                   Visibility="{Binding HasActors, Converter={StaticResource Hidden}}"/>

        <!-- Sideways, the table scrolls only in a pane too narrow for its
             fourteen columns. -->
        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      v:WheelChain.On="True" Visibility="{Binding HasActors, Converter={StaticResource Visible}}">
          <Grid MinWidth="900" Width="{Binding ViewportWidth, ElementName=Scroller}">
            <Grid.Style>
              <Style TargetType="Grid">
                <Style.Triggers>
                  <!-- Room for the scroll bar a narrow pane brings: it is
                       drawn over the content, and would lie on the Party
                       line. -->
                  <DataTrigger Binding="{Binding ComputedHorizontalScrollBarVisibility, ElementName=Scroller}" Value="Visible">
                    <Setter Property="Margin" Value="0,0,0,12"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- The headings: the groups' names over their columns, then
                 one word per column. 14 units are kept clear at the right
                 of the headings, the rows' cells and the Party line: the
                 room the rows' scroll bar is drawn in. -->
            <Grid Height="{StaticResource GroupedHeadHeight}">
              <v:Cells Style="{StaticResource Groups}" Margin="0,0,14,1">
                <Border/>
                <ContentControl Template="{StaticResource Group}" Focusable="False">
                  <v:Caps Text="Weaponskill" Style="{StaticResource GroupCaps}"/>
                </ContentControl>
                <ContentControl Template="{StaticResource Group}" Focusable="False">
                  <v:Caps Text="Skillchain" Style="{StaticResource GroupCaps}"/>
                </ContentControl>
                <ContentControl Template="{StaticResource Group}" Focusable="False">
                  <v:Caps Text="Pet" Style="{StaticResource GroupCaps}"/>
                </ContentControl>
              </v:Cells>
              <v:Cells Style="{StaticResource Table}" Margin="0,16,14,1">
                <TextBlock Text="Character" Style="{StaticResource HeadText}" Padding="12,0,8,0"/>
                <TextBlock Text="Job" Style="{StaticResource HeadText}"
                           Visibility="{Binding ShowJob, Converter={StaticResource Visible}}"/>
                <TextBlock Text="Damage" Style="{StaticResource Head}" Padding="0,0,8,0"
                           ToolTip="Everything this character dealt: attacks, weaponskills, job abilities, magic, additional effects, counters and spikes, their pet, and the skillchains they closed while Include Skillchains is on"/>
                <TextBlock Text="Damage %" Style="{StaticResource Head}" Padding="0,0,8,0"
                           ToolTip="This character's damage out of the whole party's"/>
                <TextBlock Text="DPS" Style="{StaticResource Head}" Padding="0,0,8,0" ToolTip="Damage divided by the session clock"/>
                <TextBlock Text="Accuracy" Style="{StaticResource Head}" Padding="0,0,8,0"
                           ToolTip="Melee and ranged attacks that connected, out of all attempted. A swing taken by shadows counts as a hit and a Perfect Dodge is not counted. Weaponskills, job abilities and the pet are not included"/>
                <TextBlock Text="Damage" Style="{StaticResource Head}" Padding="0,0,8,0"
                           ToolTip="Total weaponskill damage. Skillchain damage is not part of it"/>
                <TextBlock Text="Avg" Style="{StaticResource Head}" Padding="0,0,8,0"
                           ToolTip="Average damage of the weaponskills that dealt damage"/>
                <TextBlock Text="%" Style="{StaticResource Head}" Padding="0,0,8,0"
                           ToolTip="Weaponskill damage out of this character's damage"/>
                <TextBlock Text="Acc" Style="{StaticResource Head}" Padding="0,0,8,0"
                           ToolTip="Weaponskills that dealt damage, out of all used"/>
                <TextBlock Text="Damage" Style="{StaticResource Head}" Padding="0,0,8,0"
                           ToolTip="Total damage of the skillchains this character closed. Empty while Include Skillchains is off"/>
                <TextBlock Text="%" Style="{StaticResource Head}" Padding="0,0,8,0"
                           ToolTip="Skillchain damage out of this character's damage"/>
                <TextBlock Text="Damage" Style="{StaticResource Head}" Padding="0,0,8,0"
                           ToolTip="Everything this character's pet dealt. Already part of Damage"/>
                <TextBlock Text="Acc" Style="{StaticResource Head}" Padding="0,0,8,0"
                           ToolTip="The pet's melee attacks that connected, out of all attempted"/>
              </v:Cells>
              <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource Line2Brush}" SnapsToDevicePixels="True"/>
            </Grid>

            <!-- The rows. Back to front: the shade, the rule, what the
                 row wears under the pointer, the owner's mark, the cells.
                 A rate that is low has its mark under it (v:LowMark); the
                 Damage % has a small bar beside it only while the row is
                 not shaded (v:SmallBar). -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          v:WheelChain.On="True" Focusable="False">
              <ItemsControl ItemsSource="{Binding Actors}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid x:Name="Row" Height="{StaticResource RowHeight}" Background="Transparent" ToolTip="{Binding Tip}">
                      <Rectangle Style="{StaticResource RowShade}" Margin="0,0,0,1" Fill="{Binding Shade}"
                                 v:Grow.Share="{Binding Fraction}"/>
                      <Rectangle Style="{StaticResource RowRule}"/>
                      <Border x:Name="Hover" Style="{StaticResource RowHover}"/>
                      <Path Style="{StaticResource OwnerMark}"
                            Visibility="{Binding IsOwner, Converter={StaticResource Visible}}"/>
                      <v:Cells Style="{StaticResource Table}" Margin="0,0,14,1">
                        <DockPanel Margin="12,0,8,0" VerticalAlignment="Center">
                          <Rectangle Style="{StaticResource Swatch}" Fill="{Binding Swatch}" Margin="0,0,6,0"/>
                          <TextBlock x:Name="Name" Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"
                                     VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Job}" Style="{StaticResource JobCell}" ToolTip="{Binding JobTip}"
                                   Visibility="{Binding ShowJob, Converter={StaticResource Visible}}"/>
                        <TextBlock Text="{Binding Damage}" Style="{StaticResource Cell}" FontWeight="SemiBold" Padding="2,0,8,0"/>
                        <v:SmallBar For="Character" Length="48" Value="{Binding Fraction}" Fill="{Binding Swatch}">
                          <TextBlock Text="{Binding Share}" Style="{StaticResource Cell}"/>
                        </v:SmallBar>
                        <TextBlock Text="{Binding Dps}" Style="{StaticResource Cell}" Padding="2,0,8,0"/>
                        <v:LowMark Rate="{Binding AccuracyRate}">
                          <TextBlock Text="{Binding Accuracy}" Style="{StaticResource Fig}"/>
                        </v:LowMark>
                        <TextBlock Text="{Binding WsDamage}" Style="{StaticResource Fig}" Padding="2,0,8,0"/>
                        <TextBlock Text="{Binding WsAvg}" Style="{StaticResource FigQuiet}"/>
                        <TextBlock Text="{Binding WsShare}" Style="{StaticResource FigQuiet}"/>
                        <v:LowMark Rate="{Binding WsAccuracyRate}">
                          <TextBlock Text="{Binding WsAccuracy}" Style="{StaticResource Fig}"/>
                        </v:LowMark>
                        <TextBlock Text="{Binding ScDamage}" Style="{StaticResource Fig}" Padding="2,0,8,0"/>
                        <TextBlock Text="{Binding ScShare}" Style="{StaticResource FigQuiet}"/>
                        <TextBlock Text="{Binding PetDamage}" Style="{StaticResource Fig}" Padding="2,0,8,0"/>
                        <v:LowMark Rate="{Binding PetAccuracyRate}">
                          <TextBlock Text="{Binding PetAccuracy}" Style="{StaticResource Fig}"/>
                        </v:LowMark>
                      </v:Cells>
                    </Grid>
                    <DataTemplate.Triggers>
                      <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                        <Setter TargetName="Hover" Property="Visibility" Value="Visible"/>
                      </Trigger>
                      <DataTrigger Binding="{Binding IsOwner}" Value="True">
                        <Setter TargetName="Name" Property="FontWeight" Value="SemiBold"/>
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <!-- The Party line: the party as a whole under the columns it
                 sums, on the raised surface, unshaded and unmarked, with
                 the groups' rules carried through it. It stands still under
                 the rows. Its DPS is the party's, rewritten with the rows'. -->
            <Grid Grid.Row="2" Height="{StaticResource PartyRowHeight}" Background="{DynamicResource Bg2Brush}">
              <Rectangle Height="1" VerticalAlignment="Top" Fill="{DynamicResource Line2Brush}" SnapsToDevicePixels="True"/>
              <v:Cells Style="{StaticResource Groups}" Margin="0,1,14,0">
                <Border/>
                <Border Style="{StaticResource PartyRule}"/>
                <Border Style="{StaticResource PartyRule}"/>
                <Border Style="{StaticResource PartyRule}"/>
              </v:Cells>
              <v:Cells Style="{StaticResource Table}" Margin="0,1,14,0">
                <TextBlock Text="Party" Style="{StaticResource CellText}" Padding="12,0,8,0" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Party.Count}" Style="{StaticResource CellText}" FontSize="11"
                           Foreground="{DynamicResource Text3Brush}" Background="Transparent"
                           ToolTip="The characters listed above"
                           Visibility="{Binding ShowJob, Converter={StaticResource Visible}}"/>
                <TextBlock Text="{Binding Party.Damage}" Style="{StaticResource Cell}" FontWeight="SemiBold" Padding="2,0,8,0"/>
                <TextBlock Text="{Binding Party.Share}" Style="{StaticResource Cell}" Foreground="{DynamicResource Text2Brush}"/>
                <TextBlock Text="{Binding Party.Dps}" Style="{StaticResource Cell}" FontWeight="SemiBold" Padding="2,0,8,0"/>
                <TextBlock Text="{Binding Party.Accuracy}" Style="{StaticResource SubFig}"/>
                <TextBlock Text="{Binding Party.WsDamage}" Style="{StaticResource SubFig}" Padding="2,0,8,0"/>
                <TextBlock Text="{Binding Party.WsAvg}" Style="{StaticResource SubFigQuiet}"/>
                <TextBlock Text="{Binding Party.WsShare}" Style="{StaticResource SubFigQuiet}"/>
                <TextBlock Text="{Binding Party.WsAccuracy}" Style="{StaticResource SubFig}"/>
                <TextBlock Text="{Binding Party.ScDamage}" Style="{StaticResource SubFig}" Padding="2,0,8,0"/>
                <TextBlock Text="{Binding Party.ScShare}" Style="{StaticResource SubFigQuiet}"/>
                <TextBlock Text="{Binding Party.PetDamage}" Style="{StaticResource SubFig}" Padding="2,0,8,0"/>
                <TextBlock Text="{Binding Party.PetAccuracy}" Style="{StaticResource SubFig}"/>
              </v:Cells>
            </Grid>
          </Grid>
        </ScrollViewer>
      </Grid>
    </Grid>
  </v:Pane>
</UserControl>
