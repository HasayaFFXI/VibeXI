<UserControl x:Class="Zerg.Views.BarsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:c="clr-namespace:Zerg.Charts"
             xmlns:v="clr-namespace:Zerg.Views">
  <UserControl.Resources>
    <!-- Character, Job, then twelve figures, each as wide as its heading
         needs. The heading and every row share it. -->
    <sys:String x:Key="Columns">1.6*,84,*,*,0.9*,*,1.15*,0.9*,0.8*,0.9*,1.15*,0.8*,1.15*,0.95*</sys:String>

    <!-- The strip: Character, then Damage, % and Acc%, each wide enough for
         its longest figure so one growing a digit moves nothing beside it. -->
    <sys:String x:Key="StripColumns">*,72,52,52</sys:String>
    <Style x:Key="StripHead" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Padding" Value="4,0"/>
      <Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource Text3Brush}"/>
    </Style>
    <Style x:Key="StripCell" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="4,0"/>
      <Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>
  </UserControl.Resources>

  <!-- Damage by character: a bar each, then the per-character table. Full
       width, because fourteen columns need it.

       Floating, it is a strip instead: one short row per character, the bar
       behind the name. The chart and the table list the same people twice,
       and for an alliance the pair would cover the game it is laid over. -->
  <Border Style="{StaticResource Card}">
    <StackPanel>
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource PopOut}" Command="{Binding Panels[bars].PopOutCommand}"
                AutomationProperties.Name="Pop out Damage by character"/>
        <StackPanel>
          <TextBlock Text="Damage by character" Style="{StaticResource CardTitle}"/>
          <TextBlock Text="Total dealt since the session started. Hover a column heading for how it is counted."
                     Style="{StaticResource CardNote}"/>
        </StackPanel>
      </DockPanel>

      <StackPanel Visibility="{Binding Path=(v:Float.On), RelativeSource={RelativeSource Self}, Converter={StaticResource Visible}}">
        <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Label}" FontSize="12" Margin="6,6,6,0"
                   Visibility="{Binding HasActors, Converter={StaticResource Hidden}}"/>
        <v:Cells Widths="{StaticResource StripColumns}" Height="16"
                 Visibility="{Binding HasActors, Converter={StaticResource Visible}}">
          <TextBlock Text="CHARACTER" Style="{StaticResource StripHead}" TextAlignment="Left" Padding="6,0,4,0"/>
          <TextBlock Text="DAMAGE" Style="{StaticResource StripHead}"/>
          <TextBlock Text="%" Style="{StaticResource StripHead}" ToolTip="This character's damage out of the whole party's"/>
          <TextBlock Text="ACC%" Style="{StaticResource StripHead}"
                     ToolTip="Melee and ranged attacks that connected, out of all attempted"/>
        </v:Cells>
        <ItemsControl ItemsSource="{Binding Strip}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Height="20" Margin="0,1,0,0" Background="Transparent" ToolTip="{Binding Tip}">
                <!-- The bar is a mark in the character's colour, like every
                     swatch and line, and not quite solid, so the text over it
                     keeps its own ink: job colours are not graded for text. -->
                <Rectangle Fill="{Binding Fill}" Opacity="0.7" RadiusX="2" RadiusY="2" RenderTransformOrigin="0,0.5"
                           v:Grow.Share="{Binding Fraction}"/>
                <!-- Whose file this is: found without reading the names. -->
                <Rectangle Width="2" HorizontalAlignment="Left" Fill="{DynamicResource AccentBrush}"
                           Visibility="{Binding IsOwner, Converter={StaticResource Visible}}"/>
                <!-- A dark halo keeps pale text legible on the brightest fills. -->
                <v:Cells Widths="{StaticResource StripColumns}">
                  <v:Cells.Effect>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="3" Color="Black" Opacity="0.75"/>
                  </v:Cells.Effect>
                  <DockPanel LastChildFill="False" Margin="6,0,4,0">
                    <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Job}" Style="{StaticResource Badge}"
                               Foreground="{DynamicResource Text2Brush}"/>
                  </DockPanel>
                  <TextBlock Text="{Binding Damage}" Style="{StaticResource StripCell}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Share}" Style="{StaticResource StripCell}"/>
                  <TextBlock Text="{Binding Accuracy}" Style="{StaticResource StripCell}"/>
                </v:Cells>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- The docked form: not in a floating panel. -->
      <StackPanel Visibility="{Binding Path=(v:Float.On), RelativeSource={RelativeSource Self}, Converter={StaticResource Hidden}}">
        <c:BarChart Margin="0,10,0,0" Rows="{Binding Bars}" Height="{Binding BarsHeight}"
                    EmptyText="{Binding EmptyText}" AutomationProperties.Name="Damage by character chart"/>

        <ScrollViewer x:Name="Scroller" Margin="0,8,0,0" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled" v:WheelChain.On="True"
                      Visibility="{Binding HasActors, Converter={StaticResource Visible}}">
          <!-- The bottom margin is room for the scroll bar a narrow window
               brings: it is drawn over the content, and would sit on the last row. -->
          <StackPanel MinWidth="1120" Width="{Binding ViewportWidth, ElementName=Scroller}" Margin="0,0,0,12">
            <v:Cells Widths="{StaticResource Columns}" Margin="0,0,0,6">
              <TextBlock Text="Character" Style="{StaticResource HeadText}"/>
              <TextBlock Text="Job" Style="{StaticResource HeadText}"
                         Visibility="{Binding ShowJob, Converter={StaticResource Visible}}"/>
              <TextBlock Text="Damage" Style="{StaticResource Head}"
                         ToolTip="Everything this character dealt: attacks, weaponskills, job abilities, magic, additional effects, counters and spikes, their pet, and the skillchains they closed while Include Skillchains is on"/>
              <TextBlock Text="Damage %" Style="{StaticResource Head}"
                         ToolTip="This character's damage out of the whole party's"/>
              <TextBlock Text="DPS" Style="{StaticResource Head}" ToolTip="Damage divided by the session clock"/>
              <TextBlock Text="Accuracy" Style="{StaticResource Head}"
                         ToolTip="Melee and ranged attacks that connected, out of all attempted. A swing taken by shadows counts as a hit and a Perfect Dodge is not counted. Weaponskills, job abilities and the pet are not included"/>
              <TextBlock Text="WS Damage" Style="{StaticResource Head}"
                         ToolTip="Total weaponskill damage. Skillchain damage is not part of it"/>
              <TextBlock Text="WS Avg" Style="{StaticResource Head}"
                         ToolTip="Average damage of the weaponskills that dealt damage"/>
              <TextBlock Text="WS %" Style="{StaticResource Head}"
                         ToolTip="Weaponskill damage out of this character's damage"/>
              <TextBlock Text="WS Acc" Style="{StaticResource Head}"
                         ToolTip="Weaponskills that dealt damage, out of all used"/>
              <TextBlock Text="SC Damage" Style="{StaticResource Head}"
                         ToolTip="Total damage of the skillchains this character closed. Empty while Include Skillchains is off"/>
              <TextBlock Text="SC %" Style="{StaticResource Head}"
                         ToolTip="Skillchain damage out of this character's damage"/>
              <TextBlock Text="Pet Damage" Style="{StaticResource Head}"
                         ToolTip="Everything this character's pet dealt. Already part of Damage"/>
              <TextBlock Text="Pet Acc" Style="{StaticResource Head}"
                         ToolTip="The pet's melee attacks that connected, out of all attempted"/>
            </v:Cells>

            <ItemsControl ItemsSource="{Binding Actors}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource RowLine}">
                    <v:Cells Widths="{StaticResource Columns}">
                      <DockPanel Margin="8,0" VerticalAlignment="Center">
                        <Rectangle Style="{StaticResource Swatch}" Fill="{Binding Swatch}" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                      </DockPanel>
                      <TextBlock Text="{Binding Job}" Style="{StaticResource CellText}" ToolTip="{Binding JobTip}"
                                 Background="Transparent" Foreground="{DynamicResource Text2Brush}"
                                 Visibility="{Binding ShowJob, Converter={StaticResource Visible}}"/>
                      <TextBlock Text="{Binding Damage}" Style="{StaticResource Cell}" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Share}" Style="{StaticResource Cell}"/>
                      <TextBlock Text="{Binding Dps}" Style="{StaticResource Cell}"/>
                      <TextBlock Text="{Binding Accuracy}" Style="{StaticResource Cell}"/>
                      <TextBlock Text="{Binding WsDamage}" Style="{StaticResource Cell}"/>
                      <TextBlock Text="{Binding WsAvg}" Style="{StaticResource Cell}"/>
                      <TextBlock Text="{Binding WsShare}" Style="{StaticResource Cell}"/>
                      <TextBlock Text="{Binding WsAccuracy}" Style="{StaticResource Cell}"/>
                      <TextBlock Text="{Binding ScDamage}" Style="{StaticResource Cell}"/>
                      <TextBlock Text="{Binding ScShare}" Style="{StaticResource Cell}"/>
                      <TextBlock Text="{Binding PetDamage}" Style="{StaticResource Cell}"/>
                      <TextBlock Text="{Binding PetAccuracy}" Style="{StaticResource Cell}"/>
                    </v:Cells>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
