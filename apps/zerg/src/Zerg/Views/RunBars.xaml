<UserControl x:Class="Zerg.Views.RunBars"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Self" Focusable="False" IsTabStop="False">
  <UserControl.Resources>
    <Style x:Key="Figure" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
      <!-- As wide as a seven-digit figure, whatever it holds: a bar's length
           is its share of what the figure leaves, and that has to be the
           same room in every row for the bars to be to one scale. -->
      <Setter Property="MinWidth" Value="58"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
      <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>
    <!-- Thin, square at the axis and rounded at the end that says how much. -->
    <Style x:Key="Bar" TargetType="Border">
      <Setter Property="Height" Value="9"/>
      <Setter Property="CornerRadius" Value="0,3,3,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </UserControl.Resources>

  <!-- Two bars in one cell, A above B, each followed by its figure. A bar's
       column is its share of the room the figure leaves, so the longest bar
       in the table ends where its figure begins and no figure is pushed out
       of the cell. The column widths are set in code. -->
  <Grid VerticalAlignment="Center" Margin="8,2">
    <Grid.RowDefinitions>
      <RowDefinition Height="14"/>
      <RowDefinition Height="14"/>
    </Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="BarA" Width="0*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition x:Name="RestA" Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource Bar}" Background="{DynamicResource RunABrush}"/>
      <TextBlock Grid.Column="1" Text="{Binding Value.TextA, ElementName=Self}" Style="{StaticResource Figure}"/>
    </Grid>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="BarB" Width="0*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition x:Name="RestB" Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource Bar}" Background="{DynamicResource RunBBrush}"/>
      <TextBlock Grid.Column="1" Text="{Binding Value.TextB, ElementName=Self}" Style="{StaticResource Figure}"/>
    </Grid>
  </Grid>
</UserControl>
