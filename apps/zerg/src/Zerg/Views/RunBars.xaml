<UserControl x:Class="Zerg.Views.RunBars"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Self" Focusable="False" IsTabStop="False">
  <UserControl.Resources>
    <Style x:Key="Figure" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
      <!-- As wide as a seven-digit figure, whatever it holds: a bar's length
           is its share of what the figure leaves, and that has to be the
           same room in every row for the bars to be to one scale. -->
      <Setter Property="MinWidth" Value="60"/>
      <Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="LineHeight" Value="14"/>
      <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
      <Style.Triggers>
        <Trigger Property="Text" Value="&#x2014;">
          <Setter Property="Foreground" Value="{DynamicResource Text4Brush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <!-- A small bar, as beside a share in the live tables: thin, square at
         the axis and rounded at the end that says how much. -->
    <Style x:Key="Bar" TargetType="Border">
      <Setter Property="Height" Value="6"/>
      <Setter Property="CornerRadius" Value="0,1.5,1.5,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </UserControl.Resources>

  <!-- Two small bars in one cell, A above B, each followed by its figure:
       what an amount's cell holds while "shade characters in their colour"
       is off, and the row is not itself shaded to the two amounts. A bar's
       column is its share of the room the figure leaves, so the longest
       bar in the table ends where its figure begins and no figure is
       pushed out of the cell. The column widths are set in code. The two
       lines are 14 units each, as a pair of figures' are. -->
  <Grid VerticalAlignment="Center" Margin="8,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="14"/>
      <RowDefinition Height="14"/>
    </Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="BarA" Width="0*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition x:Name="RestA" Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource Bar}" Background="{DynamicResource RunABrush}"/>
      <TextBlock Grid.Column="1" Text="{Binding Value.TextA, ElementName=Self}" Style="{StaticResource Figure}"/>
    </Grid>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="BarB" Width="0*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition x:Name="RestB" Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource Bar}" Background="{DynamicResource RunBBrush}"/>
      <TextBlock Grid.Column="1" Text="{Binding Value.TextB, ElementName=Self}" Style="{StaticResource Figure}"/>
    </Grid>
  </Grid>
</UserControl>
