<UserControl x:Class="Zerg.Views.CompareSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Zerg.Views"
             x:Name="Section">
  <!-- The Compare section's bands: what to compare about the two runs, the
       two slots, and, once both hold a parse, six figures. They are one of
       the things that stand above a section's panes in the main window's
       page, as the band of figures and the characters' line do over the
       live sections: still in a window wide enough for the panes to fill
       what is left, scrolling with the page in a narrow one. The panes
       themselves are Views/ComparePanes. The data context of both is the
       CompareViewModel. -->
  <UserControl.Resources>

    <!-- A line of small print that is not there when it has nothing to say. -->
    <Style x:Key="Quiet" TargetType="TextBlock" BasedOn="{StaticResource Label}">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Style.Triggers>
        <Trigger Property="Text" Value="">
          <Setter Property="Visibility" Value="Collapsed"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- A slot's three buttons, and the section's Swap: quiet until pointed at. -->
    <Style x:Key="SlotButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
      <Setter Property="Height" Value="22"/>
      <Setter Property="Padding" Value="9,0"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Margin" Value="7,0,0,0"/>
    </Style>

    <!-- A fact about the parse in a slot: what it is, then its value. -->
    <Style x:Key="Fact" TargetType="TextBlock" BasedOn="{StaticResource Label}">
      <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>
    <Style x:Key="FactValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Margin" Value="0,0,18,0"/>
      <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>

    <!-- A slot: a parse, or the place to put one. One line of what it is
         with its buttons, and one of facts. -->
    <DataTemplate x:Key="Slot">
      <Grid MinHeight="54" Background="Transparent" AllowDrop="True" DragEnter="OnSlotDrag" DragOver="OnSlotDrag"
            DragLeave="OnSlotLeave" Drop="OnSlotDrop">
        <!-- Dashed while it is empty: an outline of where a parse goes.
             Whole and amber while a file is held over it. -->
        <Rectangle RadiusX="5" RadiusY="5" SnapsToDevicePixels="True">
          <Rectangle.Style>
            <Style TargetType="Rectangle">
              <Setter Property="StrokeThickness" Value="1"/>
              <Setter Property="Stroke" Value="{DynamicResource Line2Brush}"/>
              <Setter Property="Fill" Value="{DynamicResource Bg2Brush}"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                  <Setter Property="StrokeDashArray" Value="4 3"/>
                  <Setter Property="Stroke" Value="{DynamicResource Line3Brush}"/>
                  <Setter Property="Fill" Value="Transparent"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOver}" Value="True">
                  <Setter Property="StrokeDashArray" Value="{x:Null}"/>
                  <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                  <Setter Property="StrokeThickness" Value="2"/>
                  <Setter Property="Fill" Value="{DynamicResource DropZoneFillBrush}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Rectangle.Style>
        </Rectangle>
        <!-- The run's colour down the edge, as on everything else of that run. -->
        <Border Width="3" HorizontalAlignment="Left" CornerRadius="1.5" Margin="1" SnapsToDevicePixels="True">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Background" Value="{DynamicResource RunBBrush}"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsA}" Value="True">
                  <Setter Property="Background" Value="{DynamicResource RunABrush}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
        </Border>

        <StackPanel Margin="14,8,10,6">
          <DockPanel Height="22">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Style="{StaticResource SlotButton}" Content="{Binding OpenText}" Command="{Binding OpenCommand}"
                      ToolTip="{Binding OpenTip}"
                      AutomationProperties.Name="{Binding Letter, StringFormat='Open a parse into {0}'}"/>
              <Button Style="{StaticResource SlotButton}" Content="Use current" Command="{Binding UseCurrentCommand}"
                      ToolTip="{Binding Owner.UseCurrentTip}" ToolTipService.ShowOnDisabled="True"
                      AutomationProperties.Name="{Binding Letter, StringFormat='Use current for {0}'}"/>
              <Button Style="{StaticResource SlotButton}" Content="Clear" Command="{Binding ClearCommand}"
                      ToolTip="Empty this slot"
                      Visibility="{Binding IsLoaded, Converter={StaticResource Visible}}"
                      AutomationProperties.Name="{Binding Letter, StringFormat='Clear {0}'}"/>
            </StackPanel>
            <Control DockPanel.Dock="Left">
              <Control.Style>
                <Style TargetType="Control" BasedOn="{StaticResource RunTag}">
                  <Setter Property="Template" Value="{StaticResource RunTagB}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsA}" Value="True">
                      <Setter Property="Template" Value="{StaticResource RunTagA}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Control.Style>
            </Control>
            <v:Caps DockPanel.Dock="Left" Text="{Binding Role}" Style="{StaticResource Caps}" Margin="8,0,0,0"/>
            <TextBlock Text="{Binding Name}" ToolTip="{Binding Tip}" Style="{StaticResource SlotTitle}" Margin="12,0,6,0"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Background="Transparent"
                       Visibility="{Binding IsLoaded, Converter={StaticResource Visible}}"/>
          </DockPanel>

          <TextBlock Text="Drop an exported parse here, or open one" Style="{StaticResource Label}" FontSize="11.5"
                     Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                     Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}"/>

          <StackPanel Visibility="{Binding IsLoaded, Converter={StaticResource Visible}}">
            <WrapPanel Margin="0,2,0,0">
              <TextBlock Text="Started" Style="{StaticResource Fact}"/>
              <TextBlock Text="{Binding Started}" Style="{StaticResource FactValue}"/>
              <TextBlock Text="Length" Style="{StaticResource Fact}"/>
              <TextBlock Text="{Binding Length}" Style="{StaticResource FactValue}"/>
              <TextBlock Text="Party" Style="{StaticResource Fact}"/>
              <TextBlock Text="{Binding Party}" Style="{StaticResource FactValue}"/>
            </WrapPanel>
            <!-- What of the file was not understood, when anything was not. -->
            <TextBlock Text="{Binding Skipped}" Style="{StaticResource Quiet}" Margin="0,4,0,0"/>
          </StackPanel>

          <!-- Why the last file would not load. It stays on the slot it was meant for. -->
          <TextBlock Text="{Binding Error}" Style="{StaticResource Quiet}" Margin="0,5,0,1"
                     Foreground="{DynamicResource CritBrush}" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
      </Grid>
    </DataTemplate>

    <!-- A figure's cell is known to a script by what the figure is of. -->
    <Style x:Key="ByLabel" TargetType="ContentPresenter">
      <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
    </Style>

  </UserControl.Resources>

  <!-- On the pane surface, each band ruled off from the next. 172 units
       in all while the slots stand side by side and say nothing more than
       their facts: 38 to the slots, 54 of slot, 8 and a rule, then a band
       of figures 72 tall with its two rules. -->
  <StackPanel x:Name="Bands" Background="{DynamicResource Bg1Brush}">

    <!-- What the section is, and what to compare about the two runs: one
         line while the two slots stand side by side. Narrower, the
         switches take a line of their own and wrap. -->
    <Grid Margin="14,7,12,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition MinHeight="24"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <DockPanel VerticalAlignment="Center">
        <TextBlock DockPanel.Dock="Left" Text="Compare runs" Style="{StaticResource PaneTitle}" VerticalAlignment="Center"/>
        <TextBlock Text="Open or drop two exported parses. A is the baseline: every difference reads B against A."
                   ToolTip="Open or drop two exported parses. A is the baseline: every difference reads B against A."
                   Style="{StaticResource Label}" Margin="12,0,16,0" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" Background="Transparent"/>
      </DockPanel>
      <WrapPanel>
        <WrapPanel.Style>
          <Style TargetType="WrapPanel">
            <Setter Property="Grid.Column" Value="1"/>
            <Setter Property="Margin" Value="0,0,-10,-4"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding PairColumns, ElementName=Section}" Value="1">
                <Setter Property="Grid.Column" Value="0"/>
                <Setter Property="Grid.ColumnSpan" Value="2"/>
                <Setter Property="Grid.Row" Value="1"/>
                <Setter Property="Margin" Value="0,6,-10,-4"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </WrapPanel.Style>
        <StackPanel Orientation="Horizontal" Margin="0,0,16,4"
                    ToolTip="Compare the damage of the two runs, or their healing">
          <TextBlock Text="Show" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <Border Style="{StaticResource SegmentGroup}">
            <StackPanel Orientation="Horizontal">
              <RadioButton Style="{StaticResource Segment}" GroupName="compareMode" Content="Damage"
                           IsChecked="{Binding Mode, Converter={StaticResource Equals}, ConverterParameter=Damage}"
                           AutomationProperties.Name="Compare damage"/>
              <RadioButton Style="{StaticResource Segment}" GroupName="compareMode" Content="Healing"
                           IsChecked="{Binding Mode, Converter={StaticResource Equals}, ConverterParameter=Healing}"
                           AutomationProperties.Name="Compare healing"/>
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
          <TextBlock Text="Compare by" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <Border Style="{StaticResource SegmentGroup}">
            <StackPanel Orientation="Horizontal">
              <RadioButton Style="{StaticResource Segment}" GroupName="compareBy" Content="Character"
                           IsChecked="{Binding By, Converter={StaticResource Equals}, ConverterParameter=Character}"
                           ToolTip="One row per character, matched by name across the two runs"
                           AutomationProperties.Name="Compare by character"/>
              <RadioButton Style="{StaticResource Segment}" GroupName="compareBy" Content="Job"
                           IsChecked="{Binding By, Converter={StaticResource Equals}, ConverterParameter=Job}"
                           ToolTip="One row per main job, every character on it combined: for runs with a different roster"
                           AutomationProperties.Name="Compare by job"/>
            </StackPanel>
          </Border>
        </StackPanel>
        <!-- The one setting the live sections have, shown here because it
             changes these figures too. Not while healing is compared: it
             moves no healing figure. -->
        <ToggleButton Content="Include Skillchains" IsChecked="{Binding Skillchains}" ToolTip="{Binding SkillchainsTip}"
                      VerticalAlignment="Center" Margin="0,0,10,4"
                      Visibility="{Binding IsDamage, Converter={StaticResource Visible}}"/>
        <Button Style="{StaticResource GhostButton}" Height="24" Padding="10,0" FontSize="11.5"
                Content="Swap A &#x2194; B" Command="{Binding SwapCommand}" ToolTip="Make B the baseline"
                ToolTipService.ShowOnDisabled="True" VerticalAlignment="Center" Margin="0,0,10,4"
                AutomationProperties.Name="Swap A and B"/>
      </WrapPanel>
    </Grid>

    <!-- The two slots, side by side; one over the other in a narrow
         window. Each is as tall as what it has to say: an error adds a line. -->
    <UniformGrid Columns="{Binding PairColumns, ElementName=Section}" Margin="7,2,7,3">
      <ContentControl Content="{Binding A}" ContentTemplate="{StaticResource Slot}" Focusable="False" Margin="5"
                      VerticalAlignment="Top"/>
      <ContentControl Content="{Binding B}" ContentTemplate="{StaticResource Slot}" Focusable="False" Margin="5"
                      VerticalAlignment="Top"/>
    </UniformGrid>
    <Rectangle Height="1" Fill="{DynamicResource Line2Brush}" SnapsToDevicePixels="True"/>

    <!-- Six figures, each A over B with its run's badge, and at the
         cell's right the change in its tone over the plain difference.
         Everything from here down needs both runs. -->
    <ItemsControl ItemsSource="{Binding Tiles}" Focusable="False" ItemContainerStyle="{StaticResource ByLabel}"
                  Visibility="{Binding Ready, Converter={StaticResource Visible}}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <v:FigureBand Six="True" RowHeight="70" Rule="{DynamicResource Line2Brush}"/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Grid Margin="14,0,14,0" Background="Transparent" ToolTip="{Binding Tip}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="23"/>
              <RowDefinition Height="21"/>
              <RowDefinition Height="21"/>
              <RowDefinition/>
            </Grid.RowDefinitions>
            <v:Caps Grid.ColumnSpan="3" Text="{Binding Label}" Style="{StaticResource Caps}" HorizontalAlignment="Left"
                    VerticalAlignment="Bottom" Margin="0,0,0,4"/>
            <Control Grid.Row="1" Style="{StaticResource RunTagSmall}" Template="{StaticResource RunTagA}" Margin="0,0,7,0"/>
            <DockPanel Grid.Row="1" Grid.Column="1">
              <TextBlock DockPanel.Dock="Left" Text="{Binding A}" Style="{StaticResource TileFigure}"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding SubA, TargetNullValue=''}" Style="{StaticResource Quiet}" FontSize="10"
                         TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                         Margin="9,2,8,0" Typography.NumeralAlignment="Tabular"/>
            </DockPanel>
            <Control Grid.Row="2" Style="{StaticResource RunTagSmall}" Template="{StaticResource RunTagB}" Margin="0,0,7,0"/>
            <DockPanel Grid.Row="2" Grid.Column="1">
              <TextBlock DockPanel.Dock="Left" Text="{Binding B}" Style="{StaticResource TileFigure}"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding SubB, TargetNullValue=''}" Style="{StaticResource Quiet}" FontSize="10"
                         TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                         Margin="9,2,8,0" Typography.NumeralAlignment="Tabular"/>
            </DockPanel>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Change.Main}" Style="{StaticResource Tone}"
                       FontSize="13"/>
            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Change.Sub}" FontSize="10.5" TextAlignment="Right"
                       VerticalAlignment="Center" Foreground="{DynamicResource Text3Brush}"
                       Typography.NumeralAlignment="Tabular"/>
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Rectangle Height="1" Fill="{DynamicResource Line2Brush}" SnapsToDevicePixels="True"
               Visibility="{Binding Ready, Converter={StaticResource Visible}}"/>
  </StackPanel>
</UserControl>
