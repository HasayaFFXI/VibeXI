<UserControl x:Class="Zerg.Views.HealBarsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:c="clr-namespace:Zerg.Charts"
             xmlns:v="clr-namespace:Zerg.Views">
  <UserControl.Resources>
    <!-- Character, Job, then six figures. The heading and every row share it. -->
    <sys:String x:Key="Columns">1.6*,84,*,*,*,*,*,*</sys:String>

    <!-- The strip: Character, then Healing, % and Casts, each wide enough for
         its longest figure so one growing a digit moves nothing beside it. -->
    <sys:String x:Key="StripColumns">*,72,52,52</sys:String>
    <Style x:Key="StripHead" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Padding" Value="4,0"/>
      <Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
    </Style>
    <Style x:Key="StripCell" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="4,0"/>
      <Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>
  </UserControl.Resources>

  <!-- Healing by character: a bar each, then the per-character table.

       Floating, it is a strip, as the damage card is: one short row per
       character, the bar behind the name, and the three figures a glance
       during a fight is for. -->
  <Border Style="{StaticResource Card}">
    <StackPanel>
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource PopOut}" Command="{Binding Panels[hbars].PopOutCommand}"
                AutomationProperties.Name="Pop out Healing by character"/>
        <StackPanel>
          <TextBlock Text="Healing by character" Style="{StaticResource CardTitle}"/>
          <TextBlock Text="Total healed since the session started. Hover a column heading for how it is counted."
                     Style="{StaticResource CardNote}"/>
        </StackPanel>
      </DockPanel>

      <StackPanel Visibility="{Binding Path=(v:Float.On), RelativeSource={RelativeSource Self}, Converter={StaticResource Visible}}">
        <TextBlock Text="{Binding HealEmptyText}" Style="{StaticResource Label}" FontSize="13" Margin="6,6,6,0"
                   Visibility="{Binding HasHealers, Converter={StaticResource Hidden}}"/>
        <v:Cells Widths="{StaticResource StripColumns}" Height="16"
                 Visibility="{Binding HasHealers, Converter={StaticResource Visible}}">
          <TextBlock Text="CHARACTER" Style="{StaticResource StripHead}" TextAlignment="Left" Padding="6,0,4,0"/>
          <TextBlock Text="HEALING" Style="{StaticResource StripHead}"/>
          <TextBlock Text="%" Style="{StaticResource StripHead}" ToolTip="This character's healing out of the whole party's"/>
          <TextBlock Text="CASTS" Style="{StaticResource StripHead}" ToolTip="One per cast, however many people it reached"/>
        </v:Cells>
        <ItemsControl ItemsSource="{Binding HealStrip}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Height="20" Margin="0,1,0,0" Background="Transparent" ToolTip="{Binding Tip}">
                <Rectangle Fill="{Binding Fill}" Opacity="0.7" RadiusX="2" RadiusY="2" RenderTransformOrigin="0,0.5"
                           v:Grow.Share="{Binding Fraction}"/>
                <!-- Whose file this is: found without reading the names. -->
                <Rectangle Width="2" HorizontalAlignment="Left" Fill="{DynamicResource AccentFillColorDefaultBrush}"
                           Visibility="{Binding IsOwner, Converter={StaticResource Visible}}"/>
                <!-- A dark halo keeps pale text legible on the brightest fills. -->
                <v:Cells Widths="{StaticResource StripColumns}">
                  <v:Cells.Effect>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="3" Color="Black" Opacity="0.75"/>
                  </v:Cells.Effect>
                  <DockPanel LastChildFill="False" Margin="6,0,4,0">
                    <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Job}" Style="{StaticResource Badge}" FontSize="10.5"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                  </DockPanel>
                  <TextBlock Text="{Binding Healing}" Style="{StaticResource StripCell}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Share}" Style="{StaticResource StripCell}"/>
                  <TextBlock Text="{Binding Casts}" Style="{StaticResource StripCell}"/>
                </v:Cells>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- The docked form: not in a floating panel. -->
      <StackPanel Visibility="{Binding Path=(v:Float.On), RelativeSource={RelativeSource Self}, Converter={StaticResource Hidden}}">
        <c:BarChart Margin="0,10,0,0" Rows="{Binding HealBars}" Height="{Binding HealBarsHeight}"
                    EmptyText="{Binding HealEmptyText}" AutomationProperties.Name="Healing by character chart"/>

        <ScrollViewer x:Name="Scroller" Margin="0,8,0,0" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled" v:WheelChain.On="True"
                      Visibility="{Binding HasHealers, Converter={StaticResource Visible}}">
          <!-- The bottom margin is room for the scroll bar a narrow window
               brings: it is drawn over the content, and would sit on the last row. -->
          <StackPanel MinWidth="720" Width="{Binding ViewportWidth, ElementName=Scroller}" Margin="0,0,0,12">
            <v:Cells Widths="{StaticResource Columns}" Margin="0,0,0,6">
              <TextBlock Text="Character" Style="{StaticResource HeadText}"/>
              <TextBlock Text="Job" Style="{StaticResource HeadText}"
                         Visibility="{Binding ShowJob, Converter={StaticResource Visible}}"/>
              <TextBlock Text="Healing" Style="{StaticResource Head}"
                         ToolTip="Every cure, waltz and healing ability this character used. Pet heals are not included"/>
              <TextBlock Text="Healing %" Style="{StaticResource Head}"
                         ToolTip="This character's healing out of the whole party's"/>
              <TextBlock Text="HPS" Style="{StaticResource Head}" ToolTip="Healing divided by the session clock"/>
              <TextBlock Text="Casts" Style="{StaticResource Head}"
                         ToolTip="One per cast, however many people it reached"/>
              <TextBlock Text="Avg / cast" Style="{StaticResource Head}" ToolTip="Healing divided by casts"/>
              <TextBlock Text="Pet Healing" Style="{StaticResource Head}"
                         ToolTip="Everything this character's pet healed. Not part of Healing"/>
            </v:Cells>

            <ItemsControl ItemsSource="{Binding Healers}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource RowLine}">
                    <v:Cells Widths="{StaticResource Columns}">
                      <DockPanel Margin="8,0" VerticalAlignment="Center">
                        <Rectangle Style="{StaticResource Swatch}" Fill="{Binding Swatch}" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                      </DockPanel>
                      <TextBlock Text="{Binding Job}" Style="{StaticResource CellText}" ToolTip="{Binding JobTip}"
                                 Background="Transparent" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                 Visibility="{Binding ShowJob, Converter={StaticResource Visible}}"/>
                      <TextBlock Text="{Binding Healing}" Style="{StaticResource Cell}" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Share}" Style="{StaticResource Cell}"/>
                      <TextBlock Text="{Binding Hps}" Style="{StaticResource Cell}"/>
                      <TextBlock Text="{Binding Casts}" Style="{StaticResource Cell}"/>
                      <TextBlock Text="{Binding Avg}" Style="{StaticResource Cell}"/>
                      <TextBlock Text="{Binding PetHealing}" Style="{StaticResource Cell}"/>
                    </v:Cells>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
