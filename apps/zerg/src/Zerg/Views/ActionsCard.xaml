<UserControl x:Class="Zerg.Views.ActionsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:v="clr-namespace:Zerg.Views">
  <UserControl.Resources>
    <sys:String x:Key="Columns">2.4*,*,*,*,*,*,*,*</sys:String>

    <!-- A character's heading: who, and what they dealt in all. Picking it
         shows their actions under it; picking it again puts them away. -->
    <DataTemplate x:Key="Heading">
      <Border Style="{StaticResource RowLine}" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
        <Button Style="{StaticResource RowButton}"
                Command="{Binding DataContext.ToggleActionsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                CommandParameter="{Binding}" AutomationProperties.Name="{Binding Label}"
                ToolTip="Show or hide this character's actions">
          <StackPanel Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Caret}" Width="14" FontSize="10" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Rectangle Margin="0,0,8,0">
              <Rectangle.Style>
                <Style TargetType="Rectangle" BasedOn="{StaticResource Swatch}">
                  <Setter Property="Fill" Value="{Binding Swatch}"/>
                  <Style.Triggers>
                    <Trigger Property="v:Float.On" Value="True">
                      <Setter Property="Fill" Value="{Binding PanelSwatch}"/>
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </Rectangle.Style>
            </Rectangle>
            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Job}" Style="{StaticResource Badge}"/>
            <TextBlock Text="—" FontSize="13" Margin="8,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
            <TextBlock Text="{Binding Total}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                       Typography.NumeralAlignment="Tabular"/>
          </StackPanel>
        </Button>
      </Border>
    </DataTemplate>

    <!-- One action. Picking it opens the drill-down; picking it again closes it. -->
    <DataTemplate x:Key="Action">
      <Button Command="{Binding DataContext.DrillCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
              CommandParameter="{Binding}" AutomationProperties.Name="{Binding Label}" ToolTip="Show every hit">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource RowButton}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding Selected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
        <Grid>
          <Border Width="3" CornerRadius="1.5" HorizontalAlignment="Left" Margin="0,5"
                  Background="{DynamicResource AccentFillColorDefaultBrush}"
                  Visibility="{Binding Selected, Converter={StaticResource Visible}}"/>
          <v:Cells Widths="{StaticResource Columns}">
            <TextBlock Text="{Binding Name}" Style="{StaticResource CellText}" Padding="40,0,8,0"/>
            <TextBlock Text="{Binding Hits}" Style="{StaticResource Cell}"/>
            <TextBlock Text="{Binding Misses}" Style="{StaticResource Cell}"/>
            <TextBlock Text="{Binding Total}" Style="{StaticResource Cell}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Avg}" Style="{StaticResource Cell}"/>
            <TextBlock Text="{Binding Min}" Style="{StaticResource Cell}"/>
            <TextBlock Text="{Binding Max}" Style="{StaticResource Cell}"/>
            <TextBlock Text="{Binding Share}" Style="{StaticResource Cell}"/>
          </v:Cells>
        </Grid>
      </Button>
    </DataTemplate>

    <v:ActionRowTemplates x:Key="Templates" Heading="{StaticResource Heading}" Action="{StaticResource Action}"/>
  </UserControl.Resources>

  <!-- Every attack and weaponskill, under the character who used it, once
       that character's heading is opened. In a floating panel the list takes
       the panel's height. -->
  <Border Style="{StaticResource Card}">
    <DockPanel>
      <DockPanel DockPanel.Dock="Top">
        <Button DockPanel.Dock="Right" Style="{StaticResource PopOut}" Command="{Binding Panels[actions].PopOutCommand}"
                AutomationProperties.Name="Pop out Actions"/>
        <StackPanel>
          <TextBlock Text="Actions" Style="{StaticResource CardTitle}"/>
          <!-- The gap above the table goes with the note when a panel drops it. -->
          <TextBlock Text="Every attack and weaponskill. Select a character to show theirs, and an action to drill down."
                     Style="{StaticResource CardNote}"
                     Margin="0,2,0,10"/>
        </StackPanel>
      </DockPanel>

      <TextBlock DockPanel.Dock="Top" Text="{Binding EmptyText}" Style="{StaticResource Label}" FontSize="13"
                 Margin="0,18,0,8" HorizontalAlignment="Center"
                 Visibility="{Binding HasActions, Converter={StaticResource Hidden}}"/>

      <ScrollViewer x:Name="Sideways" HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled" v:WheelChain.On="True"
                    Visibility="{Binding HasActions, Converter={StaticResource Visible}}">
        <Grid MinWidth="620" Width="{Binding ViewportWidth, ElementName=Sideways}" Margin="0,0,0,12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <!-- The right margin, here and on the rows, keeps the last column
               out from under the list's scroll bar. -->
          <v:Cells Widths="{StaticResource Columns}" Margin="0,0,14,6">
            <TextBlock Text="Action" Style="{StaticResource HeadText}"/>
            <TextBlock Text="Hits" Style="{StaticResource Head}" ToolTip="Uses that dealt damage"/>
            <TextBlock Text="Miss" Style="{StaticResource Head}"
                       ToolTip="Uses that dealt none. A swing taken by shadows is a miss here, though it counts as a hit in Accuracy"/>
            <TextBlock Text="Total" Style="{StaticResource Head}"/>
            <TextBlock Text="Avg" Style="{StaticResource Head}"/>
            <TextBlock Text="Min" Style="{StaticResource Head}"/>
            <TextBlock Text="Max" Style="{StaticResource Head}"/>
            <TextBlock Text="Share" Style="{StaticResource Head}" ToolTip="Out of this character's damage"/>
          </v:Cells>
          <!-- The rows scroll under their headings. Docked, the list is as
               tall as it needs, up to a cap; floating, as tall as the panel. -->
          <Grid Grid.Row="1">
            <Grid.Style>
              <Style TargetType="Grid">
                <Setter Property="MaxHeight" Value="340"/>
                <Style.Triggers>
                  <Trigger Property="v:Float.On" Value="True">
                    <Setter Property="MaxHeight" Value="Infinity"/>
                  </Trigger>
                </Style.Triggers>
              </Style>
            </Grid.Style>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          v:WheelChain.On="True">
              <ItemsControl ItemsSource="{Binding Actions}" ItemTemplateSelector="{StaticResource Templates}"
                            Focusable="False" Margin="0,0,14,0"/>
            </ScrollViewer>
          </Grid>
        </Grid>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
