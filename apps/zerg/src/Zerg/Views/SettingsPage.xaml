<UserControl x:Class="Zerg.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>

    <!-- A line of small print that is not there when it has nothing to say. -->
    <Style x:Key="Quiet" TargetType="TextBlock" BasedOn="{StaticResource Label}">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Style.Triggers>
        <Trigger Property="Text" Value="">
          <Setter Property="Visibility" Value="Collapsed"/>
        </Trigger>
      </Style.Triggers>
    </Style>

  </UserControl.Resources>

  <!-- Capped and to the left: four short cards stretched across a wide
       window would put each button a long way from what it changes. -->
  <StackPanel MaxWidth="860" HorizontalAlignment="Left">

    <DockPanel Margin="0,0,0,10">
      <Button DockPanel.Dock="Right" Content="Done" Command="{Binding CloseSettingsCommand}" VerticalAlignment="Center"
              ToolTip="Back to the section this was opened over" AutomationProperties.Name="Close settings"/>
      <TextBlock Text="Settings" FontFamily="{StaticResource NumberFont}" FontSize="22" FontWeight="SemiBold"
                 VerticalAlignment="Center"/>
    </DockPanel>

    <!-- Where the event files are. -->
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="Events folder" Style="{StaticResource CardTitle}"/>
        <TextBlock Text="Where Zerg looks for the event files (.jsonl) the VibeXI addon writes. It follows the newest one in the folder. Change this only if the addon writes somewhere else."
                   Style="{StaticResource CardNote}"/>
        <DockPanel Margin="0,12,0,0">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="Browse…" Command="{Binding BrowseFolderCommand}" Margin="8,0,0,0"
                    ToolTip="Choose another folder" AutomationProperties.Name="Choose the events folder"/>
            <Button Content="Use default" Command="{Binding DefaultFolderCommand}" Margin="6,0,0,0"
                    ToolTip="Back to the folder VibeXI writes to unless it is told otherwise"
                    ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Use the default events folder"/>
          </StackPanel>
          <!-- Read only, and a box all the same: a long path scrolls in it,
               and it can be selected and copied. -->
          <TextBox Text="{Binding EventsFolder, Mode=OneWay}" IsReadOnly="True" VerticalAlignment="Center"
                   AutomationProperties.Name="Events folder"/>
        </DockPanel>
        <TextBlock Text="{Binding EventsFolderNote}" Style="{StaticResource Quiet}" Margin="0,8,0,0"/>
        <TextBlock Text="{Binding EventsFolderSource}" Style="{StaticResource Quiet}" Margin="0,4,0,0"/>
      </StackPanel>
    </Border>

    <!-- The keys that switch click-through. -->
    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
      <StackPanel>
        <TextBlock Text="Click-through hot key" Style="{StaticResource CardTitle}"/>
        <TextBlock Text="The keys that switch every floating panel between click-through and clickable, from any application, the game included. Click the keys below, then press the new ones: Ctrl, Alt or Win held with a letter, a digit or F1 to F24."
                   Style="{StaticResource CardNote}"/>
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
          <!-- Shows the keys, and takes new ones: pressed, it reads the next
               chord off the keyboard. Esc, or the keyboard going elsewhere,
               leaves the keys as they were. -->
          <Button x:Name="Keys" Content="{Binding HotKeyFace}" MinWidth="190" Click="OnKeys" PreviewKeyDown="OnKey"
                  LostKeyboardFocus="OnKeysLeft" ToolTip="Click, then press the new keys. Esc cancels."
                  AutomationProperties.Name="Change the click-through hot key"
                  AutomationProperties.HelpText="{Binding HotKeyFace}">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Recording}" Value="True">
                    <Setter Property="FontWeight" Value="Normal"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <Button Content="Use default" Command="{Binding DefaultHotKeyCommand}" Margin="6,0,0,0"
                  ToolTip="Back to Ctrl+Alt+Z" AutomationProperties.Name="Use the default hot key"/>
        </StackPanel>
        <!-- What to press while it waits; why the keys pressed were not
             taken, or why the ones shown do nothing. -->
        <TextBlock Text="{Binding HotKeyNote}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource Quiet}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding HotKeyNoteBad}" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </StackPanel>
    </Border>

    <!-- What a pop-out is until its own slider says otherwise. A slider, as
         on a pop-out's bar: the same thing is set the same way in both. -->
    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
      <StackPanel>
        <TextBlock Text="Default pop-out opacity" Style="{StaticResource CardTitle}"/>
        <TextBlock Text="How solid the dark backdrop of a pop-out is; its text and bars stay solid. Every pop-out follows this until the slider on its own bar is moved. From then on that pop-out keeps its own opacity, whatever is set here."
                   Style="{StaticResource CardNote}"/>
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
          <Slider Width="240" Minimum="15" Maximum="100" SmallChange="1" LargeChange="10" VerticalAlignment="Center"
                  IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding Panels.DefaultOpacity}"
                  AutomationProperties.Name="Default pop-out opacity"/>
          <TextBlock Text="{Binding Panels.DefaultOpacity, StringFormat={}{0}%}" Style="{StaticResource Label}"
                     VerticalAlignment="Center" MinWidth="40" TextAlignment="Right"
                     Typography.NumeralAlignment="Tabular"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Moved here from the command bar: set once and left alone. -->
    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
      <StackPanel>
        <TextBlock Text="Theme" Style="{StaticResource CardTitle}"/>
        <TextBlock Text="Light, dark, or whatever Windows is set to." Style="{StaticResource CardNote}"/>
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
          <RadioButton Style="{StaticResource Segment}" GroupName="theme"
                       IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=Light}"
                       AutomationProperties.Name="Light theme">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE706;" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <TextBlock Text="Light"/>
            </StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource Segment}" GroupName="theme"
                       IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=Dark}"
                       AutomationProperties.Name="Dark theme">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE708;" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <TextBlock Text="Dark"/>
            </StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource Segment}" GroupName="theme" Margin="0"
                       IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=System}"
                       AutomationProperties.Name="System theme">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7F4;" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <TextBlock Text="System"/>
            </StackPanel>
          </RadioButton>
        </StackPanel>
      </StackPanel>
    </Border>

  </StackPanel>
</UserControl>
