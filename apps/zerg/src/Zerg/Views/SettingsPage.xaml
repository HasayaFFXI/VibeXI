<UserControl x:Class="Zerg.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Zerg.Views"
             Background="{DynamicResource Bg1Brush}" PreviewKeyDown="OnPageKey">
  <UserControl.Resources>

    <v:ChordKeysConverter x:Key="ChordKeys"/>
    <v:PercentConverter x:Key="Percent"/>

    <!-- One setting: a ruled row, set in 24 units from the page's edges
         as its rule is. In it a v:SettingRow: what the setting is called
         and what it does at the left, its control at the right. -->
    <Style x:Key="Row" TargetType="Border">
      <Setter Property="Margin" Value="24,0"/>
      <Setter Property="Padding" Value="0,16,0,17"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- A setting's name, and the sentences under it. -->
    <Style x:Key="Name" TargetType="TextBlock" BasedOn="{StaticResource PaneTitle}"/>
    <Style x:Key="Words" TargetType="TextBlock" BasedOn="{StaticResource Label}">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="15"/>
      <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <!-- A line of small print that is not there when it has nothing to say. -->
    <Style x:Key="Quiet" TargetType="TextBlock" BasedOn="{StaticResource Label}">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="15"/>
      <Style.Triggers>
        <Trigger Property="Text" Value="">
          <Setter Property="Visibility" Value="Collapsed"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Beside a control, quieter than a note: what it is unless changed,
         what a picture is of. And the two ends of a slider, under it. -->
    <Style x:Key="Aside" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="Foreground" Value="{DynamicResource Text4Brush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="End" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Foreground" Value="{DynamicResource Text4Brush}"/>
      <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>
    <!-- What a slider stands at, after it. -->
    <Style x:Key="Reading" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="18,0,0,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>

    <!-- The frame of a picture of table rows: the pane's own surface (a
         row's shade and the low accuracy mark are worked out against it),
         edged. -->
    <Style x:Key="Rows" TargetType="Border">
      <Setter Property="Width" Value="246"/>
      <Setter Property="Background" Value="{DynamicResource Bg1Brush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line2Brush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- A theme's glyph before its name: a little smaller than the name
         and quieter, until its segment is picked or pointed at. -->
    <Style x:Key="ThemeGlyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Foreground" Value="{DynamicResource Text3Brush}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource Text1Brush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource Text1Brush}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- A run's colour, to press: the run's badge, the colour's code, and
         a chevron that turns over while the picker under it is open. A
         toggle, so it acts on IsChecked: UI Automation opens it without a
         click. Its edge is the accent while it is open. -->
    <Style x:Key="Well" TargetType="ToggleButton" BasedOn="{StaticResource ZButton}">
      <Setter Property="Width" Value="118"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Padding" Value="5,0,11,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Style.Triggers>
        <Trigger Property="IsChecked" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="WellCode" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="WellChevron" TargetType="Path">
      <Setter Property="Data" Value="M0.65,0.65 L4.65,4.65 L8.65,0.65"/>
      <Setter Property="Width" Value="9.3"/>
      <Setter Property="Height" Value="5.3"/>
      <Setter Property="Stroke" Value="{DynamicResource Text2Brush}"/>
      <Setter Property="StrokeThickness" Value="1.3"/>
      <Setter Property="StrokeLineJoin" Value="Round"/>
      <Setter Property="StrokeStartLineCap" Value="Round"/>
      <Setter Property="StrokeEndLineCap" Value="Round"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
          <Setter Property="Data" Value="M0.65,4.65 L4.65,0.65 L8.65,4.65"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- In the picture of a Compare row: a run's band, as the section
         draws it (gone while characters are not shaded), and the amount's
         cell, which is two figures over the bands or two small bars
         without them. -->
    <Style x:Key="BandA" TargetType="Rectangle" BasedOn="{StaticResource RowShade}">
      <Setter Property="Fill" Value="{DynamicResource RunABandBrush}"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="Height" Value="18"/>
    </Style>
    <Style x:Key="BandB" TargetType="Rectangle" BasedOn="{StaticResource RowShade}">
      <Setter Property="Fill" Value="{DynamicResource RunBBandBrush}"/>
      <Setter Property="Margin" Value="0,18,0,0"/>
    </Style>
    <DataTemplate x:Key="AmountFigures">
      <v:RunPair A="{Binding TextA}" B="{Binding TextB}" FontWeight="SemiBold" Padding="2,0,8,0"/>
    </DataTemplate>
    <DataTemplate x:Key="AmountBars">
      <v:RunBars Value="{Binding}"/>
    </DataTemplate>
    <Style x:Key="Amount" TargetType="ContentControl">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="ContentTemplate" Value="{StaticResource AmountFigures}"/>
      <Style.Triggers>
        <Trigger Property="v:Shading.Characters" Value="False">
          <Setter Property="ContentTemplate" Value="{StaticResource AmountBars}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

  </UserControl.Resources>

  <!-- The page: a heading ruled off across the window, then one ruled row
       to a setting (apps/zerg-mockup/06-settings.svg). Capped at the
       sheet's width and set to the left: stretched across a wide window,
       a control would be a long way from what explains it. (A column with
       a greatest width, not MaxWidth on the content: content that is
       stretched and capped is centred.) The surface is the pane's, the
       window's whole width. -->
  <StackPanel>

    <Border BorderBrush="{DynamicResource Line2Brush}" BorderThickness="0,0,0,1" SnapsToDevicePixels="True">
      <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition MaxWidth="1100"/>
      </Grid.ColumnDefinitions>
      <DockPanel Height="51" Margin="24,0">
        <Button DockPanel.Dock="Right" Content="Done" FontWeight="SemiBold" MinWidth="64" Margin="16,0,0,0"
                Command="{Binding CloseSettingsCommand}" VerticalAlignment="Center"
                ToolTip="Back to the section this was opened over" AutomationProperties.Name="Close settings"/>
        <TextBlock DockPanel.Dock="Left" Text="Settings" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/>
        <TextBlock Text="Set once and left alone. The session goes on being measured underneath." Style="{StaticResource Label}"
                   VerticalAlignment="Center" Margin="10,5,0,0" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
      </Grid>
    </Border>

    <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition MaxWidth="1100"/>
    </Grid.ColumnDefinitions>
    <StackPanel>

      <!-- Where the event files are. -->
      <Border Style="{StaticResource Row}">
        <v:SettingRow>
          <StackPanel>
            <TextBlock Text="Events folder" Style="{StaticResource Name}"/>
            <TextBlock Text="Where Zerg looks for the event files (.jsonl) the VibeXI addon writes. It follows the newest one in the folder. Change this only if the addon writes somewhere else."
                       Style="{StaticResource Words}"/>
          </StackPanel>
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="410"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <!-- Read only, and a box all the same: a long path scrolls
                   in it, and it can be selected and copied. The folder
                   glyph lies over its left end. -->
              <TextBox Text="{Binding EventsFolder, Mode=OneWay}" IsReadOnly="True" Padding="30,0,7,0"
                       VerticalAlignment="Center" AutomationProperties.Name="Events folder"/>
              <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="9,1,0,0"
                         HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"
                         Foreground="{DynamicResource Text3Brush}"/>
              <Button Grid.Column="1" Content="Browse&#x2026;" Command="{Binding BrowseFolderCommand}" Margin="8,0,0,0"
                      VerticalAlignment="Center" ToolTip="Choose another folder"
                      AutomationProperties.Name="Choose the events folder"/>
              <Button Grid.Column="2" Content="Use default" Command="{Binding DefaultFolderCommand}" Margin="6,0,0,0"
                      VerticalAlignment="Center" ToolTip="Back to the folder VibeXI writes to unless it is told otherwise"
                      ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Use the default events folder"/>
            </Grid>
            <TextBlock Text="{Binding EventsFolderNote}" Style="{StaticResource Quiet}" Margin="0,7,0,0"/>
            <TextBlock Text="{Binding EventsFolderSource}" Style="{StaticResource Quiet}" Margin="0,3,0,0"/>
          </StackPanel>
        </v:SettingRow>
      </Border>

      <!-- The keys that switch click-through. -->
      <Border Style="{StaticResource Row}">
        <v:SettingRow>
          <StackPanel>
            <TextBlock Text="Click-through hot key" Style="{StaticResource Name}"/>
            <TextBlock Text="The keys that switch every floating panel between click-through and clickable, from any application, the game included. Click the keys, then press the new ones: Ctrl, Alt or Win held with a letter, a digit or F1 to F24."
                       Style="{StaticResource Words}"/>
          </StackPanel>
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <!-- Shows the keys, each as a key, and takes new ones:
                   pressed, it reads the next chord off the keyboard. Esc,
                   or the keyboard going elsewhere, leaves the keys as they
                   were. While it waits it says so in the accent colour,
                   with an accent edge. -->
              <Button x:Name="Keys" MinWidth="190" Padding="10,0" Click="OnKeys" PreviewKeyDown="OnKey"
                      LostKeyboardFocus="OnKeysLeft" ToolTip="Click, then press the new keys. Esc cancels."
                      AutomationProperties.Name="Change the click-through hot key"
                      AutomationProperties.HelpText="{Binding HotKeyFace}">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource ZButton}">
                    <Setter Property="Height" Value="28"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Recording}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Bg1Brush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
                <Grid>
                  <!-- To a screen reader or a script the keycaps are one
                       thing, the chord as it is written ("Ctrl+Alt+Z"):
                       not a list of three keys and two plus signs. -->
                  <v:Sample AutomationProperties.Name="{Binding HotKeyText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding Recording, Converter={StaticResource Hidden}}">
                  <ItemsControl ItemsSource="{Binding HotKeyText, Converter={StaticResource ChordKeys}}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock x:Name="Plus" Text="+" FontSize="11" Margin="5,0,5,1" VerticalAlignment="Center"
                                     Foreground="{DynamicResource Text3Brush}"/>
                          <ContentControl Style="{StaticResource Keycap}" Content="{Binding}"/>
                        </StackPanel>
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                            <Setter TargetName="Plus" Property="Visibility" Value="Collapsed"/>
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  </v:Sample>
                  <TextBlock Text="Press the new keys&#x2026;" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Visibility="{Binding Recording, Converter={StaticResource Visible}}"/>
                </Grid>
              </Button>
              <Button Content="Use default" Command="{Binding DefaultHotKeyCommand}" Margin="8,0,0,0" VerticalAlignment="Center"
                      ToolTip="Back to Ctrl+Alt+Z" AutomationProperties.Name="Use the default hot key"/>
            </StackPanel>
            <!-- What to press while it waits; why the keys pressed were
                 not taken, or why the ones shown do nothing. -->
            <TextBlock Text="{Binding HotKeyNote}" Margin="0,7,0,0" AutomationProperties.LiveSetting="Polite">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Quiet}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HotKeyNoteBad}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource CritBrush}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </v:SettingRow>
      </Border>

      <!-- What a pop-out is until its own slider says otherwise. A slider,
           as on a pop-out's bar: the same thing is set the same way in
           both. Beside it, a picture of a strip over something bright at
           the opacity set. -->
      <Border Style="{StaticResource Row}">
        <v:SettingRow>
          <StackPanel>
            <TextBlock Text="Default pop-out opacity" Style="{StaticResource Name}"/>
            <TextBlock Text="How solid the dark backdrop of a pop-out is; its text and bars stay solid. Every pop-out follows this until the slider on its own bar is moved. From then on that pop-out keeps its own opacity, whatever is set here."
                       Style="{StaticResource Words}"/>
          </StackPanel>
          <WrapPanel>
            <StackPanel Width="330" Margin="0,6,0,8">
              <StackPanel Orientation="Horizontal">
                <Slider Width="240" Margin="4,0,0,0" Minimum="15" Maximum="100" SmallChange="1" LargeChange="10"
                        VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1"
                        Value="{Binding Panels.DefaultOpacity}" AutomationProperties.Name="Default pop-out opacity"/>
                <TextBlock Text="{Binding Panels.DefaultOpacity, StringFormat={}{0}%}" Style="{StaticResource Reading}"/>
              </StackPanel>
              <Grid Width="240" Margin="4,4,0,0" HorizontalAlignment="Left">
                <TextBlock Text="15%" Style="{StaticResource End}"/>
                <TextBlock Text="100%" Style="{StaticResource End}" HorizontalAlignment="Right"/>
              </Grid>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
              <v:Sample AutomationProperties.Name="A picture of a pop-out at this opacity">
                <Grid Width="216" Height="62">
                  <!-- A panel is dark whatever the theme: its own tokens. -->
                  <Grid.Resources>
                    <ResourceDictionary Source="/Zerg;component/Themes/Panel.xaml"/>
                  </Grid.Resources>
                  <!-- Something bright behind it: a game. A picture's
                       colours, not the design's. -->
                  <Border CornerRadius="5">
                    <Border.Background>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#3E6A78"/>
                        <GradientStop Offset="0.55" Color="#C58B5A"/>
                        <GradientStop Offset="1" Color="#2F4127"/>
                      </LinearGradientBrush>
                    </Border.Background>
                  </Border>
                  <Grid Margin="10,9">
                    <Border CornerRadius="5" Background="Black"
                            Opacity="{Binding Panels.DefaultOpacity, Converter={StaticResource Percent}}"/>
                    <Border CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource Line2Brush}"
                            SnapsToDevicePixels="True"/>
                    <Grid Margin="4,6,4,0" Height="15" VerticalAlignment="Top">
                      <Rectangle RadiusX="2" RadiusY="2" Fill="{Binding SampleStrip1}"/>
                      <Rectangle Width="3" RadiusX="1.5" RadiusY="1.5" HorizontalAlignment="Left" Fill="{Binding SampleEdge1}"/>
                      <TextBlock Text="Hasaya" FontSize="10.5" Margin="8,0,0,0" VerticalAlignment="Center"
                                 Foreground="{DynamicResource Text1Brush}"/>
                      <TextBlock Text="40,659" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,4,0" HorizontalAlignment="Right"
                                 VerticalAlignment="Center" Foreground="{DynamicResource Text1Brush}"
                                 Typography.NumeralAlignment="Tabular"/>
                    </Grid>
                    <Grid Margin="4,23,4,0" Height="15" VerticalAlignment="Top">
                      <Rectangle Width="146.6" RadiusX="2" RadiusY="2" HorizontalAlignment="Left" Fill="{Binding SampleStrip2}"/>
                      <Rectangle Width="3" RadiusX="1.5" RadiusY="1.5" HorizontalAlignment="Left" Fill="{Binding SampleEdge2}"/>
                      <TextBlock Text="Brannoch" FontSize="10.5" Margin="8,0,0,0" VerticalAlignment="Center"
                                 Foreground="{DynamicResource Text1Brush}"/>
                      <TextBlock Text="31,927" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,4,0" HorizontalAlignment="Right"
                                 VerticalAlignment="Center" Foreground="{DynamicResource Text1Brush}"
                                 Typography.NumeralAlignment="Tabular"/>
                    </Grid>
                  </Grid>
                </Grid>
              </v:Sample>
              <TextBlock Text="preview" Style="{StaticResource Aside}" Margin="10,0,0,0"/>
            </StackPanel>
          </WrapPanel>
        </v:SettingRow>
      </Border>

      <!-- How often everything the clock moves is redrawn. -->
      <Border Style="{StaticResource Row}">
        <v:SettingRow>
          <StackPanel>
            <TextBlock Text="Draw frequency" Style="{StaticResource Name}"/>
            <TextBlock Text="How many times a second everything that moves with the clock is redrawn: the elapsed time, every DPS and HPS figure, and the right-hand edge of the Cumulative damage and Cumulative healing charts. Whatever an event changes is redrawn as soon as the event arrives. Higher is smoother and uses more processor time."
                       Style="{StaticResource Words}"/>
          </StackPanel>
          <StackPanel Margin="0,6,0,0">
            <StackPanel Orientation="Horizontal">
              <Slider Width="240" Margin="4,0,0,0" Minimum="1" Maximum="60" SmallChange="1" LargeChange="10"
                      VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1"
                      Value="{Binding DrawFrequency}" AutomationProperties.Name="Draw frequency"/>
              <TextBlock Text="{Binding DrawFrequency, StringFormat={}{0} a second}" Style="{StaticResource Reading}"/>
            </StackPanel>
            <Grid Width="240" Margin="4,4,0,0" HorizontalAlignment="Left">
              <TextBlock Text="1" Style="{StaticResource End}"/>
              <TextBlock Text="60" Style="{StaticResource End}" HorizontalAlignment="Right"/>
            </Grid>
          </StackPanel>
        </v:SettingRow>
      </Border>

      <!-- How a share is drawn in the tables: two switches, and beside
           them four rows drawn as the two stand now, by the tables' own
           row styles (they answer to v:Shading, which the picture is told
           as a card is). -->
      <Border Style="{StaticResource Row}">
        <v:SettingRow>
          <StackPanel>
            <TextBlock Text="Row shading" Style="{StaticResource Name}"/>
            <TextBlock Text="A share can be drawn as the row itself, shaded from its left edge to the length of the share. A row that is not shaded shows its share as a small bar in its Damage %, Healing % or Share cell instead. The pop-outs follow both switches."
                       Style="{StaticResource Words}"/>
          </StackPanel>
          <WrapPanel>
            <!-- The room under each first piece is for when the picture
                 has gone under it, in a row too narrow for both. -->
            <StackPanel Width="356" Margin="0,0,0,8">
              <StackPanel Orientation="Horizontal">
                <ToggleButton Content="Shade characters in their colour" IsChecked="{Binding ShadeCharacters}"
                              AutomationProperties.Name="Shade characters in their colour"/>
                <TextBlock Text="on unless switched off" Style="{StaticResource Aside}" Margin="10,0,0,0"/>
              </StackPanel>
              <TextBlock Text="A character's row in Damage by character and Healing by character, their heading in Actions and Heals, and the two runs in Compare."
                         Style="{StaticResource Words}" Margin="0,6,12,0"/>
              <StackPanel Orientation="Horizontal" Margin="0,13,0,0">
                <ToggleButton Content="Shade actions and heals" IsChecked="{Binding ShadeActions}"
                              AutomationProperties.Name="Shade actions and heals"/>
                <TextBlock Text="off unless switched on" Style="{StaticResource Aside}" Margin="10,0,0,0"/>
              </StackPanel>
              <TextBlock Text="The rows under a character, shaded without a colour." Style="{StaticResource Words}"
                         Margin="0,6,12,0"/>
            </StackPanel>
            <StackPanel>
              <v:Sample AutomationProperties.Name="A picture of four rows shaded as set"
                        v:Shading.Characters="{Binding ShadeCharacters}" v:Shading.Actions="{Binding ShadeActions}">
                <Border Style="{StaticResource Rows}">
                  <StackPanel>
                    <!-- Two characters: the shade, the rule, then the cells. -->
                    <Grid Height="22">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="104"/>
                      </Grid.ColumnDefinitions>
                      <Rectangle Grid.ColumnSpan="3" Style="{StaticResource RowShade}" Margin="0,0,0,1"
                                 Fill="{Binding SampleShade1}" v:Grow.Share="1"/>
                      <Rectangle Grid.ColumnSpan="3" Style="{StaticResource RowRule}"/>
                      <DockPanel Margin="8,0,0,1" VerticalAlignment="Center">
                        <Rectangle Style="{StaticResource Swatch}" Fill="{Binding SampleSwatch1}" Margin="0,0,6,0"/>
                        <TextBlock Text="Hasaya" FontSize="12" VerticalAlignment="Center"/>
                      </DockPanel>
                      <TextBlock Grid.Column="1" Text="40,659" Style="{StaticResource Cell}" FontWeight="SemiBold" Padding="0"/>
                      <v:SmallBar Grid.Column="2" For="Character" Length="36" Inset="12" Value="1" Fill="{Binding SampleSwatch1}">
                        <TextBlock Text="17.9%" Style="{StaticResource Cell}"/>
                      </v:SmallBar>
                    </Grid>
                    <Grid Height="22">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="104"/>
                      </Grid.ColumnDefinitions>
                      <Rectangle Grid.ColumnSpan="3" Style="{StaticResource RowShade}" Margin="0,0,0,1"
                                 Fill="{Binding SampleShade2}" v:Grow.Share="0.785"/>
                      <Rectangle Grid.ColumnSpan="3" Style="{StaticResource RowRule}"/>
                      <DockPanel Margin="8,0,0,1" VerticalAlignment="Center">
                        <Rectangle Style="{StaticResource Swatch}" Fill="{Binding SampleSwatch2}" Margin="0,0,6,0"/>
                        <TextBlock Text="Brannoch" FontSize="12" VerticalAlignment="Center"/>
                      </DockPanel>
                      <TextBlock Grid.Column="1" Text="31,927" Style="{StaticResource Cell}" FontWeight="SemiBold" Padding="0"/>
                      <v:SmallBar Grid.Column="2" For="Character" Length="36" Inset="12" Value="0.785" Fill="{Binding SampleSwatch2}">
                        <TextBlock Text="14.0%" Style="{StaticResource Cell}"/>
                      </v:SmallBar>
                    </Grid>
                    <!-- Two actions under a character. -->
                    <Grid Height="22">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="104"/>
                      </Grid.ColumnDefinitions>
                      <Rectangle Grid.ColumnSpan="3" Style="{StaticResource SubShade}" Margin="0,0,0,1" v:Grow.Share="1"/>
                      <Rectangle Grid.ColumnSpan="3" Style="{StaticResource RowRule}"/>
                      <TextBlock Text="Tachi: Gekko" FontSize="12" Margin="22,0,0,1" VerticalAlignment="Center"
                                 Foreground="{DynamicResource Text2Brush}"/>
                      <TextBlock Grid.Column="1" Text="13,105" Style="{StaticResource Cell}" FontWeight="SemiBold" Padding="0"/>
                      <v:SmallBar Grid.Column="2" For="Action" Length="36" Inset="12" Value="1" Fill="{DynamicResource Text3Brush}">
                        <TextBlock Text="32.2%" Style="{StaticResource Cell}"/>
                      </v:SmallBar>
                    </Grid>
                    <Grid Height="22">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="104"/>
                      </Grid.ColumnDefinitions>
                      <Rectangle Grid.ColumnSpan="3" Style="{StaticResource SubShade}" v:Grow.Share="0.81"/>
                      <TextBlock Text="Attack" FontSize="12" Margin="22,0,0,0" VerticalAlignment="Center"
                                 Foreground="{DynamicResource Text2Brush}"/>
                      <TextBlock Grid.Column="1" Text="10,629" Style="{StaticResource Cell}" FontWeight="SemiBold" Padding="0"/>
                      <v:SmallBar Grid.Column="2" For="Action" Length="36" Inset="12" Value="0.81" Fill="{DynamicResource Text3Brush}">
                        <TextBlock Text="26.1%" Style="{StaticResource Cell}"/>
                      </v:SmallBar>
                    </Grid>
                  </StackPanel>
                </Border>
              </v:Sample>
              <TextBlock Text="as set" Style="{StaticResource Aside}" Margin="0,6,0,0"/>
            </StackPanel>
          </WrapPanel>
        </v:SettingRow>
      </Border>

      <!-- Under what rate Accuracy, WS Acc and Pet Acc are marked, and six
           rates as the mark (v:LowMark) would draw them at that. -->
      <Border Style="{StaticResource Row}">
        <v:SettingRow>
          <StackPanel>
            <TextBlock Text="Low accuracy mark" Style="{StaticResource Name}"/>
            <TextBlock Text="Accuracy, WS Acc and Pet Acc under this are marked in red, more strongly the lower they fall: a rule under the figure first, then the cell cut out. At 60% and under the mark is at its strongest."
                       Style="{StaticResource Words}"/>
          </StackPanel>
          <StackPanel Margin="0,6,0,0">
            <WrapPanel>
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Slider Width="240" Margin="4,0,0,0" Minimum="50" Maximum="100" SmallChange="1" LargeChange="5"
                          VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1"
                          Value="{Binding LowAccuracy}" AutomationProperties.Name="Low accuracy mark"/>
                  <TextBlock Text="{Binding LowAccuracy, StringFormat={}{0}%}" Style="{StaticResource Reading}" MinWidth="34"/>
                </StackPanel>
                <Grid Width="240" Margin="4,4,0,0" HorizontalAlignment="Left">
                  <TextBlock Text="50%" Style="{StaticResource End}"/>
                  <TextBlock Text="100%" Style="{StaticResource End}" HorizontalAlignment="Right"/>
                </Grid>
              </StackPanel>
              <TextBlock Text="90% unless changed" Style="{StaticResource Aside}" Margin="10,1,0,0" VerticalAlignment="Top"/>
            </WrapPanel>
            <WrapPanel Margin="0,6,0,0">
              <v:Sample AutomationProperties.Name="A picture of six rates as they would be marked"
                        v:Shading.LowAccuracy="{Binding LowAccuracy}">
                <StackPanel Orientation="Horizontal" Height="24">
                  <v:LowMark Width="58" Rate="0.970">
                    <TextBlock Text="97.0%" Style="{StaticResource Fig}"/>
                  </v:LowMark>
                  <v:LowMark Width="58" Rate="0.896">
                    <TextBlock Text="89.6%" Style="{StaticResource Fig}"/>
                  </v:LowMark>
                  <v:LowMark Width="58" Rate="0.867">
                    <TextBlock Text="86.7%" Style="{StaticResource Fig}"/>
                  </v:LowMark>
                  <v:LowMark Width="58" Rate="0.833">
                    <TextBlock Text="83.3%" Style="{StaticResource Fig}"/>
                  </v:LowMark>
                  <v:LowMark Width="58" Rate="0.791">
                    <TextBlock Text="79.1%" Style="{StaticResource Fig}"/>
                  </v:LowMark>
                  <v:LowMark Width="58" Rate="0.571">
                    <TextBlock Text="57.1%" Style="{StaticResource Fig}"/>
                  </v:LowMark>
                </StackPanel>
              </v:Sample>
              <TextBlock Text="how each would be marked" Style="{StaticResource Aside}" Margin="10,0,0,0"/>
            </WrapPanel>
          </StackPanel>
        </v:SettingRow>
      </Border>

      <!-- Moved here from the command bar: set once and left alone. -->
      <Border Style="{StaticResource Row}">
        <v:SettingRow>
          <StackPanel>
            <TextBlock Text="Theme" Style="{StaticResource Name}"/>
            <TextBlock Text="Light, dark, or whatever Windows is set to." Style="{StaticResource Words}"/>
          </StackPanel>
          <Border Style="{StaticResource SegmentGroup}" VerticalAlignment="Top" Margin="0,1,0,0">
            <StackPanel Orientation="Horizontal">
              <RadioButton Style="{StaticResource Segment}" GroupName="theme"
                           IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=Light}"
                           AutomationProperties.Name="Light theme">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource ThemeGlyph}" Text="&#xE706;"/>
                  <TextBlock Text="Light"/>
                </StackPanel>
              </RadioButton>
              <RadioButton Style="{StaticResource Segment}" GroupName="theme"
                           IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=Dark}"
                           AutomationProperties.Name="Dark theme">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource ThemeGlyph}" Text="&#xE708;"/>
                  <TextBlock Text="Dark"/>
                </StackPanel>
              </RadioButton>
              <RadioButton Style="{StaticResource Segment}" GroupName="theme"
                           IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=System}"
                           AutomationProperties.Name="System theme">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource ThemeGlyph}" Text="&#xE7F4;"/>
                  <TextBlock Text="System"/>
                </StackPanel>
              </RadioButton>
            </StackPanel>
          </Border>
        </v:SettingRow>
      </Border>

      <!-- The colours of Compare's two runs: a well each, which opens the
           picker under it (one picker, under whichever well is open), and
           the way back to the installed pair. Beside them a Compare row in
           the two colours, and how strong their bands come out.

           Everything that keeps the picker open is in Runs: a press, or
           the keyboard, anywhere else closes it (the code beside this). -->
      <Border Style="{StaticResource Row}">
        <v:SettingRow>
          <StackPanel>
            <TextBlock Text="Compare colours" Style="{StaticResource Name}"/>
            <TextBlock Text="The colour of each run in Compare: its band across a row, its badge, and its columns and lines in the charts. Any colour can be picked. Zerg works out how strong the band is from the colour, so figures and changes stay readable on it."
                       Style="{StaticResource Words}"/>
          </StackPanel>
          <WrapPanel>
            <StackPanel x:Name="Runs" Width="356" Margin="0,0,0,8" IsKeyboardFocusWithinChanged="OnRunsFocus">
              <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="WellA" Style="{StaticResource Well}" Checked="OnWell" Unchecked="OnWell"
                              ToolTip="Pick the colour of run A, the baseline"
                              AutomationProperties.Name="Colour of run A" AutomationProperties.HelpText="{Binding RunACode}">
                  <DockPanel>
                    <Control DockPanel.Dock="Left" Style="{StaticResource RunTag}" Template="{StaticResource RunTagA}"/>
                    <Path DockPanel.Dock="Right" Style="{StaticResource WellChevron}"/>
                    <TextBlock Text="{Binding RunACode}" Style="{StaticResource WellCode}"/>
                  </DockPanel>
                </ToggleButton>
                <ToggleButton x:Name="WellB" Style="{StaticResource Well}" Margin="8,0,0,0" Checked="OnWell" Unchecked="OnWell"
                              ToolTip="Pick the colour of run B, the run compared with it"
                              AutomationProperties.Name="Colour of run B" AutomationProperties.HelpText="{Binding RunBCode}">
                  <DockPanel>
                    <Control DockPanel.Dock="Left" Style="{StaticResource RunTag}" Template="{StaticResource RunTagB}"/>
                    <Path DockPanel.Dock="Right" Style="{StaticResource WellChevron}"/>
                    <TextBlock Text="{Binding RunBCode}" Style="{StaticResource WellCode}"/>
                  </DockPanel>
                </ToggleButton>
                <Button Content="Use default" Command="{Binding DefaultRunsCommand}" Margin="8,0,0,0" VerticalAlignment="Center"
                        ToolTip="Both runs back to the colours Zerg is installed with" ToolTipService.ShowOnDisabled="True"
                        AutomationProperties.Name="Use the default run colours"/>
              </StackPanel>
              <v:ColourPicker x:Name="Picker" HorizontalAlignment="Left" Margin="0,4,0,0" Visibility="Collapsed"/>
            </StackPanel>
            <StackPanel>
              <v:Sample AutomationProperties.Name="A picture of a Compare row in these colours"
                        v:Shading.Characters="{Binding ShadeCharacters}">
                <Border Style="{StaticResource Rows}">
                  <Grid Height="36">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition/>
                      <ColumnDefinition Width="96"/>
                      <ColumnDefinition Width="74"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.ColumnSpan="3" Style="{StaticResource BandA}" v:Grow.Share="0.863"/>
                    <Rectangle Grid.ColumnSpan="3" Style="{StaticResource BandB}" v:Grow.Share="1"/>
                    <DockPanel Margin="8,0,0,0" VerticalAlignment="Center">
                      <Rectangle Style="{StaticResource Swatch}" Fill="{Binding SampleSwatch1}" Margin="0,0,6,0"/>
                      <TextBlock Text="Hasaya" FontSize="12" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ContentControl x:Name="PairAmount" Grid.Column="1" Style="{StaticResource Amount}"/>
                    <v:ChangeText x:Name="PairChange" Grid.Column="2" Padding="2,0,8,0"/>
                  </Grid>
                </Border>
              </v:Sample>
              <TextBlock Text="{Binding RunBandsNote}" FontSize="10.5" Margin="0,6,0,0" Foreground="{DynamicResource Text3Brush}"
                         Typography.NumeralAlignment="Tabular"/>
            </StackPanel>
          </WrapPanel>
        </v:SettingRow>
      </Border>

    </StackPanel>
    </Grid>
  </StackPanel>
</UserControl>
