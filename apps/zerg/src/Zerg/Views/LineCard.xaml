<UserControl x:Class="Zerg.Views.LineCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Zerg.Charts"
             xmlns:v="clr-namespace:Zerg.Views">

  <!-- Cumulative damage: a line per character, each named at its end. A
       pane: the chart has the whole of it, edge to edge, and keeps its own
       margins.

       "Group under 5%" is in the heading, not the command bar: it changes
       this chart and nothing else, and it goes wherever the card goes. Its
       tooltip says who is in the line that stands for several.

       Floating, the pane has no heading and the switch has a line of its
       own; the chart takes what the switch leaves, following the panel when
       it is dragged larger. -->
  <v:Pane Title="Cumulative damage" Note="Running total per character"
          Hint="Running total per character. Hover for every character at one instant."
          PopOutCommand="{Binding Panels[line].PopOutCommand}">
    <v:Pane.Tools>
      <ToggleButton Content="Group under 5%" IsChecked="{Binding GroupSmallLines}" ToolTip="{Binding GroupTip}">
        <ToggleButton.Style>
          <Style TargetType="ToggleButton" BasedOn="{StaticResource SmallToggle}">
            <Style.Triggers>
              <!-- On a floating panel the switch has the halo to itself:
                   the card it stands on has none, because of the chart. -->
              <Trigger Property="v:Float.On" Value="True">
                <Setter Property="Effect" Value="{StaticResource PanelHalo}"/>
              </Trigger>
            </Style.Triggers>
          </Style>
        </ToggleButton.Style>
      </ToggleButton>
    </v:Pane.Tools>

    <c:LineChart Edge="{Binding Edge}" EmptyText="{Binding EmptyText}" EndLabels="True"
                 AutomationProperties.Name="Cumulative damage chart">
      <c:LineChart.Style>
        <Style TargetType="c:LineChart">
          <!-- In a pane: as tall as the pane leaves it, and no shorter
               than a chart can be read at. -->
          <Setter Property="MinHeight" Value="80"/>
          <Setter Property="Model" Value="{Binding Line}"/>
          <Style.Triggers>
            <!-- In a narrow window the panes stand in one column, each as
                 tall as it asks to be: the chart is the height it was
                 when it was a card on a page. -->
            <Trigger Property="v:SplitPanel.Stacked" Value="True">
              <Setter Property="Height" Value="320"/>
            </Trigger>
            <!-- A panel's backdrop is dark whatever the theme, so it is
                 handed the lines in the colours made for that. -->
            <Trigger Property="v:Float.On" Value="True">
              <Setter Property="Height" Value="Auto"/>
              <Setter Property="MinHeight" Value="120"/>
              <Setter Property="Margin" Value="0,2,0,0"/>
              <Setter Property="Model" Value="{Binding PanelLine}"/>
              <Setter Property="Compact" Value="True"/>
              <!-- No effect lies over this chart (its lines are drawn at
                   the draw frequency): it outlines its own labels. -->
              <Setter Property="Halo" Value="True"/>
            </Trigger>
          </Style.Triggers>
        </Style>
      </c:LineChart.Style>
    </c:LineChart>
  </v:Pane>
</UserControl>
