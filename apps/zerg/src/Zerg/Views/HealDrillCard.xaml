<UserControl x:Class="Zerg.Views.HealDrillCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:c="clr-namespace:Zerg.Charts"
             xmlns:v="clr-namespace:Zerg.Views"
             Visibility="{Binding HealDrillOpen, Converter={StaticResource Visible}}">
  <UserControl.Resources>
    <sys:String x:Key="Columns">96,*,140,140</sys:String>
  </UserControl.Resources>

  <!-- One heal of one character: its figures, how its casts are spread, and
       every cast. Only there while a heal is picked. It has no panel of its
       own: docked it is a card under the Heals card, and in the Heals panel
       it sits under the heal's row. -->
  <Border Style="{StaticResource Card}">
    <StackPanel>
      <!-- Docked only. Under its row in a panel, the row already says which
           heal, how many casts and how much, and picking it again closes it. -->
      <DockPanel Visibility="{Binding Path=(v:Float.On), RelativeSource={RelativeSource Self}, Converter={StaticResource Hidden}}">
        <Button DockPanel.Dock="Right" VerticalAlignment="Top" Margin="8,0,0,0" Style="{StaticResource SmallButton}"
                Content="Close" Command="{Binding CloseHealDrillCommand}" AutomationProperties.Name="Close heal drill-down"/>
        <StackPanel>
          <TextBlock Text="{Binding HealDrillTitle}" Style="{StaticResource CardTitle}" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding HealDrillNote}" Style="{StaticResource Label}" Margin="0,2,0,0" TextWrapping="Wrap"
                     Typography.NumeralAlignment="Tabular"/>
        </StackPanel>
      </DockPanel>

      <ItemsControl ItemsSource="{Binding HealDrillTiles}" Margin="-4,12,-4,0" Focusable="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="1"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Margin="4,0" Padding="12,8" CornerRadius="6"
                    Background="{DynamicResource Bg2Brush}">
              <StackPanel>
                <TextBlock Text="{Binding Label}" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Value}" Style="{StaticResource Figure}" FontSize="20"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Shorter in a panel, as the damage drill-down's is. -->
      <c:HistogramChart Margin="0,12,0,0" Model="{Binding HealHistogram}"
                        EmptyText="No casts recorded" AutomationProperties.Name="Healing distribution chart">
        <c:HistogramChart.Style>
          <Style TargetType="c:HistogramChart">
            <Setter Property="Height" Value="210"/>
            <Setter Property="Fill" Value="{Binding HealHistogramFill}"/>
            <Style.Triggers>
              <Trigger Property="v:Float.On" Value="True">
                <Setter Property="Height" Value="160"/>
                <Setter Property="Fill" Value="{Binding PanelHealHistogramFill}"/>
              </Trigger>
            </Style.Triggers>
          </Style>
        </c:HistogramChart.Style>
      </c:HistogramChart>
      <TextBlock Text="{Binding HealDrillCaption}" Style="{StaticResource Label}" Margin="0,6,0,0" TextWrapping="Wrap"
                 HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular"/>

      <Expander Header="Every cast" Margin="0,10,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
        <StackPanel>
          <v:Cells Widths="{StaticResource Columns}" Margin="0,0,14,6">
            <TextBlock Text="Time" Style="{StaticResource Head}"/>
            <TextBlock Text="Target" Style="{StaticResource HeadText}"/>
            <TextBlock Text="Healed" Style="{StaticResource Head}"/>
            <TextBlock Text="vs avg" Style="{StaticResource Head}"/>
          </v:Cells>
          <!-- Only the rows in view exist, as in the damage drill-down. -->
          <ItemsControl ItemsSource="{Binding HealDrillHits}" MaxHeight="420" Focusable="False" v:WheelChain.On="True"
                        VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                        ScrollViewer.CanContentScroll="True">
            <ItemsControl.Template>
              <ControlTemplate TargetType="ItemsControl">
                <ScrollViewer CanContentScroll="True" Focusable="False" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                  <ItemsPresenter/>
                </ScrollViewer>
              </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource RowLine}" Height="30" MinHeight="0" Margin="0,0,14,0">
                  <v:Cells Widths="{StaticResource Columns}">
                    <TextBlock Text="{Binding Time}" Style="{StaticResource Cell}"/>
                    <TextBlock Text="{Binding Target}" Style="{StaticResource CellText}"/>
                    <TextBlock Text="{Binding Damage}" Style="{StaticResource Cell}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding VsAvg}" Style="{StaticResource Cell}"
                               Foreground="{DynamicResource Text2Brush}"/>
                  </v:Cells>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Expander>
    </StackPanel>
  </Border>
</UserControl>
