<UserControl x:Class="Zerg.Views.DrillCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:c="clr-namespace:Zerg.Charts"
             xmlns:v="clr-namespace:Zerg.Views"
             Visibility="{Binding DrillOpen, Converter={StaticResource Visible}}">
  <UserControl.Resources>
    <sys:String x:Key="Columns">96,*,140,140</sys:String>
  </UserControl.Resources>

  <!-- One action of one character: its figures, how its hits are spread, and
       every hit. Only there while an action is picked. It has no panel of
       its own: docked it is a card under the Actions card, and in the
       Actions panel it sits under the action's row. -->
  <Border Style="{StaticResource Card}">
    <StackPanel>
      <!-- Docked only. Under its row in a panel, the row already says which
           action, how many hits and how much, and picking it again closes it. -->
      <DockPanel Visibility="{Binding Path=(v:Float.On), RelativeSource={RelativeSource Self}, Converter={StaticResource Hidden}}">
        <Button DockPanel.Dock="Right" VerticalAlignment="Top" Margin="8,0,0,0" Style="{StaticResource SmallButton}"
                Content="Close" Command="{Binding CloseDrillCommand}" AutomationProperties.Name="Close drill-down"/>
        <StackPanel>
          <TextBlock Text="{Binding DrillTitle}" Style="{StaticResource CardTitle}" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding DrillNote}" Style="{StaticResource Label}" Margin="0,2,0,0" TextWrapping="Wrap"
                     Typography.NumeralAlignment="Tabular"/>
        </StackPanel>
      </DockPanel>

      <ItemsControl ItemsSource="{Binding DrillTiles}" Margin="-4,12,-4,0" Focusable="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="1"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Margin="4,0" Padding="12,8" CornerRadius="6"
                    Background="{DynamicResource SubtleFillColorSecondaryBrush}">
              <StackPanel>
                <TextBlock Text="{Binding Label}" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Value}" Style="{StaticResource Figure}" FontSize="20"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Shorter in a panel, so the row, the figures and the chart fit a
           panel of the height the actions list opens at. -->
      <c:HistogramChart Margin="0,12,0,0" Model="{Binding Histogram}"
                        AutomationProperties.Name="Damage distribution chart">
        <c:HistogramChart.Style>
          <Style TargetType="c:HistogramChart">
            <Setter Property="Height" Value="210"/>
            <Setter Property="Fill" Value="{Binding HistogramFill}"/>
            <Style.Triggers>
              <Trigger Property="v:Float.On" Value="True">
                <Setter Property="Height" Value="160"/>
                <Setter Property="Fill" Value="{Binding PanelHistogramFill}"/>
              </Trigger>
            </Style.Triggers>
          </Style>
        </c:HistogramChart.Style>
      </c:HistogramChart>
      <TextBlock Text="{Binding DrillCaption}" Style="{StaticResource Label}" Margin="0,6,0,0" TextWrapping="Wrap"
                 HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular"/>

      <Expander Header="Every hit" Margin="0,10,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
        <StackPanel>
          <v:Cells Widths="{StaticResource Columns}" Margin="0,0,14,6">
            <TextBlock Text="Time" Style="{StaticResource Head}"/>
            <TextBlock Text="Target" Style="{StaticResource HeadText}"/>
            <TextBlock Text="Damage" Style="{StaticResource Head}"/>
            <TextBlock Text="vs avg" Style="{StaticResource Head}"/>
          </v:Cells>
          <!-- A long fight is thousands of hits, so only the rows in view exist. -->
          <ItemsControl ItemsSource="{Binding DrillHits}" MaxHeight="420" Focusable="False" v:WheelChain.On="True"
                        VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                        ScrollViewer.CanContentScroll="True">
            <ItemsControl.Template>
              <ControlTemplate TargetType="ItemsControl">
                <ScrollViewer CanContentScroll="True" Focusable="False" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                  <ItemsPresenter/>
                </ScrollViewer>
              </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource RowLine}" Height="30" MinHeight="0" Margin="0,0,14,0">
                  <v:Cells Widths="{StaticResource Columns}">
                    <TextBlock Text="{Binding Time}" Style="{StaticResource Cell}"/>
                    <TextBlock Text="{Binding Target}" Style="{StaticResource CellText}"/>
                    <TextBlock Text="{Binding Damage}" Style="{StaticResource Cell}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding VsAvg}" Style="{StaticResource Cell}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                  </v:Cells>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Expander>
    </StackPanel>
  </Border>
</UserControl>
