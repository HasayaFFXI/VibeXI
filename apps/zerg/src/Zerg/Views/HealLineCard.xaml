<UserControl x:Class="Zerg.Views.HealLineCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Zerg.Charts"
             xmlns:v="clr-namespace:Zerg.Views">

  <!-- Cumulative healing: a line per healer, its legend, and the same
       figures as a table. The cumulative damage card over the heals, less
       the grouping switch: a party's healers are few enough for a line each.

       Floating, as that card: no legend and no table, and the chart fills
       the panel. -->
  <Border Style="{StaticResource Card}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource PopOut}" Command="{Binding Panels[hline].PopOutCommand}"
                AutomationProperties.Name="Pop out Cumulative healing"/>
        <StackPanel>
          <TextBlock Text="Cumulative healing" Style="{StaticResource CardTitle}"/>
          <TextBlock Text="Running total per healer. Hover for every healer at one instant. Pet heals are not included."
                     Style="{StaticResource CardNote}"/>
        </StackPanel>
      </DockPanel>

      <ItemsControl Grid.Row="1" ItemsSource="{Binding HealLegend}" Margin="0,10,0,0" Focusable="False"
                    Visibility="{Binding Path=(v:Float.On), RelativeSource={RelativeSource Self}, Converter={StaticResource Hidden}}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
              <Rectangle Style="{StaticResource Swatch}" Fill="{Binding Swatch}"/>
              <TextBlock Text="{Binding Name}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding Job}" Style="{StaticResource Badge}"/>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <c:LineChart Grid.Row="2" Edge="{Binding Edge}" EmptyText="{Binding HealEmptyText}"
                   AutomationProperties.Name="Cumulative healing chart">
        <c:LineChart.Style>
          <Style TargetType="c:LineChart">
            <Setter Property="Height" Value="320"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Model" Value="{Binding HealLine}"/>
            <Style.Triggers>
              <!-- A panel's backdrop is dark whatever the theme, so it is
                   handed the lines in the colours made for that. -->
              <Trigger Property="v:Float.On" Value="True">
                <Setter Property="Height" Value="Auto"/>
                <Setter Property="MinHeight" Value="120"/>
                <Setter Property="Margin" Value="0,2,0,0"/>
                <Setter Property="Model" Value="{Binding PanelHealLine}"/>
                <Setter Property="Compact" Value="True"/>
                <Setter Property="EndLabels" Value="True"/>
              </Trigger>
            </Style.Triggers>
          </Style>
        </c:LineChart.Style>
      </c:LineChart>

      <Expander Grid.Row="3" Header="Data table" Margin="0,10,0,0" IsExpanded="{Binding HealLineTableOpen}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                Visibility="{Binding Path=(v:Float.On), RelativeSource={RelativeSource Self}, Converter={StaticResource Hidden}}">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" v:WheelChain.On="True">
          <StackPanel>
            <ItemsControl ItemsSource="{Binding HealLineHead}" Focusable="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" Style="{StaticResource Head}" MinWidth="92" Margin="0,0,0,6"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding HealLineRows}" Focusable="False">
              <!-- A row is a list of cells; a screen reader names it by its time. -->
              <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                  <Setter Property="AutomationProperties.Name" Value="{Binding [0]}"/>
                </Style>
              </ItemsControl.ItemContainerStyle>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource RowLine}" MinHeight="28">
                    <ItemsControl ItemsSource="{Binding}" Focusable="False">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding}" Style="{StaticResource Cell}" MinWidth="92"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Expander>
    </Grid>
  </Border>
</UserControl>
