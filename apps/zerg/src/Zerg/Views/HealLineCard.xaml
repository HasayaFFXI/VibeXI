<UserControl x:Class="Zerg.Views.HealLineCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Zerg.Charts"
             xmlns:v="clr-namespace:Zerg.Views">

  <!-- Cumulative healing: a line per healer, each named at its end. The
       cumulative damage pane over the heals, less the grouping switch: a
       party's healers are few enough for a line each.

       Floating, as that card: the chart fills the panel. -->
  <v:Pane Title="Cumulative healing" Note="Running total per healer"
          Hint="Running total per healer. Hover for every healer at one instant. Pet heals are not included."
          PopOutCommand="{Binding Panels[hline].PopOutCommand}">
    <c:LineChart Edge="{Binding Edge}" EmptyText="{Binding HealEmptyText}" EndLabels="True"
                 AutomationProperties.Name="Cumulative healing chart">
      <c:LineChart.Style>
        <Style TargetType="c:LineChart">
          <!-- In a pane: as tall as the pane leaves it. -->
          <Setter Property="MinHeight" Value="80"/>
          <Setter Property="Model" Value="{Binding HealLine}"/>
          <Style.Triggers>
            <!-- One column of panes in a narrow window: the height it had
                 as a card on a page. -->
            <Trigger Property="v:SplitPanel.Stacked" Value="True">
              <Setter Property="Height" Value="320"/>
            </Trigger>
            <!-- A panel's backdrop is dark whatever the theme, so it is
                 handed the lines in the colours made for that. -->
            <Trigger Property="v:Float.On" Value="True">
              <Setter Property="Height" Value="Auto"/>
              <Setter Property="MinHeight" Value="120"/>
              <Setter Property="Margin" Value="0,2,0,0"/>
              <Setter Property="Model" Value="{Binding PanelHealLine}"/>
              <Setter Property="Compact" Value="True"/>
              <!-- No effect lies over this chart (its lines are drawn at
                   the draw frequency): it outlines its own labels. -->
              <Setter Property="Halo" Value="True"/>
            </Trigger>
          </Style.Triggers>
        </Style>
      </c:LineChart.Style>
    </c:LineChart>
  </v:Pane>
</UserControl>
