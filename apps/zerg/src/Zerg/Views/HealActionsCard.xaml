<UserControl x:Class="Zerg.Views.HealActionsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:v="clr-namespace:Zerg.Views">
  <UserControl.Resources>
    <sys:String x:Key="Columns">2.4*,*,*,*,*,*,*</sys:String>

    <!-- A character's heading: who, what they healed in all, and what their
         pet healed on top of it, said apart because it is not in the first.
         Picking it shows their heals under it; picking it again puts them
         away. -->
    <DataTemplate x:Key="Heading">
      <Border Style="{StaticResource RowLine}" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
        <Button Style="{StaticResource RowButton}"
                Command="{Binding DataContext.ToggleHealsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                CommandParameter="{Binding}" AutomationProperties.Name="{Binding Label}"
                ToolTip="Show or hide this character's heals">
          <StackPanel Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Caret}" Width="14" FontSize="10" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Rectangle Margin="0,0,8,0">
              <Rectangle.Style>
                <Style TargetType="Rectangle" BasedOn="{StaticResource Swatch}">
                  <Setter Property="Fill" Value="{Binding Swatch}"/>
                  <Style.Triggers>
                    <Trigger Property="v:Float.On" Value="True">
                      <Setter Property="Fill" Value="{Binding PanelSwatch}"/>
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </Rectangle.Style>
            </Rectangle>
            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Job}" Style="{StaticResource Badge}"/>
            <TextBlock Text="—" FontSize="13" Margin="8,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
            <TextBlock Text="{Binding Total}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                       Typography.NumeralAlignment="Tabular"/>
            <TextBlock Text="{Binding Pet}" Style="{StaticResource Badge}" FontSize="13" Margin="8,0,0,0"
                       Typography.NumeralAlignment="Tabular"/>
          </StackPanel>
        </Button>
      </Border>
    </DataTemplate>

    <!-- In a floating panel the drill-down opens under the heal it is about,
         as an action's does in the Actions panel. Made when the heal is
         picked and thrown away when it is not. -->
    <DataTemplate x:Key="Nothing"/>
    <DataTemplate x:Key="Detail">
      <v:HealDrillCard Margin="40,0,0,12" Loaded="OnDetailLoaded"/>
    </DataTemplate>
    <Style x:Key="Under" TargetType="ContentControl">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="ContentTemplate" Value="{StaticResource Nothing}"/>
      <Style.Triggers>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding Selected}" Value="True"/>
            <Condition Binding="{Binding Path=(v:Float.On), RelativeSource={RelativeSource Self}}" Value="True"/>
          </MultiDataTrigger.Conditions>
          <Setter Property="ContentTemplate" Value="{StaticResource Detail}"/>
        </MultiDataTrigger>
      </Style.Triggers>
    </Style>

    <!-- One heal. Picking it opens the drill-down; picking it again closes it. -->
    <DataTemplate x:Key="Action">
      <StackPanel>
        <Button Command="{Binding DataContext.HealDrillCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                CommandParameter="{Binding}" AutomationProperties.Name="{Binding Label}" ToolTip="Show every cast">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource RowButton}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding Selected}" Value="True">
                  <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
          <Grid>
            <Border Width="3" CornerRadius="1.5" HorizontalAlignment="Left" Margin="0,5"
                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                    Visibility="{Binding Selected, Converter={StaticResource Visible}}"/>
            <v:Cells Widths="{StaticResource Columns}">
              <TextBlock Text="{Binding Name}" Style="{StaticResource CellText}" Padding="40,0,8,0"/>
              <TextBlock Text="{Binding Casts}" Style="{StaticResource Cell}"/>
              <TextBlock Text="{Binding Total}" Style="{StaticResource Cell}" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding Avg}" Style="{StaticResource Cell}"/>
              <TextBlock Text="{Binding Min}" Style="{StaticResource Cell}"/>
              <TextBlock Text="{Binding Max}" Style="{StaticResource Cell}"/>
              <TextBlock Text="{Binding Share}" Style="{StaticResource Cell}"/>
            </v:Cells>
          </Grid>
        </Button>
        <ContentControl Content="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        Style="{StaticResource Under}"/>
      </StackPanel>
    </DataTemplate>

    <v:ActionRowTemplates x:Key="Templates" Heading="{StaticResource Heading}" Action="{StaticResource Action}"/>
  </UserControl.Resources>

  <!-- Every cure, waltz and pet heal, under the character it belongs to,
       once that character's heading is opened. In a floating panel the list
       takes the panel's height. -->
  <Border Style="{StaticResource Card}">
    <DockPanel>
      <DockPanel DockPanel.Dock="Top">
        <Button DockPanel.Dock="Right" Style="{StaticResource PopOut}" Command="{Binding Panels[hactions].PopOutCommand}"
                AutomationProperties.Name="Pop out Heals"/>
        <StackPanel>
          <TextBlock Text="Heals" Style="{StaticResource CardTitle}"/>
          <!-- The gap above the table goes with the note when a panel drops it. -->
          <TextBlock Text="Every cure, waltz and pet heal. Select a character to show theirs, and a heal to drill down."
                     Style="{StaticResource CardNote}"
                     Margin="0,2,0,10"/>
        </StackPanel>
      </DockPanel>

      <TextBlock DockPanel.Dock="Top" Text="{Binding HealEmptyText}" Style="{StaticResource Label}" FontSize="13"
                 Margin="0,18,0,8" HorizontalAlignment="Center"
                 Visibility="{Binding HasHeals, Converter={StaticResource Hidden}}"/>

      <ScrollViewer x:Name="Sideways" HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled" v:WheelChain.On="True"
                    Visibility="{Binding HasHeals, Converter={StaticResource Visible}}">
        <Grid MinWidth="560" Width="{Binding ViewportWidth, ElementName=Sideways}" Margin="0,0,0,12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <!-- The right margin, here and on the rows, keeps the last column
               out from under the list's scroll bar. -->
          <v:Cells Widths="{StaticResource Columns}" Margin="0,0,14,6">
            <TextBlock Text="Heal" Style="{StaticResource HeadText}"/>
            <TextBlock Text="Casts" Style="{StaticResource Head}" ToolTip="One per cast, however many people it reached"/>
            <TextBlock Text="Total" Style="{StaticResource Head}"/>
            <TextBlock Text="Avg" Style="{StaticResource Head}" ToolTip="Total divided by casts"/>
            <TextBlock Text="Min" Style="{StaticResource Head}"
                       ToolTip="The least one target was healed for, above nothing: a cure on someone at full health is not it"/>
            <TextBlock Text="Max" Style="{StaticResource Head}" ToolTip="The most one target was healed for"/>
            <TextBlock Text="Share" Style="{StaticResource Head}"
                       ToolTip="Out of everything under this character's heading, their pet's heals included"/>
          </v:Cells>
          <!-- The rows scroll under their headings. Docked, the list is as
               tall as it needs, up to a cap; floating, as tall as the panel. -->
          <Grid Grid.Row="1">
            <Grid.Style>
              <Style TargetType="Grid">
                <Setter Property="MaxHeight" Value="340"/>
                <Style.Triggers>
                  <Trigger Property="v:Float.On" Value="True">
                    <Setter Property="MaxHeight" Value="Infinity"/>
                  </Trigger>
                </Style.Triggers>
              </Style>
            </Grid.Style>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          v:WheelChain.On="True">
              <ItemsControl x:Name="List" ItemsSource="{Binding Heals}" ItemTemplateSelector="{StaticResource Templates}"
                            Focusable="False" Margin="0,0,14,0"/>
            </ScrollViewer>
          </Grid>
        </Grid>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
