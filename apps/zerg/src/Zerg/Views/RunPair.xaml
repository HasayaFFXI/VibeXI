<UserControl x:Class="Zerg.Views.RunPair"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Self" Focusable="False" IsTabStop="False">
  <UserControl.Resources>
    <Style x:Key="Figure" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>
    <!-- Which run a line is: a short tick in the run's colour ahead of it,
         so the order never has to be remembered. -->
    <Style x:Key="Tick" TargetType="Rectangle">
      <Setter Property="Width" Value="5"/>
      <Setter Property="Height" Value="2"/>
      <Setter Property="RadiusX" Value="1"/>
      <Setter Property="RadiusY" Value="1"/>
      <Setter Property="Margin" Value="0,1,5,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </UserControl.Resources>

  <!-- One figure for each run in one cell, A over B. Figures sit at the
       right like any column of them; words (a job) at the left. -->
  <Grid x:Name="Lines" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,2">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Rectangle Style="{StaticResource Tick}" Fill="{DynamicResource RunABrush}"/>
    <TextBlock Grid.Column="1" Text="{Binding Value.A, ElementName=Self}" Style="{StaticResource Figure}"
               HorizontalAlignment="{Binding HorizontalAlignment, ElementName=Lines}"/>
    <Rectangle Grid.Row="1" Style="{StaticResource Tick}" Fill="{DynamicResource RunBBrush}"/>
    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Value.B, ElementName=Self}" Style="{StaticResource Figure}"
               HorizontalAlignment="{Binding HorizontalAlignment, ElementName=Lines}"/>
  </Grid>
</UserControl>
