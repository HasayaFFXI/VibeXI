<v:SplitPanel x:Class="Zerg.Views.ComparePanes"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:sys="clr-namespace:System;assembly=System.Runtime"
              xmlns:c="clr-namespace:Zerg.Charts"
              xmlns:v="clr-namespace:Zerg.Views"
              v:Shading.Characters="{Binding ShadeCharacters}">
  <!-- The Compare section's four panes, under its bands (Views/CompareSection):
       who (by character or by job; comparing healing, by healer); both runs
       on one clock; what kind (by damage type; by heal); at whom (by
       target). This is the panel that arranges them itself, a v:SplitPanel
       as the Damage and Healing sections' are, with its panes written into
       it: where each goes is its tree's to say (PaneLayouts.Compare, which
       the main window binds), not the order they are written in, and one
       arrangement serves both modes. None can float, so none has a Pop out.
       Only the mode on screen has rows. Its data context is the
       CompareViewModel.

       How its rows are drawn is the live tables' way. A row is shaded
       twice, run A's band across its top half and run B's across its
       bottom half, each from the row's left edge to that run's amount out
       of the largest in the table (a Rectangle under v:Grow, at the
       strength its brush has). "Shade characters in their colour" governs
       it, said once here (v:Shading.Characters) and inherited: off, the
       bands go and the amount's cell has its two small bars back. A flip
       is a trigger in each row; nothing is measured and no row is made
       again. -->
  <v:SplitPanel.Resources>

    <!-- Each table's columns, shared by its heading and every row: the
         widths the design draws them at (by character, in a pane 940
         wide), as shares, each with the least it may be. The second of a
         pair is the same table with "shade characters" off: the amount's
         cell then holds two bars and their figures, and the name gives up
         the room. A blank column ends a table. -->
    <sys:String x:Key="ActorColumns">160*120,96*80,86*62,78*64,66*56,72*60,72*60,70*60,66*52,72*60,68*52,20*0</sys:String>
    <sys:String x:Key="ActorBarColumns">110*60,96*80,136*124,78*64,66*56,72*60,72*60,70*60,66*52,72*60,68*52,20*0</sys:String>
    <sys:String x:Key="ActionColumns">256*120,50*40,70*60,66*60,62*48,72*60,62*48,76*60,80*60,132*0</sys:String>
    <sys:String x:Key="HealerColumns">256*150,86*62,78*64,66*50,72*56,72*60,76*56,76*56,144*0</sys:String>
    <sys:String x:Key="HealerBarColumns">206*90,136*124,78*64,66*50,72*56,72*60,76*56,76*56,144*0</sys:String>
    <sys:String x:Key="HealColumns">256*120,50*40,76*60,80*60,62*48,72*60,62*48,268*0</sys:String>
    <sys:String x:Key="KindColumns">170*90,100*62,110*64,105*52</sys:String>
    <sys:String x:Key="KindBarColumns">130*70,140*120,110*64,105*52</sys:String>
    <sys:String x:Key="SpreadColumns">76*,54,54,64,58,8</sys:String>
    <sys:String x:Key="PaceColumns">*,*,*,*</sys:String>

    <Style x:Key="ActorCells" TargetType="v:Cells">
      <Setter Property="Widths" Value="{StaticResource ActorColumns}"/>
      <Style.Triggers>
        <Trigger Property="v:Shading.Characters" Value="False">
          <Setter Property="Widths" Value="{StaticResource ActorBarColumns}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="HealerCells" TargetType="v:Cells">
      <Setter Property="Widths" Value="{StaticResource HealerColumns}"/>
      <Style.Triggers>
        <Trigger Property="v:Shading.Characters" Value="False">
          <Setter Property="Widths" Value="{StaticResource HealerBarColumns}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="KindCells" TargetType="v:Cells">
      <Setter Property="Widths" Value="{StaticResource KindColumns}"/>
      <Style.Triggers>
        <Trigger Property="v:Shading.Characters" Value="False">
          <Setter Property="Widths" Value="{StaticResource KindBarColumns}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <sys:String x:Key="ChangeTip">The change from run A to run B: B &#x2212; A, and that as a share of A</sys:String>

    <!-- A line of small print that is not there when it has nothing to say. -->
    <Style x:Key="Quiet" TargetType="TextBlock" BasedOn="{StaticResource Label}">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Style.Triggers>
        <Trigger Property="Text" Value="">
          <Setter Property="Visibility" Value="Collapsed"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- A cell of two figures, A over B, and a cell with the change between
         them: a figure's padding, set against the column's right-hand edge. -->
    <Style TargetType="v:RunPair">
      <Setter Property="Padding" Value="2,0,8,0"/>
    </Style>
    <Style TargetType="v:ChangeText">
      <Setter Property="Padding" Value="2,0,8,0"/>
    </Style>

    <!-- A run's band behind a row: the run's colour at the strength that
         leaves a worse change's red legible on it (AppTheme makes the
         brush), from the row's left edge to the run's amount. A's lies
         across the row's top half, B's across the bottom half down to the
         row's rule. Gone while "shade characters" is off (RowShade). -->
    <Style x:Key="BandA" TargetType="Rectangle" BasedOn="{StaticResource RowShade}">
      <Setter Property="Fill" Value="{DynamicResource RunABandBrush}"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="Height" Value="18"/>
    </Style>
    <Style x:Key="BandB" TargetType="Rectangle" BasedOn="{StaticResource RowShade}">
      <Setter Property="Fill" Value="{DynamicResource RunBBandBrush}"/>
      <Setter Property="Margin" Value="0,18,0,1"/>
    </Style>
    <!-- The same in a row 28 tall: 14 and 13. -->
    <Style x:Key="SideBandA" TargetType="Rectangle" BasedOn="{StaticResource BandA}">
      <Setter Property="Height" Value="14"/>
    </Style>
    <Style x:Key="SideBandB" TargetType="Rectangle" BasedOn="{StaticResource BandB}">
      <Setter Property="Margin" Value="0,14,0,1"/>
    </Style>

    <!-- An amount for each run (damage, healing): two figures, A over B,
         the row behind them being the bars; or, while "shade characters"
         is off, two small bars with their figures. One or the other is
         made, never both. Its content is the BarPair. -->
    <DataTemplate x:Key="AmountFigures">
      <v:RunPair A="{Binding TextA}" B="{Binding TextB}" FontWeight="SemiBold"/>
    </DataTemplate>
    <DataTemplate x:Key="AmountBars">
      <v:RunBars Value="{Binding}"/>
    </DataTemplate>
    <Style x:Key="Amount" TargetType="ContentControl">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="ContentTemplate" Value="{StaticResource AmountFigures}"/>
      <Style.Triggers>
        <Trigger Property="v:Shading.Characters" Value="False">
          <Setter Property="ContentTemplate" Value="{StaticResource AmountBars}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- A row to press: a character, a job or a healer. 36 units, its rule
         inside it; opened onto what is under it, it lies on the raised
         surface. -->
    <Style x:Key="PairPick" TargetType="Button" BasedOn="{StaticResource RowPick}">
      <Setter Property="Height" Value="{StaticResource PairRowHeight}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Open}" Value="True">
          <Setter Property="Background" Value="{DynamicResource Bg2Brush}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <!-- A row to press in the well under one: an action, a heal. 32 units,
         on the well's surface, its rule set in from the left with its name. -->
    <Style x:Key="WellPick" TargetType="Button" BasedOn="{StaticResource RowPick}">
      <Setter Property="Height" Value="32"/>
      <Setter Property="Background" Value="{DynamicResource Bg0Brush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border Background="{TemplateBinding Background}"/>
              <Rectangle Style="{StaticResource RowRule}" Margin="28,0,0,0"/>
              <ContentPresenter/>
              <Border x:Name="Hover" Style="{StaticResource RowHover}"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Hover" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Hover" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- The mark before an action's name: a row's caret, a step quieter. -->
    <Style x:Key="WellCaret" TargetType="Path" BasedOn="{StaticResource RowCaret}">
      <Setter Property="Stroke" Value="{DynamicResource Text3Brush}"/>
    </Style>

    <!-- The well under an opened row: the window's own surface, darker
         than the pane, its headings 24 tall, and ruled off from the rows
         that follow it. -->
    <Style x:Key="Well" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Bg0Brush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line2Brush}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="Padding" Value="0,0,0,6"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- A total under one name, both runs: a target, or a healing spell.
         28 units, shaded twice. -->
    <DataTemplate x:Key="TotalRow">
      <Grid Height="28">
        <Rectangle Style="{StaticResource SideBandA}" v:Grow.Share="{Binding Amount.A}"/>
        <Rectangle Style="{StaticResource SideBandB}" v:Grow.Share="{Binding Amount.B}"/>
        <v:Cells Style="{StaticResource KindCells}" Margin="0,0,14,1">
          <TextBlock Text="{Binding Name}" Style="{StaticResource CellText}" Padding="14,0,8,0"/>
          <ContentControl Content="{Binding Amount}" Style="{StaticResource Amount}"/>
          <v:ChangeText Value="{Binding Change}"/>
        </v:Cells>
        <Rectangle Style="{StaticResource RowRule}"/>
      </Grid>
    </DataTemplate>
    <!-- A row of a side table that is pressed to isolate it: a target, a
         damage type. The Target and Type buttons' menus do the same.
         Isolated, it has the accent down its left edge and its name is
         stronger; while others are isolated and it is not, it is dimmed: it
         is still listed, with what it came to, and is in no other figure.
         The row's cells are the template's that names this style. -->
    <Style x:Key="SidePick" TargetType="Button" BasedOn="{StaticResource RowPick}">
      <Setter Property="Height" Value="28"/>
      <Setter Property="ToolTip" Value="{Binding Tip}"/>
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
      <Setter Property="Command" Value="{Binding PickCommand}"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Isolated}" Value="True">
          <Setter Property="AutomationProperties.ItemStatus" Value="isolated"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <!-- The accent down an isolated row's left edge. -->
    <Style x:Key="PickEdge" TargetType="Rectangle">
      <Setter Property="Width" Value="3"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="Margin" Value="0,0,0,1"/>
      <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Isolated}" Value="True">
          <Setter Property="Visibility" Value="Visible"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <!-- What is dimmed of a row that is not among the isolated. -->
    <Style x:Key="PickCells" TargetType="Grid">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Dimmed}" Value="True">
          <Setter Property="Opacity" Value="0.5"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PickName" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
      <Setter Property="Padding" Value="14,0,8,0"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Isolated}" Value="True">
          <Setter Property="FontWeight" Value="SemiBold"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- One target while damage is compared: TotalRow's cells, to press. -->
    <DataTemplate x:Key="TargetPick">
      <Button Style="{StaticResource SidePick}">
        <Grid>
          <Grid Style="{StaticResource PickCells}">
            <Rectangle Style="{StaticResource SideBandA}" v:Grow.Share="{Binding Line.Amount.A}"/>
            <Rectangle Style="{StaticResource SideBandB}" v:Grow.Share="{Binding Line.Amount.B}"/>
            <v:Cells Style="{StaticResource KindCells}" Margin="0,0,14,1">
              <TextBlock Text="{Binding Name}" Style="{StaticResource PickName}"/>
              <ContentControl Content="{Binding Line.Amount}" Style="{StaticResource Amount}"/>
              <v:ChangeText Value="{Binding Line.Change}"/>
            </v:Cells>
          </Grid>
          <Rectangle Style="{StaticResource PickEdge}"/>
        </Grid>
      </Button>
    </DataTemplate>
    <!-- One kind of damage, the same way: both runs and its share of each,
         to press. The share is of every type's damage, isolated or not. -->
    <DataTemplate x:Key="KindPick">
      <Button Style="{StaticResource SidePick}">
        <Grid>
          <Grid Style="{StaticResource PickCells}">
            <Rectangle Style="{StaticResource SideBandA}" v:Grow.Share="{Binding Line.Damage.A}"/>
            <Rectangle Style="{StaticResource SideBandB}" v:Grow.Share="{Binding Line.Damage.B}"/>
            <v:Cells Style="{StaticResource KindCells}" Margin="0,0,14,1">
              <TextBlock Text="{Binding Name}" Style="{StaticResource PickName}"/>
              <ContentControl Content="{Binding Line.Damage}" Style="{StaticResource Amount}"/>
              <v:ChangeText Value="{Binding Line.Change}"/>
              <v:RunPair Value="{Binding Line.Share}" Padding="2,0,5,0"/>
            </v:Cells>
          </Grid>
          <Rectangle Style="{StaticResource PickEdge}"/>
        </Grid>
      </Button>
    </DataTemplate>
    <Style x:Key="ByName" TargetType="ContentPresenter">
      <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
    </Style>
    <Style x:Key="ByLabel" TargetType="ContentPresenter">
      <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
    </Style>

    <!-- The rows of a side table scroll under its headings in what the
         pane has left. In a narrow window, where a pane is as tall as it
         asks to be, the list is as tall as it needs, up to a cap. -->
    <Style x:Key="SideList" TargetType="Grid">
      <Style.Triggers>
        <Trigger Property="v:SplitPanel.Stacked" Value="True">
          <Setter Property="MaxHeight" Value="340"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="MainList" TargetType="Grid">
      <Style.Triggers>
        <Trigger Property="v:SplitPanel.Stacked" Value="True">
          <Setter Property="MaxHeight" Value="560"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- What is under a row is made when the row is opened and thrown away
         when it is closed: eighteen characters' actions are a few thousand
         cells, and a closed row's would be read out by a screen reader as
         though they were there. -->
    <DataTemplate x:Key="Nothing"/>
    <DataTemplate x:Key="NoActions">
      <Border Style="{StaticResource Well}" Padding="0">
        <TextBlock Text="No actions." Style="{StaticResource Label}" Margin="44,8,8,8"/>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="NoHeals">
      <Border Style="{StaticResource Well}" Padding="0">
        <TextBlock Text="No heals." Style="{StaticResource Label}" Margin="44,8,8,8"/>
      </Border>
    </DataTemplate>

    <!-- A figure in the table beside a distribution: set against its
         column's right-hand edge, with no padding of its own. -->
    <Style x:Key="SpreadFig" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
      <Style.Triggers>
        <Trigger Property="Text" Value="&#x2014;">
          <Setter Property="Foreground" Value="{DynamicResource Text4Brush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- An action's hits, or a heal's casts, both runs: how they are
         spread, on bins the runs share, and the figures of each beside it,
         a line 23 units tall for each, the change in two columns: as a
         share of A, toned, and the plain difference, quiet. A box on the
         pane's surface, set into the well under its action. -->
    <DataTemplate x:Key="SpreadDetail">
      <Border Margin="28,4,14,8" Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource Line2Brush}"
              BorderThickness="1" CornerRadius="4" SnapsToDevicePixels="True">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="330"/>
          </Grid.ColumnDefinitions>
          <!-- The chart is as tall as the figures beside it, which are a row
               longer when either run has a crit. -->
          <DockPanel Margin="10,8,8,8">
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Spread.Caption}" Style="{StaticResource Quiet}"
                       FontSize="10.5" Margin="0,4,0,0" HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
            <c:PairedHistogramChart MinHeight="150" Model="{Binding Histogram}"
                                    AutomationProperties.Name="Distribution chart of both runs"/>
          </DockPanel>
          <Border Grid.Column="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0" Margin="0,9"
                  Padding="5,0,9,0" SnapsToDevicePixels="True">
            <StackPanel VerticalAlignment="Top">
              <!-- The rows name themselves; over the figures, whose they are. -->
              <Grid Height="21">
                <v:Cells Widths="{StaticResource SpreadColumns}" Margin="0,0,0,1">
                  <Border/>
                  <Control Style="{StaticResource RunTagSmall}" Template="{StaticResource RunTagA}" HorizontalAlignment="Right"/>
                  <Control Style="{StaticResource RunTagSmall}" Template="{StaticResource RunTagB}" HorizontalAlignment="Right"/>
                  <TextBlock Text="&#x394; %" Style="{StaticResource Head}" Padding="0" ToolTip="{StaticResource ChangeTip}"/>
                  <TextBlock Text="&#x394;" Style="{StaticResource Head}" Padding="0" ToolTip="B &#x2212; A"/>
                </v:Cells>
                <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource Line2Brush}" SnapsToDevicePixels="True"/>
              </Grid>
              <ItemsControl ItemsSource="{Binding Spread.Lines}" Focusable="False"
                            ItemContainerStyle="{StaticResource ByLabel}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Height="23" Background="Transparent" ToolTip="{Binding Tip}">
                      <v:Cells Widths="{StaticResource SpreadColumns}" Margin="0,0,0,1">
                        <TextBlock Text="{Binding Label}" FontSize="11.5" Padding="4,0,4,0" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Text2Brush}"/>
                        <TextBlock Text="{Binding A}" Style="{StaticResource SpreadFig}"/>
                        <TextBlock Text="{Binding B}" Style="{StaticResource SpreadFig}"/>
                        <TextBlock Text="{Binding Change.Main}" Style="{StaticResource Tone}" FontSize="11.5"/>
                        <TextBlock Text="{Binding Change.Sub}" Style="{StaticResource SpreadFig}" FontSize="10.5"
                                   Foreground="{DynamicResource Text3Brush}"/>
                      </v:Cells>
                      <Rectangle Style="{StaticResource RowRule}"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </DataTemplate>
    <Style x:Key="UnderSpread" TargetType="ContentControl">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="ContentTemplate" Value="{StaticResource Nothing}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Open}" Value="True">
          <Setter Property="ContentTemplate" Value="{StaticResource SpreadDetail}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- A row's actions, paired: what a change of gear or job did. Each
         opens in its turn, onto how its hits are spread; the one that is
         open has an accent edge and its name in a heavier face. -->
    <DataTemplate x:Key="ActorDetail">
      <Border Style="{StaticResource Well}">
        <StackPanel>
          <v:Cells Widths="{StaticResource ActionColumns}" Height="{StaticResource ColumnHeadHeight}" Margin="0,0,14,0">
            <TextBlock Text="Action" Style="{StaticResource HeadText}" Padding="44,0,8,0"/>
            <TextBlock Text="Uses" Style="{StaticResource Head}"/>
            <TextBlock Text="Accuracy" Style="{StaticResource Head}"/>
            <TextBlock Text="&#x394;" Style="{StaticResource Head}" ToolTip="{StaticResource ChangeTip}"/>
            <TextBlock Text="Avg" Style="{StaticResource Head}"/>
            <TextBlock Text="&#x394;" Style="{StaticResource Head}" ToolTip="{StaticResource ChangeTip}"/>
            <TextBlock Text="Max" Style="{StaticResource Head}"/>
            <TextBlock Text="Total" Style="{StaticResource Head}"/>
            <TextBlock Text="&#x394;" Style="{StaticResource Head}" ToolTip="{StaticResource ChangeTip}"/>
          </v:Cells>
          <ItemsControl ItemsSource="{Binding Actions}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <Button Style="{StaticResource WellPick}" Command="{Binding ToggleCommand}"
                          AutomationProperties.Name="{Binding Label}"
                          ToolTip="Compare how this action's hits are spread">
                    <Grid>
                      <Rectangle x:Name="Edge" Width="2" HorizontalAlignment="Left" SnapsToDevicePixels="True"
                                 Fill="{DynamicResource AccentBrush}" Visibility="Collapsed"/>
                      <v:Cells Widths="{StaticResource ActionColumns}" Margin="0,0,14,1">
                        <DockPanel Margin="28,0,8,0" VerticalAlignment="Center">
                          <Path Style="{StaticResource WellCaret}" Margin="0,0,8,0"/>
                          <TextBlock x:Name="Name" Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"
                                     VerticalAlignment="Center"/>
                        </DockPanel>
                        <v:RunPair Value="{Binding Line.Uses}"/>
                        <v:RunPair Value="{Binding Line.Accuracy}"/>
                        <v:ChangeText Value="{Binding Line.AccuracyChange}"/>
                        <v:RunPair Value="{Binding Line.Avg}"/>
                        <v:ChangeText Value="{Binding Line.AvgChange}"/>
                        <v:RunPair Value="{Binding Line.Max}" Foreground="{DynamicResource Text2Brush}"/>
                        <v:RunPair Value="{Binding Line.Total}"/>
                        <v:ChangeText Value="{Binding Line.TotalChange}"/>
                      </v:Cells>
                    </Grid>
                  </Button>
                  <ContentControl Content="{Binding}" Style="{StaticResource UnderSpread}"/>
                </StackPanel>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Open}" Value="True">
                    <Setter TargetName="Edge" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Name" Property="FontWeight" Value="SemiBold"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </DataTemplate>
    <Style x:Key="UnderActor" TargetType="ContentControl">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="ContentTemplate" Value="{StaticResource Nothing}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Open}" Value="True">
          <Setter Property="ContentTemplate" Value="{StaticResource ActorDetail}"/>
        </DataTrigger>
        <!-- Open, with nothing that did damage in either run. -->
        <DataTrigger Binding="{Binding NoActions}" Value="True">
          <Setter Property="ContentTemplate" Value="{StaticResource NoActions}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- A healer's heals, paired. Each opens in its turn, onto how its casts are spread. -->
    <DataTemplate x:Key="HealerDetail">
      <Border Style="{StaticResource Well}">
        <StackPanel>
          <v:Cells Widths="{StaticResource HealColumns}" Height="{StaticResource ColumnHeadHeight}" Margin="0,0,14,0">
            <TextBlock Text="Heal" Style="{StaticResource HeadText}" Padding="44,0,8,0"/>
            <TextBlock Text="Casts" Style="{StaticResource Head}"/>
            <TextBlock Text="Total" Style="{StaticResource Head}"/>
            <TextBlock Text="&#x394;" Style="{StaticResource Head}" ToolTip="{StaticResource ChangeTip}"/>
            <TextBlock Text="Avg" Style="{StaticResource Head}"/>
            <TextBlock Text="&#x394;" Style="{StaticResource Head}" ToolTip="{StaticResource ChangeTip}"/>
            <TextBlock Text="Max" Style="{StaticResource Head}"/>
          </v:Cells>
          <ItemsControl ItemsSource="{Binding Heals}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <Button Style="{StaticResource WellPick}" Command="{Binding ToggleCommand}"
                          AutomationProperties.Name="{Binding Label}"
                          ToolTip="Compare how this heal's casts are spread">
                    <Grid>
                      <Rectangle x:Name="Edge" Width="2" HorizontalAlignment="Left" SnapsToDevicePixels="True"
                                 Fill="{DynamicResource AccentBrush}" Visibility="Collapsed"/>
                      <v:Cells Widths="{StaticResource HealColumns}" Margin="0,0,14,1">
                        <DockPanel Margin="28,0,8,0" VerticalAlignment="Center">
                          <Path Style="{StaticResource WellCaret}" Margin="0,0,8,0"/>
                          <TextBlock x:Name="Name" Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"
                                     VerticalAlignment="Center"/>
                        </DockPanel>
                        <v:RunPair Value="{Binding Line.Casts}"/>
                        <v:RunPair Value="{Binding Line.Total}"/>
                        <v:ChangeText Value="{Binding Line.TotalChange}"/>
                        <v:RunPair Value="{Binding Line.Avg}"/>
                        <v:ChangeText Value="{Binding Line.AvgChange}"/>
                        <v:RunPair Value="{Binding Line.Max}" Foreground="{DynamicResource Text2Brush}"/>
                      </v:Cells>
                    </Grid>
                  </Button>
                  <ContentControl Content="{Binding}" Style="{StaticResource UnderSpread}"/>
                </StackPanel>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Open}" Value="True">
                    <Setter TargetName="Edge" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Name" Property="FontWeight" Value="SemiBold"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </DataTemplate>
    <Style x:Key="UnderHealer" TargetType="ContentControl">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="ContentTemplate" Value="{StaticResource Nothing}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Open}" Value="True">
          <Setter Property="ContentTemplate" Value="{StaticResource HealerDetail}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding NoHeals}" Value="True">
          <Setter Property="ContentTemplate" Value="{StaticResource NoHeals}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- One character, or one job, of the damage table: who, the job in
         each run with the runs' marks before it, then A over B and the
         change between them, column by column. -->
    <DataTemplate x:Key="ActorRow">
      <StackPanel>
        <Button Style="{StaticResource PairPick}" Command="{Binding ToggleCommand}"
                AutomationProperties.Name="{Binding Name}" ToolTip="Compare the actions behind this row">
          <Grid>
            <Rectangle Style="{StaticResource BandA}" v:Grow.Share="{Binding Line.Damage.A}"/>
            <Rectangle Style="{StaticResource BandB}" v:Grow.Share="{Binding Line.Damage.B}"/>
            <v:Cells Style="{StaticResource ActorCells}" Margin="0,0,14,1">
              <DockPanel Margin="12,0,8,0" VerticalAlignment="Center">
                <Path Style="{StaticResource RowCaret}" Margin="0,0,8,0"/>
                <Rectangle Style="{StaticResource Swatch}" Fill="{Binding Swatch}" Margin="0,0,6,0"/>
                <TextBlock x:Name="Name" Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
              </DockPanel>
              <!-- By character, the job in each run; by job, who was on it.
                   One or the other is there, never an empty copy of both. -->
              <Grid Background="Transparent" ToolTip="{Binding JobsTip}">
                <v:RunMarks Visibility="{Binding Jobs, Converter={StaticResource Present}}">
                  <v:RunPair Value="{Binding Jobs}" Words="True" FontSize="10.5" Padding="22,0,2,0"
                             Foreground="{DynamicResource Text2Brush}"/>
                </v:RunMarks>
                <TextBlock Text="{Binding Members}" ToolTip="{Binding Members}" Style="{StaticResource Quiet}" FontSize="10.5"
                           LineHeight="13" LineStackingStrategy="BlockLineHeight" MaxHeight="26"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Text2Brush}"
                           VerticalAlignment="Center" Margin="8,0,4,0"/>
              </Grid>
              <ContentControl Content="{Binding Line.Damage}" Style="{StaticResource Amount}"/>
              <v:ChangeText Value="{Binding Line.DamageChange}"/>
              <v:RunPair Value="{Binding Line.Dps}"/>
              <v:ChangeText Value="{Binding Line.DpsChange}"/>
              <v:RunPair Value="{Binding Line.Accuracy}"/>
              <v:ChangeText Value="{Binding Line.AccuracyChange}"/>
              <v:RunPair Value="{Binding Line.WsAvg}"/>
              <v:ChangeText Value="{Binding Line.WsAvgChange}"/>
              <v:RunPair Value="{Binding Line.Share}"/>
            </v:Cells>
          </Grid>
        </Button>
        <ContentControl Content="{Binding}" Style="{StaticResource UnderActor}"/>
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Open}" Value="True">
          <Setter TargetName="Name" Property="FontWeight" Value="SemiBold"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- The healing table's two kinds of row: the party, which leads it on
         the raised surface and opens onto nothing; and a healer. -->
    <DataTemplate x:Key="PartyRow">
      <Grid Height="{StaticResource PairRowHeight}" Background="{DynamicResource Bg2Brush}">
        <Rectangle Style="{StaticResource BandA}" v:Grow.Share="{Binding Line.Healing.A}"/>
        <Rectangle Style="{StaticResource BandB}" v:Grow.Share="{Binding Line.Healing.B}"/>
        <v:Cells Style="{StaticResource HealerCells}" Margin="0,0,14,1">
          <TextBlock Text="{Binding Name}" Style="{StaticResource CellText}" FontWeight="SemiBold" Padding="42,0,8,0"/>
          <ContentControl Content="{Binding Line.Healing}" Style="{StaticResource Amount}"/>
          <v:ChangeText Value="{Binding Line.HealingChange}"/>
          <v:RunPair Value="{Binding Line.Casts}"/>
          <v:RunPair Value="{Binding Line.Avg}"/>
          <v:ChangeText Value="{Binding Line.AvgChange}"/>
          <v:RunPair Value="{Binding Line.Biggest}"/>
          <v:RunPair Value="{Binding Line.Pet}"/>
        </v:Cells>
        <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource Line2Brush}" SnapsToDevicePixels="True"/>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="HealerRow">
      <StackPanel>
        <Button Style="{StaticResource PairPick}" Command="{Binding ToggleCommand}"
                AutomationProperties.Name="{Binding Name}" ToolTip="Compare the heals behind this row">
          <Grid>
            <Rectangle Style="{StaticResource BandA}" v:Grow.Share="{Binding Line.Healing.A}"/>
            <Rectangle Style="{StaticResource BandB}" v:Grow.Share="{Binding Line.Healing.B}"/>
            <v:Cells Style="{StaticResource HealerCells}" Margin="0,0,14,1">
              <DockPanel Margin="12,0,8,0" VerticalAlignment="Center">
                <Path Style="{StaticResource RowCaret}" Margin="0,0,8,0"/>
                <Rectangle Style="{StaticResource Swatch}" Fill="{Binding Swatch}" Margin="0,0,6,0"/>
                <TextBlock x:Name="Name" Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
              </DockPanel>
              <ContentControl Content="{Binding Line.Healing}" Style="{StaticResource Amount}"/>
              <v:ChangeText Value="{Binding Line.HealingChange}"/>
              <v:RunPair Value="{Binding Line.Casts}"/>
              <v:RunPair Value="{Binding Line.Avg}"/>
              <v:ChangeText Value="{Binding Line.AvgChange}"/>
              <v:RunPair Value="{Binding Line.Biggest}"/>
              <v:RunPair Value="{Binding Line.Pet}"/>
            </v:Cells>
          </Grid>
        </Button>
        <ContentControl Content="{Binding}" Style="{StaticResource UnderHealer}"/>
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Open}" Value="True">
          <Setter TargetName="Name" Property="FontWeight" Value="SemiBold"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <v:ActionRowTemplates x:Key="HealerRows" Heading="{StaticResource PartyRow}" Action="{StaticResource HealerRow}"/>

  </v:SplitPanel.Resources>

    <!-- By character, by job, by healer: a row per one of them. Its
         headings stand still and its rows scroll under them; sideways,
         it scrolls only in a pane too narrow for its columns. -->
    <v:Pane v:SplitPanel.Key="cactors" Title="{Binding RowsTitle}" Note="{Binding RowsNote}" Hint="{Binding RowsHint}">
      <Grid>
        <!-- Damage. -->
        <ScrollViewer x:Name="ActorScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      v:WheelChain.On="True" Visibility="{Binding IsDamage, Converter={StaticResource Visible}}">
          <Grid MinWidth="744" Width="{Binding ViewportWidth, ElementName=ActorScroller}">
            <Grid.Style>
              <Style TargetType="Grid">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ComputedHorizontalScrollBarVisibility, ElementName=ActorScroller}" Value="Visible">
                    <Setter Property="Margin" Value="0,0,0,12"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid Height="{StaticResource ColumnHeadHeight}">
              <v:Cells Style="{StaticResource ActorCells}" Margin="0,0,14,1">
                <TextBlock Text="{Binding NameHead}" Style="{StaticResource HeadText}" Padding="28,0,8,0"/>
                <TextBlock Text="{Binding JobHead}" Style="{StaticResource HeadText}" Padding="22,0,2,0"/>
                <TextBlock Text="Damage" Style="{StaticResource Head}"/>
                <TextBlock Text="&#x394;" Style="{StaticResource Head}" ToolTip="{StaticResource ChangeTip}"/>
                <TextBlock Text="DPS" Style="{StaticResource Head}" ToolTip="Damage divided by that run's session clock"/>
                <TextBlock Text="&#x394;" Style="{StaticResource Head}" ToolTip="{StaticResource ChangeTip}"/>
                <!-- The longest words over the narrowest columns: as a
                     figure, they have the column less 2 units, not less 8. -->
                <TextBlock Text="Accuracy" Style="{StaticResource Head}" Padding="2,0,8,0"
                           ToolTip="Melee and ranged swings that connected, out of all attempted"/>
                <TextBlock Text="&#x394;" Style="{StaticResource Head}" ToolTip="{StaticResource ChangeTip}"/>
                <TextBlock Text="WS Avg" Style="{StaticResource Head}" Padding="2,0,8,0"
                           ToolTip="Average damage of the weaponskills that dealt damage"/>
                <TextBlock Text="&#x394;" Style="{StaticResource Head}" ToolTip="{StaticResource ChangeTip}"/>
                <TextBlock Text="Share" Style="{StaticResource Head}" ToolTip="Share of that run's party damage"/>
              </v:Cells>
              <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource Line2Brush}" SnapsToDevicePixels="True"/>
            </Grid>
            <Grid Grid.Row="1" Style="{StaticResource MainList}">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                            v:WheelChain.On="True">
                <ItemsControl ItemsSource="{Binding Actors}" ItemTemplate="{StaticResource ActorRow}" Focusable="False"/>
              </ScrollViewer>
            </Grid>
          </Grid>
        </ScrollViewer>

        <!-- Healing. -->
        <DockPanel Visibility="{Binding IsHealing, Converter={StaticResource Visible}}">
          <!-- Why a side is dashes, or that nobody healed: over the
               table, where it is read before the dashes are. -->
          <TextBlock DockPanel.Dock="Top" Text="{Binding HealNote}" Style="{StaticResource Quiet}" FontSize="11.5"
                     Margin="12,8,14,8"/>
          <ScrollViewer x:Name="HealerScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                        v:WheelChain.On="True" Visibility="{Binding Healers.Count, Converter={StaticResource Present}}">
            <Grid MinWidth="620" Width="{Binding ViewportWidth, ElementName=HealerScroller}">
              <Grid.Style>
                <Style TargetType="Grid">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ComputedHorizontalScrollBarVisibility, ElementName=HealerScroller}" Value="Visible">
                      <Setter Property="Margin" Value="0,0,0,12"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Grid.Style>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
              </Grid.RowDefinitions>
              <Grid Height="{StaticResource ColumnHeadHeight}">
                <v:Cells Style="{StaticResource HealerCells}" Margin="0,0,14,1">
                  <TextBlock Text="{Binding HealerHead}" Style="{StaticResource HeadText}" Padding="28,0,8,0"/>
                  <TextBlock Text="Healing" Style="{StaticResource Head}"/>
                  <TextBlock Text="&#x394;" Style="{StaticResource Head}" ToolTip="{StaticResource ChangeTip}"/>
                  <TextBlock Text="Casts" Style="{StaticResource Head}" ToolTip="One per cast, however many people it reached"/>
                  <TextBlock Text="Avg" Style="{StaticResource Head}" ToolTip="Healing divided by casts"/>
                  <TextBlock Text="&#x394;" Style="{StaticResource Head}" ToolTip="{StaticResource ChangeTip}"/>
                  <TextBlock Text="Biggest" Style="{StaticResource Head}"
                             ToolTip="The most one target was healed for by one cast"/>
                  <TextBlock Text="Pet" Style="{StaticResource Head}" ToolTip="Heals by the character's pet. Not part of Healing"/>
                </v:Cells>
                <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource Line2Brush}" SnapsToDevicePixels="True"/>
              </Grid>
              <Grid Grid.Row="1" Style="{StaticResource MainList}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              v:WheelChain.On="True">
                  <ItemsControl ItemsSource="{Binding Healers}" ItemTemplateSelector="{StaticResource HealerRows}"
                                Focusable="False"/>
                </ScrollViewer>
              </Grid>
            </Grid>
          </ScrollViewer>
        </DockPanel>
      </Grid>
    </v:Pane>

    <!-- Both runs' running total on one clock. The shorter run's line
         ends where the run did; it is not carried on flat. Which line is
         which run is said inside the plot's top left-hand corner, where
         a running total never is: the chart's right-hand edge belongs to
         the ends of the two lines. Under it, the same as a table, which
         takes the chart's place while it is open: the pane has no room
         for both. (In a narrow window, where a pane is as tall as it
         asks to be, the table opens under the chart.) -->
    <v:Pane v:SplitPanel.Key="cpace" Title="{Binding PaceTitle}" Note="{Binding PaceNote}" Hint="{Binding PaceHint}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition>
            <RowDefinition.Style>
              <Style TargetType="RowDefinition">
                <Setter Property="Height" Value="*"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding PaceTableOpen}" Value="True">
                    <Setter Property="Height" Value="Auto"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </RowDefinition.Style>
          </RowDefinition>
          <RowDefinition>
            <RowDefinition.Style>
              <Style TargetType="RowDefinition">
                <Setter Property="Height" Value="Auto"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding PaceTableOpen}" Value="True">
                    <Setter Property="Height" Value="*"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </RowDefinition.Style>
          </RowDefinition>
        </Grid.RowDefinitions>
        <Grid>
          <Grid.Style>
            <Style TargetType="Grid">
              <Setter Property="MinHeight" Value="80"/>
              <Style.Triggers>
                <Trigger Property="v:SplitPanel.Stacked" Value="True">
                  <Setter Property="Height" Value="260"/>
                </Trigger>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding PaceTableOpen}" Value="True"/>
                    <Condition Binding="{Binding Path=(v:SplitPanel.Stacked), RelativeSource={RelativeSource Self}}" Value="False"/>
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Collapsed"/>
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>
          <c:LineChart Model="{Binding Pace}" EmptyText="Nothing to compare"
                       AutomationProperties.Name="Cumulative chart of both runs"/>
          <ItemsControl ItemsSource="{Binding PaceLegend}" Margin="50,10,8,0" HorizontalAlignment="Left"
                        VerticalAlignment="Top" IsHitTestVisible="False" Focusable="False"
                        ItemContainerStyle="{StaticResource ByName}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Height="14">
                  <Rectangle Style="{StaticResource Swatch}" Fill="{Binding Swatch}"/>
                  <TextBlock Text="{Binding Name}" FontSize="10.5" Margin="5,0,0,0" VerticalAlignment="Center"
                             Foreground="{DynamicResource Text2Brush}"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
        <Border Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" SnapsToDevicePixels="True">
          <Expander Header="Data table" IsExpanded="{Binding PaceTableOpen}" Margin="8,0,0,1" Padding="0"
                    Foreground="{DynamicResource Text2Brush}" AutomationProperties.Name="Data table of both runs"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <Grid Margin="-8,0,0,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
              </Grid.RowDefinitions>
              <Grid Height="22">
                <v:Cells Widths="{StaticResource PaceColumns}" Margin="0,0,14,1">
                  <TextBlock Text="Time" Style="{StaticResource Head}"/>
                  <TextBlock Text="A" Style="{StaticResource Head}"/>
                  <TextBlock Text="B" Style="{StaticResource Head}"/>
                  <TextBlock Text="B &#x2212; A" Style="{StaticResource Head}"/>
                </v:Cells>
                <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource Line2Brush}" SnapsToDevicePixels="True"/>
              </Grid>
              <Grid Grid.Row="1" Style="{StaticResource SideList}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              v:WheelChain.On="True">
                  <ItemsControl ItemsSource="{Binding PaceTable}" Focusable="False">
                    <ItemsControl.ItemContainerStyle>
                      <Style TargetType="ContentPresenter">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Time}"/>
                      </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Height="{StaticResource SubRowHeight}">
                          <v:Cells Widths="{StaticResource PaceColumns}" Margin="0,0,14,1">
                            <TextBlock Text="{Binding Time}" Style="{StaticResource Cell}"
                                       Foreground="{DynamicResource Text2Brush}"/>
                            <TextBlock Text="{Binding A}" Style="{StaticResource Cell}"/>
                            <TextBlock Text="{Binding B}" Style="{StaticResource Cell}"/>
                            <TextBlock Text="{Binding Difference}" Style="{StaticResource Cell}"
                                       Foreground="{DynamicResource Text2Brush}"/>
                          </v:Cells>
                          <Rectangle Style="{StaticResource RowRule}"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </Grid>
          </Expander>
        </Border>
      </Grid>
    </v:Pane>

    <!-- By damage type; comparing healing, by heal. -->
    <v:Pane v:SplitPanel.Key="ckinds" Title="{Binding KindsTitle}" Note="{Binding KindsNote}">
      <!-- While a type is isolated: the way back to them all, where they
           were picked. Not over the heals, which this pane lists while
           healing is compared. -->
      <v:Pane.Tools>
        <Grid Visibility="{Binding IsDamage, Converter={StaticResource Visible}}">
          <Button Style="{StaticResource LinkButton}" Content="Clear" Command="{Binding TypeFilter.ClearCommand}"
                  ToolTip="Count every type of damage again" AutomationProperties.Name="Clear the isolated types"
                  Visibility="{Binding TypeFilter.IsOn, Converter={StaticResource Visible}}"/>
        </Grid>
      </v:Pane.Tools>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid Height="{StaticResource SubRowHeight}">
          <!-- Damage. -->
          <v:Cells Style="{StaticResource KindCells}" Margin="0,0,14,1"
                   Visibility="{Binding IsDamage, Converter={StaticResource Visible}}">
            <TextBlock Text="Type" Style="{StaticResource HeadText}" Padding="14,0,8,0"/>
            <TextBlock Text="Damage" Style="{StaticResource Head}"/>
            <TextBlock Text="&#x394;" Style="{StaticResource Head}" ToolTip="{StaticResource ChangeTip}"/>
            <TextBlock Text="Share" Style="{StaticResource Head}" Padding="2,0,5,0"
                       ToolTip="Share of that run's party damage, of every type"/>
          </v:Cells>
          <!-- Healing. -->
          <v:Cells Style="{StaticResource KindCells}" Margin="0,0,14,1"
                   Visibility="{Binding IsHealing, Converter={StaticResource Visible}}">
            <TextBlock Text="Heal" Style="{StaticResource HeadText}" Padding="14,0,8,0"/>
            <TextBlock Text="Healing" Style="{StaticResource Head}"/>
            <TextBlock Text="&#x394;" Style="{StaticResource Head}" ToolTip="{StaticResource ChangeTip}"/>
          </v:Cells>
          <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource Line2Brush}" SnapsToDevicePixels="True"/>
        </Grid>
        <Grid Grid.Row="1" Style="{StaticResource SideList}">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" v:WheelChain.On="True">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding KindRows}" ItemTemplate="{StaticResource KindPick}" Focusable="False"/>
              <ItemsControl ItemsSource="{Binding HealSpells}" ItemTemplate="{StaticResource TotalRow}" Focusable="False"
                            ItemContainerStyle="{StaticResource ByName}"/>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>
    </v:Pane>

    <!-- By target: what each target took; comparing healing, what each
         character received. -->
    <v:Pane v:SplitPanel.Key="ctargets" Title="By target" Note="{Binding TargetsNote}">
      <!-- While a target is isolated: the way back to them all, where
           they were picked. -->
      <v:Pane.Tools>
        <Grid Visibility="{Binding IsDamage, Converter={StaticResource Visible}}">
          <Button Style="{StaticResource LinkButton}" Content="Clear" Command="{Binding TargetFilter.ClearCommand}"
                  ToolTip="Count every target again" AutomationProperties.Name="Clear the isolated targets"
                  Visibility="{Binding TargetFilter.IsOn, Converter={StaticResource Visible}}"/>
        </Grid>
      </v:Pane.Tools>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid Height="{StaticResource SubRowHeight}">
          <v:Cells Style="{StaticResource KindCells}" Margin="0,0,14,1">
            <TextBlock Text="Target" Style="{StaticResource HeadText}" Padding="14,0,8,0"/>
            <Grid>
              <TextBlock Text="Damage" Style="{StaticResource Head}"
                         Visibility="{Binding IsDamage, Converter={StaticResource Visible}}"/>
              <TextBlock Text="Healing" Style="{StaticResource Head}"
                         Visibility="{Binding IsHealing, Converter={StaticResource Visible}}"/>
            </Grid>
            <TextBlock Text="&#x394;" Style="{StaticResource Head}" ToolTip="{StaticResource ChangeTip}"/>
          </v:Cells>
          <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource Line2Brush}" SnapsToDevicePixels="True"/>
        </Grid>
        <Grid Grid.Row="1" Style="{StaticResource SideList}">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" v:WheelChain.On="True">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding TargetRows}" ItemTemplate="{StaticResource TargetPick}" Focusable="False"/>
              <ItemsControl ItemsSource="{Binding HealTargets}" ItemTemplate="{StaticResource TotalRow}" Focusable="False"
                            ItemContainerStyle="{StaticResource ByName}"/>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>
    </v:Pane>

</v:SplitPanel>
