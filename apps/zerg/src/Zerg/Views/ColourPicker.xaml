<UserControl x:Class="Zerg.Views.ColourPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Zerg.Views"
             Width="186" Height="148" Focusable="False" IsTabStop="False"
             KeyboardNavigation.TabNavigation="Cycle" AutomationProperties.Name="Colour picker">

  <!-- A colour picker: WPF has none. A square for saturation and
       brightness, a strip for the hue, the colour picked as a swatch, its
       code in a field that can be typed in, and how strong a band of that
       colour comes out (apps/zerg-mockup/06-settings.svg).

       It is a piece of the page and not a window of its own: it cannot be
       left behind when the page goes, it is not over the game, and a
       script finds its parts in the main window like any other control.
       Tab goes round its three parts and stays in it; whoever shows it
       closes it (Views/SettingsPage: Esc, a press elsewhere, the page
       going).

       The box is the raised surface with the strong edge a menu has. Its
       shadow is cast by a plain shape behind it, as a tooltip's is: an
       effect on the box itself would draw its text through a bitmap. -->
  <Grid>
    <Border CornerRadius="6" Background="{DynamicResource Bg2Brush}">
      <Border.Effect>
        <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="14" ShadowDepth="5" Direction="270"/>
      </Border.Effect>
    </Border>
    <Border CornerRadius="6" Background="{DynamicResource Bg2Brush}" BorderBrush="{DynamicResource Line3Brush}"
            BorderThickness="1" SnapsToDevicePixels="True"/>

    <v:ColourField x:Name="Field" Width="150" Height="100" Margin="8,8,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                   FocusVisualStyle="{StaticResource ZFocus}" Moved="OnMoved"
                   AutomationProperties.Name="Saturation and brightness"
                   ToolTip="Across: how strong the colour is. Up and down: how bright. Drag, or use the arrow keys (with Shift, ten times as far)."/>
    <v:HueStrip x:Name="Strip" Width="18" Height="100" Margin="163,8,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                FocusVisualStyle="{StaticResource ZFocus}" Moved="OnMoved"
                AutomationProperties.Name="Hue"
                ToolTip="Which colour. Drag, or use the arrow keys (with Shift, ten times as far)."/>

    <!-- The colour picked, edged so that one near the box's own does not vanish. -->
    <Border x:Name="Swatch" Width="24" Height="24" Margin="8,116,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
            CornerRadius="3" BorderBrush="{DynamicResource Line2Brush}" BorderThickness="1" SnapsToDevicePixels="True"/>

    <!-- The colour's code. Typed in, it is taken on Enter or when the
         keyboard leaves the field; set whole from outside (UI Automation),
         at once. What is not a colour turns the edge red and says so
         beside it, and is put back when the keyboard leaves. -->
    <TextBox x:Name="Code" Width="78" Height="24" Margin="38,116,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
             MaxLength="9" KeyDown="OnCodeKey" TextChanged="OnCodeChanged" LostKeyboardFocus="OnCodeLeft"
             GotKeyboardFocus="OnCodeEntered" PreviewMouseLeftButtonDown="OnCodePress"
             PreviewKeyDown="OnCodeTyping" PreviewTextInput="OnCodeTyping"
             AutomationProperties.Name="Colour code"
             ToolTip="The colour as six hexadecimal digits: #3987E5. Enter takes it.">
      <TextBox.Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource ZTextBox}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding Bad, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
              <Setter Property="BorderBrush" Value="{DynamicResource CritBrush}"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBox.Style>
    </TextBox>

    <TextBlock x:Name="Says" Margin="124,116,6,0" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="0,5,0,0"
               FontSize="10.5" Typography.NumeralAlignment="Tabular" AutomationProperties.LiveSetting="Polite">
      <TextBlock.Style>
        <Style TargetType="TextBlock">
          <Setter Property="Foreground" Value="{DynamicResource Text3Brush}"/>
          <Setter Property="Text" Value="{Binding Band, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat='band {0}%'}"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding Bad, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource CritBrush}"/>
              <Setter Property="Text" Value="not a code"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>
  </Grid>
</UserControl>
